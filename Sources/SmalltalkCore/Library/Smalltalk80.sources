{"classMethods":{"DebuggerPresentation":{"command:id:send:enabled:":"command: aTitle id: identifier send: aCommand enabled: available\n    ^ UIButton new title: aTitle; identifier: identifier; command: aCommand; enabled: available; yourself","commandsFor:error:phase:":"commandsFor: frameCount error: error phase: phase\n    | controls canStep resume stop |\n    canStep := phase = #paused and: [ error isNil ].\n    resume := (self command: 'Continue' id: 'debuggerContinue' send: #resume enabled: canStep)\n        role: #primary; yourself.\n    stop := self command: (error isNil ifTrue: [ 'Stop' ] ifFalse: [ 'Close' ])\n        id: 'debuggerStop' send: #stop enabled: phase ~= #stopping.\n    error isNil ifTrue: [ stop role: #destructive ].\n    controls := UIRow new role: #compactBar; add: resume; yourself.\n    controls add: (self command: 'Step Into' id: 'debuggerStepInto' send: #stepInto enabled: canStep).\n    controls add: (self command: 'Step Over' id: 'debuggerStepOver' send: #stepOver enabled: canStep).\n    controls add: (self command: 'Step Out' id: 'debuggerStepOut' send: #stepOut\n        enabled: (canStep and: [ frameCount > 1 ])).\n    controls add: UISpacer new.\n    phase ~= #paused ifTrue: [\n        controls add: (UILabel new role: #caption;\n            text: (phase = #stopping ifTrue: [ 'Stopping…' ] ifFalse: [ 'Running…' ]); yourself) ].\n    controls add: stop.\n    ^ controls","contentFor:frame:error:phase:":"contentFor: stack frame: frame error: error phase: phase\n    | root split pane |\n    root := UIColumn new spacing: 0; yourself.\n    root add: (self commandsFor: stack size error: error phase: phase); add: UIDivider new.\n    error notNil ifTrue: [\n        root add: (UIColumn new padding: 12;\n            add: (UILabel new role: #error; identifier: 'debuggerError'; text: error; yourself); yourself);\n            add: UIDivider new ].\n    pane := frame isNil\n        ifTrue: [ UILabel new role: #caption; text: 'No active frame'; yourself ]\n        ifFalse: [ self framePane: frame ].\n    split := UISplit new enabled: phase = #paused;\n        add: (self stackPane: stack selection: (frame isNil ifTrue: [ nil ] ifFalse: [ frame at: 1 ]));\n        add: pane; yourself.\n    root add: split.\n    ^ root","framePane:":"framePane: frame\n    | details editor variables text split |\n    details := UIRow new role: #compactBar;\n        add: (UILabel new role: #heading; identifier: 'debuggerFrameTitle'; text: (frame at: 2); yourself);\n        add: UISpacer new;\n        add: (UILabel new role: #pageNumber; identifier: 'debuggerLocation';\n            text: ('Line ' , (frame at: 4) printString , ', column ' , (frame at: 5) printString); yourself);\n        yourself.\n    editor := UIColumn new spacing: 0; heightFrom: 114 to: nil; add: details; add: UIDivider new; yourself.\n    text := frame at: 3.\n    text size = 0\n        ifTrue: [ editor add: (UILabel new role: #caption; text: 'Source unavailable'; yourself) ]\n        ifFalse: [ editor add: (UISourceView new identifier: 'debuggerSource'; text: text;\n            line: (frame at: 4) column: (frame at: 5); yourself) ].\n    (frame at: 6) size > 0 ifTrue: [\n        editor add: UIDivider new;\n            add: (UIColumn new padding: 8;\n                add: (UILabel new role: #codePreview; identifier: 'debuggerInstruction'; text: (frame at: 6); yourself);\n                yourself) ].\n    variables := UIValueTable new identifier: 'debuggerVariables'; rowIdentifierPrefix: 'debuggerVariable';\n        rows: (frame at: 7); readOnly: true; heightFrom: 95 to: nil; yourself.\n    split := UISplit new role: #vertical; add: editor; add: variables; yourself.\n    ^ split","stackPane:selection:":"stackPane: stack selection: key\n    | list header |\n    header := UIRow new role: #compactBar; add: (UILabel new role: #heading; text: 'Call Stack'; yourself); yourself.\n    list := UIHistoryList new identifier: 'debuggerStack'; role: #compactEntries; rowIdentifierPrefix: 'debuggerFrame';\n        command: #selectFrame; entries: stack; selection: key; yourself.\n    ^ UIColumn new spacing: 0; widthFrom: 160 to: 320; add: header; add: UIDivider new; add: list; yourself"},"DebuggerWindow":{"fallbackFor:phase:":"fallbackFor: message phase: phase\n    ^ UIColumn new padding: 12;\n        add: (UILabel new role: #error; text: message; yourself);\n        add: (DebuggerPresentation command: 'Stop' id: 'debuggerStop' send: #stop enabled: phase ~= #stopping);\n        yourself","phaseAfter:command:error:frameCount:":"phaseAfter: phase command: command error: hasError frameCount: count\n    (phase = #paused and: [ hasError not ]) ifFalse: [ ^ nil ].\n    (command = #stepOut and: [ count < 2 ]) ifTrue: [ ^ nil ].\n    (#(#stepInto #stepOver #stepOut #resume) includes: command) ifFalse: [ ^ nil ].\n    ^ #running","selectionFor:requested:":"selectionFor: stack requested: key\n    stack do: [ :frame | (frame at: 1) = key ifTrue: [ ^ key ] ].\n    ^ stack isEmpty ifTrue: [ nil ] ifFalse: [ (stack at: 1) at: 1 ]"},"InspectorPresentation":{"breadcrumbFor:":"breadcrumbFor: path\n    | title |\n    title := path at: 1.\n    2 to: path size do: [ :index | title := title , ' › ' , (path at: index) ].\n    ^ title","contentFor:summary:path:rows:page:pageCount:":"contentFor: className summary: preview path: path rows: rows page: page pageCount: pageCount\n    | root classLabel title summary table |\n    root := UIColumn new spacing: 0; yourself.\n    classLabel := UILabel new role: #heading; identifier: 'inspectorClass'; text: className; yourself.\n    title := UIColumn new spacing: 2; add: classLabel; yourself.\n    path size > 1 ifTrue: [\n        title add: (UILabel new role: #breadcrumb; text: (self breadcrumbFor: path); yourself) ].\n    root add: (self navigation: title canGoBack: path size > 1).\n    summary := UILabel new role: #code; identifier: 'inspectorSummary'; text: preview; yourself.\n    rows isEmpty\n        ifTrue: [ root add: (UIScroll new padding: 12; add: summary; yourself) ]\n        ifFalse: [\n            table := UIValueTable new identifier: 'inspectorMembers'; rowIdentifierPrefix: 'inspectorRow';\n                command: #inspectMember; headings: #('Name' 'Value' 'Class'); rows: rows; yourself.\n            root add: (UIColumn new padding: 12; add: summary; yourself); add: UIDivider new; add: table ].\n    pageCount > 1 ifTrue: [\n        root add: UIDivider new; add: (self pagination: page count: pageCount) ].\n    ^ root","navigation:canGoBack:":"navigation: title canGoBack: canGoBack\n    | back refresh |\n    back := UIButton new title: 'Back'; icon: 'chevron.left'; identifier: 'inspectorBack';\n        command: #inspectBack; enabled: canGoBack; yourself.\n    refresh := UIButton new title: 'Refresh'; icon: 'arrow.clockwise'; identifier: 'inspectorRefresh';\n        command: #inspectRefresh; yourself.\n    ^ UIRow new role: #compactBar; add: back; add: title; add: UISpacer new; add: refresh; yourself","pagination:count:":"pagination: page count: pageCount\n    | previous next label |\n    previous := UIButton new title: 'Previous'; identifier: 'inspectorPreviousPage';\n        command: #inspectPreviousPage; enabled: page > 0; yourself.\n    next := UIButton new title: 'Next'; identifier: 'inspectorNextPage';\n        command: #inspectNextPage; enabled: page + 1 < pageCount; yourself.\n    label := UILabel new role: #pageNumber; identifier: 'inspectorPage';\n        text: (page + 1) printString , ' of ' , pageCount printString; yourself.\n    ^ UIRow new role: #compactBar; add: previous; add: UISpacer new; add: label; add: UISpacer new; add: next; yourself"},"ObjectInspectorWindow":{"action:row:on:members:":"action: command row: row on: model members: members\n    | index |\n    command = #inspectBack ifTrue: [ ^ model back ].\n    command = #inspectRefresh ifTrue: [ ^ model refresh ].\n    command = #inspectPreviousPage ifTrue: [ ^ model changePageBy: -1 ].\n    command = #inspectNextPage ifTrue: [ ^ model changePageBy: 1 ].\n    (command = #inspectMember and: [ row notNil ]) ifFalse: [ ^ nil ].\n    index := row asIntegerOrNil.\n    (index isNil or: [ index < 0 or: [ index >= members size ] ]) ifTrue: [ ^ nil ].\n    ^ model follow: (members at: index + 1)","fallbackFor:":"fallbackFor: message\n    ^ UIColumn new padding: 12;\n        add: (UILabel new role: #error; text: message; yourself);\n        yourself"},"TestCase":{"run":"run\n    ^ TestRunner runClass: self","run:":"run: selector\n    ^ TestRunner runClass: self selector: selector"},"TestRunner":{"isTestClass:":"isTestClass: aClass\n    | parent |\n    parent := aClass superclass.\n    [ parent notNil ] whileTrue: [\n        parent == TestCase ifTrue: [ ^ true ].\n        parent := parent superclass ].\n    ^ false","runAll":"runAll\n    | classes selectors count outcomes index |\n    classes := (ToolVM classNames collect: [ :name | ToolVM classNamed: name ])\n        select: [ :each | self isTestClass: each ].\n    selectors := classes collect: [ :each | self testSelectorsFor: each ].\n    count := 0.\n    selectors do: [ :each | count := count + each size ].\n    outcomes := Array new: count.\n    index := 0.\n    1 to: classes size do: [ :suite |\n        (selectors at: suite) do: [ :selector |\n            index := index + 1.\n            outcomes at: index put: (self runTest: selector in: (classes at: suite)) ] ].\n    ^ TestResult new outcomes: outcomes; yourself","runClass:":"runClass: aClass\n    | outcomes |\n    aClass == TestCase ifTrue: [ ^ TestResult new ].\n    (self isTestClass: aClass) ifFalse: [ self error: 'Expected a TestCase subclass.' line: 1 column: 1 ].\n    outcomes := (self testSelectorsFor: aClass) collect: [ :selector | self runTest: selector in: aClass ].\n    ^ TestResult new outcomes: outcomes; yourself","runClass:selector:":"runClass: aClass selector: selector\n    | name outcomes |\n    name := selector asString.\n    ((self isTestClass: aClass) and: [ (self testSelectorsFor: aClass) includes: name ])\n        ifFalse: [ self error: 'No test named ' , name , ' in ' , aClass name asString , '.' line: 1 column: 1 ].\n    outcomes := Array new: 1.\n    outcomes at: 1 put: (self runTest: name in: aClass).\n    ^ TestResult new outcomes: outcomes; yourself","runTest:in:":"runTest: name in: aClass\n    | instance outcome setup |\n    outcome := TestOutcome new testClass: aClass selector: name asSymbol; yourself.\n    setup := ToolVM captureTestPhase: [ instance := aClass new. instance setUp ].\n    outcome record: setup during: #setUp.\n    setup isNil ifTrue: [\n        outcome record: (ToolVM captureTestPhase: [ instance perform: name asSymbol ]) during: #test ].\n    instance notNil ifTrue: [\n        outcome record: (ToolVM captureTestPhase: [ instance tearDown ]) during: #tearDown ].\n    ^ outcome","testSelectorsFor:":"testSelectorsFor: aClass\n    ^ aClass methodNames select: [ :name |\n        (name size > 4 and: [ (name includes: ':') not ]) and: [\n            ((name at: 1) , (name at: 2) , (name at: 3) , (name at: 4)) = 'test' ] ]"}},"definitions":[{"fields":["count"],"name":"Counter","superclass":"Object"},{"fields":["storage","count"],"name":"STCompilerList","superclass":"Object"},{"fields":["characters","offset","line","column","nesting","tokenLine","tokenColumn"],"name":"STScanner","superclass":"Object"},{"fields":["tokenStart"],"name":"STSourceScanner","superclass":"STScanner"},{"fields":["scanner","current","lookahead","expressionDepth"],"name":"STCompiler","superclass":"Object"},{"fields":["dependents"],"name":"Model","superclass":"Object"},{"fields":["model"],"name":"Controller","superclass":"Object"},{"fields":["source","aspect","view","property","active"],"name":"UIBinding","superclass":"Object"},{"fields":["id","kind","title","text","x","y","width","height","minimized","minimumWidth","minimumHeight","maximumWidth","maximumHeight","frameRevision","stateRevision","nativeMinimumWidth","nativeMinimumHeight","nativeMaximumWidth","nativeMaximumHeight"],"name":"SystemWindow","superclass":"Model"},{"fields":["windows","activeWindow","nextID","screens","focusRevision"],"name":"DesktopModel","superclass":"Model"},{"fields":["id","x","y","width","height"],"name":"DisplayScreen","superclass":"Object"},{"fields":[],"name":"DesktopManager","superclass":"Controller"},{"fields":["enabled","mvcBindings","identifier","role","visible","minWidth","maxWidth","minHeight","maxHeight"],"name":"UIElement","superclass":"Object"},{"fields":["text"],"name":"UILabel","superclass":"UIElement"},{"fields":["title","action","command","selectionAction","selectionSource","shortcutHint","icon"],"name":"UIButton","superclass":"UIElement"},{"fields":["label","text","placeholder","mvcInputTarget","mvcInputSelector"],"name":"UITextField","superclass":"UIElement"},{"fields":["children","spacing","padding"],"name":"UIContainer","superclass":"UIElement"},{"fields":[],"name":"UIColumn","superclass":"UIContainer"},{"fields":[],"name":"UIRow","superclass":"UIContainer"},{"fields":[],"name":"UISpacer","superclass":"UIElement"},{"fields":["content"],"name":"UIWindow","superclass":"SystemWindow"},{"fields":["readOnly","contextMenu","lineNumbers","syntaxHighlighting","undoEnabled","editingMenu"],"name":"UICodeEditor","superclass":"UITextField"},{"fields":["items","selection","target","selector"],"name":"UIList","superclass":"UIElement"},{"fields":["entries","rowIdentifierPrefix","command"],"name":"UIHistoryList","superclass":"UIList"},{"fields":["text","line","column"],"name":"UISourceView","superclass":"UIElement"},{"fields":["rows","headings","rowIdentifierPrefix","command","readOnly","nameWidth","classWidth","columnSpacing","horizontalPadding","valueLines"],"name":"UIValueTable","superclass":"UIList"},{"fields":[],"name":"UISplit","superclass":"UIContainer"},{"fields":["contextMenu"],"name":"UIScroll","superclass":"UIContainer"},{"fields":["title"],"name":"UIMenu","superclass":"UIContainer"},{"fields":[],"name":"UIDivider","superclass":"UIElement"},{"fields":["name","defaultName","items"],"name":"BrowserGroup","superclass":"Object"},{"fields":["groups"],"name":"BrowserGrouping","superclass":"Object"},{"fields":["classCategories","catalogs","systemProtocols"],"name":"BrowserOrganization","superclass":"Object"},{"fields":["heading","entry","destinations","destination","applyButton","operation"],"name":"BrowserOrganizationForm","superclass":"UIColumn"},{"fields":[],"name":"ToolServices","superclass":"Object"},{"fields":["contents"],"name":"TranscriptModel","superclass":"Model"},{"fields":["resultLabel","resultPreview","resultToggle","resultScroll","resultPanel"],"name":"DevelopmentWindow","superclass":"UIWindow"},{"fields":["editor"],"name":"WorkspaceWindow","superclass":"DevelopmentWindow"},{"fields":["categoryList","classList","protocolList","methodList","queryField","editor","category","className","protocolName","selector","originalSource","header","hint","accept","versions","versionMenu","organizationForm","renameCategoryItem","moveClassItem","newProtocolItem","renameProtocolItem","moveMethodItem","methodSide","instanceSideButton","classSideButton","otherSideState","editingDefinition","definitionButton","bytecodeToggle","bytecodeView"],"name":"BrowserWindow","superclass":"DevelopmentWindow"},{"fields":[],"name":"TranscriptWindow","superclass":"DevelopmentWindow"},{"fields":["levels","depth"],"name":"InspectorModel","superclass":"Object"},{"fields":["identifier"],"name":"ObjectInspectorWindow","superclass":"UIWindow"},{"fields":[],"name":"InspectorPresentation","superclass":"Object"},{"fields":["content","title","entries","source","pathLabel","restore","resultLabel","selected","className","selector","side","revision"],"name":"ChangesBrowser","superclass":"Object"},{"fields":["identifier"],"name":"DebuggerWindow","superclass":"UIWindow"},{"fields":[],"name":"DebuggerPresentation","superclass":"Object"},{"fields":[],"name":"TestCase","superclass":"Object"},{"fields":["testClass","selector","diagnostics"],"name":"TestOutcome","superclass":"Object"},{"fields":["outcomes","failures","errors"],"name":"TestResult","superclass":"Object"},{"fields":[],"name":"TestRunner","superclass":"Object"},{"fields":["counter"],"name":"CounterTest","superclass":"TestCase"},{"fields":[],"name":"CollectionsTest","superclass":"TestCase"},{"fields":["caption"],"name":"BindingTestModel","superclass":"Model"},{"fields":["model","label"],"name":"UIBindingTest","superclass":"TestCase"}],"methods":{"Array":{"copyWith:":"copyWith: element\n    | result |\n    result := Array new: self size + 1.\n    1 to: self size do: [ :index | result at: index put: (self at: index) ].\n    result at: result size put: element.\n    ^ result"},"BindingTestModel":{"caption":"caption\n    ^ caption","caption:":"caption: aString\n    caption := aString.\n    self changed: #caption"},"BrowserGroup":{"defaultName":"defaultName\n    ^ defaultName","defaultName:":"defaultName: aString\n    defaultName := aString","includes:":"includes: item\n    ^ items includes: item","initialize":"initialize\n    items := #()","isDeclared":"isDeclared\n    ^ name ~= defaultName","items":"items\n    ^ items","items:":"items: values\n    items := values","name":"name\n    ^ name","name:":"name: aString\n    name := aString"},"BrowserGrouping":{"addGroup:":"addGroup: name\n    | failure |\n    failure := self nameError: name.\n    failure notNil ifTrue: [ ^ failure ].\n    groups size >= 1023 ifTrue: [ ^ 'The list already contains the maximum number of groups.' ].\n    groups := groups copyWith: (BrowserGroup new name: name; yourself).\n    ^ nil","defineDefaults:":"defineDefaults: names\n    names do: [ :name |\n        groups := groups copyWith: (BrowserGroup new name: name; defaultName: name; yourself) ]","defineGroup:items:":"defineGroup: name items: selectors\n    groups := groups copyWith: (BrowserGroup new name: name; items: selectors; yourself)","explicitGroupOf:":"explicitGroupOf: item\n    groups do: [ :group | (group includes: item) ifTrue: [ ^ group ] ].\n    ^ nil","groupNamed:":"groupNamed: name\n    groups do: [ :group | group name = name ifTrue: [ ^ group ] ].\n    ^ nil","groupOf:default:":"groupOf: item default: defaultName\n    | assigned |\n    assigned := self explicitGroupOf: item.\n    assigned notNil ifTrue: [ ^ assigned name ].\n    groups do: [ :group | group defaultName = defaultName ifTrue: [ ^ group name ] ].\n    ^ nil","initialize":"initialize\n    groups := #()","move:to:":"move: item to: name\n    | target previous additions remaining |\n    target := self groupNamed: name.\n    target isNil ifTrue: [ ^ 'Select an existing destination.' ].\n    previous := self explicitGroupOf: item.\n    previous == target ifTrue: [ ^ nil ].\n    additions := target items copyWith: item.\n    previous notNil ifTrue: [ remaining := previous items select: [ :each | each ~= item ] ].\n    target items: additions.\n    previous notNil ifTrue: [ previous items: remaining ].\n    ^ nil","nameError:":"nameError: name\n    (name class == String and: [ name utf8Size <= 4096 ]) ifFalse: [ ^ 'Enter a name of at most 4,096 bytes.' ].\n    (name characters select: [ :character | character isWhitespace not ]) isEmpty\n        ifTrue: [ ^ 'Enter a name.' ].\n    (name = 'All' or: [ (self groupNamed: name) notNil ]) ifTrue: [ ^ 'That name is already in use.' ].\n    ^ nil","names":"names\n    ^ groups collect: [ :group | group name ]","namesWith:":"namesWith: populated\n    ^ (groups select: [ :group | group isDeclared or: [ populated includes: group name ] ])\n        collect: [ :group | group name ]","renameGroup:to:":"renameGroup: oldName to: newName\n    | group failure |\n    group := self groupNamed: oldName.\n    group isNil ifTrue: [ ^ 'Select a group to rename.' ].\n    oldName = newName ifTrue: [ ^ nil ].\n    failure := self nameError: newName.\n    failure notNil ifTrue: [ ^ failure ].\n    group name: newName.\n    ^ nil"},"BrowserOrganization":{"categoryOf:":"categoryOf: name\n    ^ classCategories groupOf: name default: (self defaultCategoryOf: name)","classCategories":"classCategories\n    ^ classCategories","defaultCategoryOf:":"defaultCategoryOf: name\n    (#('Object' 'Class' 'UndefinedObject' 'Boolean' 'True' 'False' 'Number' 'Integer' 'SmallInteger' 'String' 'Symbol' 'Array' 'BlockClosure') includes: name) ifTrue: [ ^ 'Kernel' ].\n    (#('STCompilerList' 'STScanner' 'STSourceScanner' 'STCompiler') includes: name) ifTrue: [ ^ 'Compiler' ].\n    (#('Transcript' 'TranscriptModel' 'ToolServices' 'DevelopmentWindow' 'ChangesBrowser' 'InspectorModel' 'ObjectInspectorWindow' 'InspectorPresentation' 'DebuggerWindow' 'DebuggerPresentation' 'WorkspaceWindow' 'BrowserWindow' 'TranscriptWindow'\n       'BrowserGroup' 'BrowserGrouping' 'BrowserOrganization' 'BrowserOrganizationForm'\n       'TestCase' 'TestOutcome' 'TestResult' 'TestRunner') includes: name) ifTrue: [ ^ 'Tools' ].\n    (#('Model' 'Controller' 'UIBinding' 'SystemWindow' 'DesktopModel' 'DisplayScreen' 'DesktopManager'\n       'UIElement' 'UILabel' 'UIButton' 'UITextField' 'UIContainer' 'UIColumn' 'UIRow' 'UISpacer'\n       'UIWindow' 'UICodeEditor' 'UIList' 'UIHistoryList' 'UISourceView' 'UIValueTable' 'UISplit' 'UIScroll' 'UIMenu' 'UIDivider') includes: name)\n        ifTrue: [ ^ 'Interface' ].\n    name = 'Counter' ifTrue: [ ^ 'Examples' ].\n    (#('CounterTest' 'CollectionsTest' 'BindingTestModel' 'UIBindingTest') includes: name) ifTrue: [ ^ 'Tests' ].\n    ^ 'User Classes'","initialize":"initialize\n    classCategories := BrowserGrouping new.\n    classCategories defineDefaults: #('Kernel' 'Compiler' 'Interface' 'Tools' 'Examples' 'Tests' 'User Classes').\n    systemProtocols := self shippedProtocols.\n    catalogs := #()","protocolsOf:":"protocolsOf: target\n    ^ self protocolsOf: target side: #instance","protocolsOf:side:":"protocolsOf: target side: methodSide\n    | grouping entry className |\n    catalogs do: [ :each |\n        ((each at: 1) == target and: [ (each at: 2) = methodSide ]) ifTrue: [ ^ each at: 3 ] ].\n    grouping := BrowserGrouping new.\n    methodSide = #instance ifTrue: [\n        className := ToolVM classNameOf: target.\n        systemProtocols do: [ :definition |\n            (definition at: 1) = className ifTrue: [\n                (definition at: 2) do: [ :entrySpec |\n                    grouping defineGroup: (entrySpec at: 1) items: (entrySpec at: 2) ] ] ] ].\n    grouping defineDefaults: #('Unclassified').\n    entry := Array new: 3.\n    entry at: 1 put: target; at: 2 put: methodSide; at: 3 put: grouping.\n    catalogs := catalogs copyWith: entry.\n    ^ grouping","shippedProtocols":"shippedProtocols\n    ^ #(\n        ('Object' (\n            ('Initialization' ('initialize'))\n            ('Comparing' ('=' '==' '~='))\n            ('Nil Testing' ('isNil' 'notNil' 'ifNil:' 'ifNotNil:'))\n            ('Reflection' ('class' 'respondsTo:' 'perform:' 'perform:with:'))\n            ('Printing' ('printString'))\n            ('Identity' ('yourself'))\n            ('Error Reporting' ('error:line:column:'))))\n        ('Class' (\n            ('Instance Creation' ('new' 'new:'))\n            ('Class Structure' ('name' 'superclass' 'subclasses' 'instanceVariableNamesText'))\n            ('Subclass Definition' ('subclass:instanceVariableNames:' 'subclass:instanceVariableNames:classVariableNames:poolDictionaries:category:'))\n            ('Method Dictionary' ('compile:' 'compileClass:' 'methodNames' 'methodSourceAt:' 'classMethodNames' 'classMethodSourceAt:' 'isPrimitiveAt:'))))\n        ('Integer' (\n            ('Arithmetic' ('+' '-' '*' '/' '//' '\\\\' 'negated' 'abs' 'squared'))\n            ('Comparing' ('<' '>' '<=' '>='))\n            ('Bounds' ('min:' 'max:' 'clampFrom:to:'))\n            ('Iteration' ('timesRepeat:' 'to:do:' 'to:by:do:'))))\n        ('Boolean' (\n            ('Logical Operations' ('not' 'and:' 'or:'))\n            ('Conditionals' ('ifTrue:' 'ifFalse:' 'ifTrue:ifFalse:' 'ifFalse:ifTrue:'))))\n        ('String' (\n            ('Accessing' ('size' 'at:' 'characters'))\n            ('Combining' (','))\n            ('Searching' ('includes:'))\n            ('Character Testing' ('isLetter' 'isNumber' 'isASCIIDigit' 'isLowercase' 'isWhitespace' 'isLineBreak'))\n            ('Converting' ('asString' 'asSymbol' 'asIntegerOrNil'))))\n        ('Symbol' (\n            ('Converting' ('asString'))))\n        ('Array' (\n            ('Accessing' ('size' 'at:'))\n            ('Updating' ('at:put:'))\n            ('Enumerating' ('do:' 'collect:' 'select:'))\n            ('Testing' ('isEmpty' 'includes:'))\n            ('Copying' ('copyWith:'))\n            ('Converting' ('joinedStringFrom:to:'))))\n        ('BlockClosure' (\n            ('Evaluation' ('value' 'value:' 'value:value:'))\n            ('Looping' ('whileTrue:' 'whileFalse:'))))\n        ('Transcript' (\n            ('Writing' ('show:' 'cr'))\n            ('Buffer Management' ('clear' 'record:'))))\n        ('Counter' (\n            ('Initialization' ('initialize'))\n            ('Accessing' ('value'))\n            ('Counting' ('increment' 'add:'))))\n        ('STCompilerList' (\n            ('Initialization' ('initialize'))\n            ('Accumulating' ('add:'))\n            ('Extracting Contents' ('elements' 'joinedString'))))\n        ('STScanner' (\n            ('Input Setup' ('initialize' 'source:'))\n            ('Character Stream' ('peek' 'peekAhead:' 'advance'))\n            ('Character Classification' ('isBinary:' 'isIdentifierStart:' 'isIdentifierPart:'))\n            ('Tokenization' ('nextToken' 'readToken' 'token:value:' 'skipTrivia' 'readComment'))\n            ('Literal Scanning' ('readNumber' 'readString' 'readSymbol'))\n            ('Identifier Scanning' ('readIdentifier' 'readWord'))\n            ('Error Reporting' ('fail:'))))\n        ('STSourceScanner' (('Highlighting' ('nextHighlight' 'token:value:' 'highlight:' 'fail:'))))\n        ('STCompiler' (\n            ('Compilation' ('initialize' 'start:' 'workspace:' 'method:'))\n            ('Token Handling' ('advance' 'expect:' 'kind' 'tokenValue' 'tokenLabel:' 'identifier'))\n            ('Body Parsing' ('workspaceBody' 'bodyUntil:' 'blockAt:'))\n            ('Expression Parsing' ('expression' 'expressionNode' 'primary' 'unaryExpression' 'binaryExpression' 'keywordExpression'))\n            ('Message Parsing' ('unaryMessage' 'binaryMessage' 'keywordMessage' 'cascadeMessage'))\n            ('Literal Parsing' ('arrayElement' 'arrayElements' 'negativeNumber'))\n            ('Syntax Trees' ('node:at:with:with:' 'single:' 'pair:with:' 'triple:with:with:' 'sendTo:message:'))\n            ('Validation and Errors' ('fail:' 'validateNames:' 'validate:separateFrom:error:'))))\n        ('Model' (\n            ('Initialization' ('initialize'))\n            ('Managing Dependents' ('dependents' 'addDependent:' 'removeDependent:'))\n            ('Change Notifications' ('changed' 'changed:'))))\n        ('Controller' (\n            ('Initialization' ('initialize'))\n            ('Model Access' ('model' 'model:'))))\n        ('UIBinding' (\n            ('Configuration' ('initialize' 'source:aspect:view:property:'))\n            ('Binding Properties' ('source' 'aspect' 'view' 'property' 'active'))\n            ('Connection Lifecycle' ('connect' 'disconnect'))\n            ('Model Updates' ('update:'))))\n        ('SystemWindow' (\n            ('Initialization' ('initialize'))\n            ('Identity and Content' ('id' 'id:' 'kind' 'kind:' 'title' 'title:' 'text' 'text:'))\n            ('Window Lifecycle' ('open' 'close' 'canClose' 'activate' 'minimized' 'minimized:'))\n            ('Geometry' ('x' 'y' 'width' 'height' 'moveToX:y:' 'resizeWidth:height:' 'placeX:y:width:height:'))\n            ('Size Constraints' ('minimumWidth' 'minimumHeight' 'maximumWidth' 'maximumHeight'\n                'minimumWidth:height:' 'maximumWidth:height:' 'nativeMinimumWidth:height:maximumWidth:height:'))\n            ('Native Synchronization' ('frameRevision' 'stateRevision' 'frameApplied:x:y:width:height:'\n                'observeX:y:width:height:' 'observeMinimized:'))))\n        ('DesktopModel' (\n            ('Initialization' ('initialize'))\n            ('Window State' ('windows' 'windows:' 'activeWindow' 'activeWindow:'))\n            ('Window Identifiers' ('nextID' 'nextID:'))\n            ('Display State' ('screens' 'screens:'))\n            ('Focus Requests' ('focusRevision' 'requestFocus'))))\n        ('DisplayScreen' (\n            ('Identity and Bounds' ('id' 'x' 'y' 'width' 'height'))\n            ('Window Placement Metrics' ('distanceTo:' 'overlapWith:'))))\n        ('DesktopManager' (\n            ('Initialization' ('initialize'))\n            ('Window Registry' ('windows' 'append:' 'nextID' 'windowAt:' 'windowOfKind:' 'activeWindow'))\n            ('Opening Tools' ('createKind:title:' 'windowClassFor:' 'openWorkspace' 'showWorkspace'\n                'openBrowser' 'openTranscript' 'openChanges' 'openWindow'))\n            ('Window Lifecycle' ('open:' 'requestClose:' 'close:' 'minimize:'))\n            ('Focus and Ordering' ('chooseActive' 'bringToFront:' 'activate:' 'observeActivation:' 'observeMinimized:value:'))\n            ('Displays and Placement' ('screens' 'screenFor:' 'screensChanged:' 'constrain:' 'restoreWindows' 'arrangeTools'))))\n        ('UIElement' (\n            ('Initialization' ('initialize'))\n            ('Identity and Appearance' ('identifier:' 'role:'))\n            ('Interaction State' ('enabled' 'enabled:' 'visible' 'visible:'))\n            ('Size Constraints' ('widthFrom:to:' 'heightFrom:to:'))\n            ('Model Bindings' ('bindings' 'bind:to:aspect:' 'unbind:' 'unbindAll'))))\n        ('UILabel' (\n            ('Initialization' ('initialize'))\n            ('Text' ('text' 'text:'))))\n        ('UIButton' (\n            ('Initialization' ('initialize'))\n            ('Labeling' ('title' 'title:' 'shortcutHint:' 'icon:'))\n            ('Action Configuration' ('action:' 'command:' 'onClickSend:to:' 'selectionFrom:action:'))\n            ('Activation' ('click' 'clickWithSelection:'))))\n        ('UITextField' (\n            ('Initialization' ('initialize'))\n            ('Label and Placeholder' ('label' 'label:' 'placeholder' 'placeholder:'))\n            ('Text' ('text' 'text:'))\n            ('Input Handling' ('editText:' 'onChangeSend:to:'))))\n        ('UICodeEditor' (\n            ('Initialization' ('initialize'))\n            ('Editing Permissions' ('readOnly:' 'undoEnabled:'))\n            ('Source Display' ('role:' 'lineNumbers:' 'syntaxHighlighting:'))\n            ('Context Menu' ('contextMenu' 'contextMenu:' 'editingMenu:'))))\n        ('UIList' (\n            ('Initialization' ('initialize'))\n            ('List Contents' ('items:'))\n            ('Selection' ('selection:' 'select:' 'onSelectSend:to:'))))\n        ('UIHistoryList' (\n            ('Initialization' ('initialize'))\n            ('History Entries' ('entries:' 'includes:' 'rowIdentifierPrefix:' 'command:'))))\n        ('UISourceView' (\n            ('Initialization' ('initialize'))\n            ('Source' ('text:' 'line:column:'))))\n        ('UIValueTable' (\n            ('Initialization' ('initialize'))\n            ('Table Contents' ('rows:' 'headings:' 'rowIdentifierPrefix:'))\n            ('Layout' ('nameWidth:classWidth:' 'columnSpacing:padding:' 'valueLines:'))\n            ('Selection' ('command:' 'readOnly:'))))\n        ('UIContainer' (\n            ('Initialization' ('initialize'))\n            ('Child Management' ('children' 'children:' 'add:' 'remove:' 'removeAll'))\n            ('Layout Spacing' ('spacing' 'spacing:' 'padding' 'padding:'))))\n        ('UIWindow' (\n            ('Initialization' ('initialize'))\n            ('Window Content' ('content' 'content:'))))\n        ('UIScroll' (('Context Menu' ('contextMenu:'))))\n        ('UIMenu' (\n            ('Initialization' ('initialize'))\n            ('Labeling' ('title:'))))\n        ('BrowserGroup' (\n            ('Initialization' ('initialize'))\n            ('Naming' ('name' 'name:' 'defaultName' 'defaultName:' 'isDeclared'))\n            ('Membership' ('items' 'items:' 'includes:'))))\n        ('BrowserGrouping' (\n            ('Initialization' ('initialize' 'defineDefaults:' 'defineGroup:items:'))\n            ('Group Lookup' ('names' 'namesWith:' 'groupNamed:'))\n            ('Group Editing' ('addGroup:' 'renameGroup:to:' 'nameError:'))\n            ('Membership' ('explicitGroupOf:' 'groupOf:default:' 'move:to:'))))\n        ('BrowserOrganization' (\n            ('Initialization' ('initialize' 'shippedProtocols'))\n            ('Class Categories' ('classCategories' 'categoryOf:' 'defaultCategoryOf:'))\n            ('Method Protocols' ('protocolsOf:' 'protocolsOf:side:'))))\n        ('BrowserOrganizationForm' (\n            ('Initialization' ('initialize'))\n            ('Presenting Edits' ('edit:name:do:' 'move:choices:selected:do:'))\n            ('Applying Edits' ('chooseDestination:' 'apply' 'cancel'))))\n        ('ChangesBrowser' (\n            ('Layout' ('initialize' 'buildContent'))\n            ('History' ('showClass:selector:side:' 'allChanges' 'synchronize' 'reload'))\n            ('Version Selection' ('select:' 'restoreSelected'))))\n        ('InspectorModel' (\n            ('Opening' ('openOn:' 'levelFor:named:' 'currentLevel'))\n            ('Navigation' ('dropTo:' 'back' 'follow:'))\n            ('Pagination' ('page:' 'changePageBy:' 'pageSize'))\n            ('Snapshot' ('refresh'))))\n        ('ObjectInspectorWindow' (\n            ('Initialization' ('initialize'))))\n        ('DevelopmentWindow' (\n            ('Shared Layout' ('heading:' 'caption:' 'resultPane' 'toggleResult' 'resultExpanded:'))\n            ('Result Display' ('result:'))))\n        ('DebuggerWindow' (\n            ('Initialization' ('initialize'))))\n        ('WorkspaceWindow' (\n            ('Initialization' ('initialize'))\n            ('Code Evaluation' ('text:' 'sourceForSelection:' 'doIt:' 'printIt:' 'inspect:' 'debugIt:' 'execute:printing:'))\n            ('Editor Menu' ('editorMenu' 'actionsMenu' 'selectionButton:command:action:'))\n            ('Examples' ('examplesMenu' 'exampleButton:key:'))))\n        ('BrowserWindow' (\n            ('Initialization' ('initialize'))\n            ('Pane Layout' ('list:selecting:' 'organizationItem:id:send:' 'pane:list:action:' 'withAll:'))\n            ('Navigation' ('chooseCategory:' 'chooseClass:' 'chooseProtocol:' 'chooseMethod:'\n                'filter:' 'matchesCategory:' 'selectedClass' 'protocolOf:in:'\n                'showInstanceMethods' 'showClassMethods' 'chooseMethodSide:'))\n            ('Catalog Updates' ('refreshClasses' 'refreshMethods' 'refreshTools' 'refreshOrganizationActions'))\n            ('Method Editing' ('acceptMethod' 'draftChanged:' 'newMethod' 'primitiveSelected'\n                'refreshEditor' 'showVersions'))\n            ('Class Definitions' ('showDefinition' 'acceptDefinition'))\n            ('Bytecode' ('toggleBytecode' 'refreshBytecode'))\n            ('Result Display' ('result:'))\n            ('Organization Editing' ('editGroupIn:named:prompt:selecting:' 'moveItem:in:from:prompt:selecting:'\n                'newCategory' 'renameCategory' 'moveClass' 'newProtocol' 'renameProtocol' 'moveMethod' 'organizationEdited:'))))\n        ('TranscriptModel' (\n            ('Initialization' ('initialize'))\n            ('Output Buffer' ('text' 'append:' 'clear'))))\n        ('TranscriptWindow' (\n            ('Initialization' ('initialize'))))\n        ('TestCase' (\n            ('Fixtures' ('setUp' 'tearDown'))\n            ('Assertions' ('assert:' 'deny:' 'assert:equals:' 'fail:'))))\n        ('TestOutcome' (\n            ('Initialization' ('initialize' 'testClass:selector:'))\n            ('Outcome' ('testClass' 'selector' 'diagnostics' 'status' 'record:during:'))))\n        ('TestResult' (\n            ('Initialization' ('initialize' 'outcomes:'))\n            ('Results' ('outcomes' 'testCount' 'passedCount' 'failureCount' 'errorCount' 'isSuccess' 'summary'))))\n        ('CounterTest' (\n            ('Fixtures' ('setUp'))\n            ('Tests' ('testIncrement' 'testCountersStartIndependently'))))\n        ('CollectionsTest' (\n            ('Tests' ('testArrayCollectAndSelect' 'testFalseAndDoesNotEvaluateItsBlock'))))\n        ('BindingTestModel' (\n            ('Accessing' ('caption' 'caption:'))))\n        ('UIBindingTest' (\n            ('Fixtures' ('setUp' 'tearDown'))\n            ('Tests' ('testBindingReadsAndUpdatesTheLabel' 'testUnbindingStopsUpdates'))))\n    )"},"BrowserOrganizationForm":{"apply":"apply\n    operation value: (entry visible ifTrue: [ entry text ] ifFalse: [ destination ])","cancel":"cancel\n    self visible: false.\n    operation := nil","chooseDestination:":"chooseDestination: value\n    destination := value.\n    applyButton enabled: value notNil","edit:name:do:":"edit: prompt name: initialName do: action\n    operation := action.\n    heading text: prompt.\n    entry text: initialName; visible: true.\n    destinations visible: false.\n    applyButton enabled: true.\n    self visible: true","initialize":"initialize\n    | buttons |\n    super initialize.\n    self padding: 8; spacing: 4; visible: false.\n    heading := UILabel new role: #heading; yourself.\n    entry := UITextField new label: 'Name'; identifier: 'organizationName'; yourself.\n    destinations := UIList new identifier: 'organizationDestinations'; role: #pane; heightFrom: 86 to: 110;\n        onSelectSend: #chooseDestination: to: self; yourself.\n    applyButton := UIButton new title: 'Apply'; identifier: 'applyOrganizationEdit'; role: #primary;\n        onClickSend: #apply to: self; yourself.\n    buttons := UIRow new add: (UIButton new title: 'Cancel'; identifier: 'cancelOrganizationEdit'; onClickSend: #cancel to: self; yourself);\n        add: applyButton; yourself.\n    self add: heading; add: entry; add: destinations; add: buttons","move:choices:selected:do:":"move: prompt choices: names selected: current do: action\n    operation := action.\n    heading text: prompt.\n    entry visible: false.\n    destinations items: names; selection: current; visible: true.\n    self chooseDestination: current.\n    self visible: true"},"BrowserWindow":{"acceptDefinition":"acceptDefinition\n    | outcome |\n    outcome := ToolVM acceptDefinition: editor text in: self selectedClass basedOn: originalSource.\n    (outcome at: 1) ifTrue: [ self showDefinition. self refreshTools ].\n    self result: outcome","acceptMethod":"acceptMethod\n    | outcome target |\n    target := self selectedClass.\n    (target isNil or: [ self primitiveSelected or: [ editor text size = 0 ] ]) ifTrue: [ ^ self ].\n    editingDefinition ifTrue: [ ^ self acceptDefinition ].\n    outcome := ToolVM acceptMethod: editor text in: target side: methodSide selector: selector basedOn: originalSource.\n    (outcome at: 1) ifTrue: [\n        selector := outcome at: 2.\n        originalSource := editor text.\n        protocolName ~= 'All' ifTrue: [ (SystemOrganization protocolsOf: target side: methodSide) move: selector to: protocolName ].\n        self refreshTools.\n        self refreshEditor.\n        self result: (ToolVM success: className , (methodSide = #class ifTrue: [ ' class' ] ifFalse: [ '' ]) , ' » ' , selector)\n    ] ifFalse: [ self result: outcome ]","chooseCategory:":"chooseCategory: name\n    category := name isNil ifTrue: [ 'All' ] ifFalse: [ name ].\n    (className notNil and: [ (self matchesCategory: className) not ]) ifTrue: [ ^ self chooseClass: nil ].\n    self refreshClasses.\n    self refreshOrganizationActions","chooseClass:":"chooseClass: name\n    className ~= name ifTrue: [ otherSideState := nil. organizationForm cancel ].\n    className := name.\n    protocolName := 'All'.\n    self chooseMethod: nil.\n    self refreshTools","chooseMethod:":"chooseMethod: name\n    name isNil ifTrue: [ ^ self showDefinition ].\n    editingDefinition := false.\n    selector := name.\n    originalSource := ToolVM methodSourceAt: selector in: self selectedClass side: methodSide.\n    originalSource isNil ifTrue: [ originalSource := '' ].\n    editor text: originalSource.\n    methodList selection: selector.\n    self refreshEditor","chooseMethodSide:":"chooseMethodSide: side\n    | saved |\n    methodSide = side ifTrue: [ ^ self ].\n    organizationForm cancel.\n    saved := otherSideState.\n    otherSideState := Array new: 5.\n    otherSideState at: 1 put: protocolName; at: 2 put: selector; at: 3 put: originalSource;\n        at: 4 put: editor text; at: 5 put: editingDefinition.\n    methodSide := side.\n    saved isNil ifTrue: [ protocolName := 'All'. self chooseMethod: nil ] ifFalse: [\n        protocolName := saved at: 1.\n        selector := saved at: 2.\n        originalSource := saved at: 3.\n        editingDefinition := saved at: 5.\n        editor text: (saved at: 4) ].\n    self refreshTools.\n    self refreshEditor","chooseProtocol:":"chooseProtocol: name\n    protocolName := name.\n    (selector notNil and: [ name notNil and: [ name ~= 'All' and: [ (self protocolOf: selector in: self selectedClass) ~= name ] ] ])\n        ifTrue: [ self chooseMethod: nil ].\n    self refreshMethods.\n    self refreshOrganizationActions","draftChanged:":"draftChanged: aString\n    | target |\n    target := self selectedClass.\n    definitionButton enabled: (target notNil and: [ editingDefinition not or: [ aString ~= originalSource ] ]).\n    accept enabled: (target notNil and: [ aString size > 0 and: [ editingDefinition\n        ifTrue: [ (ToolVM canRedefine: target) and: [ aString ~= originalSource ] ]\n        ifFalse: [ self primitiveSelected not ] ] ])","editGroupIn:named:prompt:selecting:":"editGroupIn: grouping named: oldName prompt: prompt selecting: onSuccess\n    organizationForm edit: prompt name: (oldName isNil ifTrue: [ '' ] ifFalse: [ oldName ]) do: [ :value |\n        | failure |\n        failure := oldName isNil\n            ifTrue: [ grouping addGroup: value ]\n            ifFalse: [ grouping renameGroup: oldName to: value ].\n        failure isNil ifTrue: [ onSuccess value: value ].\n        self organizationEdited: failure ]","filter:":"filter: aString\n    queryField text: aString.\n    self refreshClasses","initialize":"initialize\n    | navigation panes source actions toolbar categoryMenu protocolMenu sideBar newMethod |\n    super initialize.\n    self kind: #browser.\n    self title: 'System Browser'.\n    category := 'All'.\n    className := 'Counter'.\n    protocolName := 'All'.\n    methodSide := #instance.\n    editingDefinition := true.\n    categoryList := self list: 'categoryList' selecting: #chooseCategory:.\n    classList := self list: 'classList' selecting: #chooseClass:.\n    protocolList := self list: 'protocolList' selecting: #chooseProtocol:.\n    methodList := self list: 'methodList' selecting: #chooseMethod:.\n    queryField := UITextField new identifier: 'classFilter'; placeholder: 'Filter Classes'; widthFrom: 135 to: 220; onChangeSend: #filter: to: self; yourself.\n    editor := UICodeEditor new identifier: 'methodEditor'; label: 'Method Source'; role: #source; onChangeSend: #draftChanged: to: self; yourself.\n    header := self heading: ''.\n    hint := self caption: ''.\n    accept := UIButton new title: 'Accept'; identifier: 'executeButton'; role: #primary; command: #acceptMethod; onClickSend: #acceptMethod to: self; yourself.\n    versions := UIButton new title: 'Versions …'; identifier: 'methodVersionsButton'; onClickSend: #showVersions to: self; yourself.\n    definitionButton := UIButton new title: 'Definition'; identifier: 'classDefinition'; onClickSend: #showDefinition to: self; yourself.\n\n    newMethod := UIButton new title: 'New Method'; identifier: 'newMethod'; onClickSend: #newMethod to: self; yourself.\n\n    renameCategoryItem := self organizationItem: 'Rename Category …' id: 'renameCategory' send: #renameCategory.\n    moveClassItem := self organizationItem: 'Move Class …' id: 'moveClass' send: #moveClass.\n    categoryMenu := UIMenu new title: 'Class Category Actions'; identifier: 'categoryActions'; role: #paneMenu; yourself.\n    categoryMenu add: (self organizationItem: 'New Category …' id: 'newCategory' send: #newCategory).\n    categoryMenu add: renameCategoryItem; add: moveClassItem.\n\n    newProtocolItem := self organizationItem: 'New Protocol …' id: 'newProtocol' send: #newProtocol.\n    renameProtocolItem := self organizationItem: 'Rename Protocol …' id: 'renameProtocol' send: #renameProtocol.\n    moveMethodItem := self organizationItem: 'Move Method …' id: 'moveMethod' send: #moveMethod.\n    protocolMenu := UIMenu new title: 'Method Protocol Actions'; identifier: 'protocolActions'; role: #paneMenu; yourself.\n    protocolMenu add: newProtocolItem; add: renameProtocolItem; add: moveMethodItem.\n\n    panes := UISplit new identifier: 'browserNavigation'; yourself.\n    panes add: (self pane: 'Class Categories' list: categoryList action: categoryMenu).\n    panes add: (self pane: 'Classes' list: classList action: definitionButton).\n    panes add: (self pane: 'Protocols' list: protocolList action: protocolMenu).\n    panes add: (self pane: 'Methods' list: methodList action: newMethod).\n\n    instanceSideButton := UIButton new title: 'Instance'; identifier: 'instanceMethodSide'; onClickSend: #showInstanceMethods to: self; yourself.\n    classSideButton := UIButton new title: 'Class'; identifier: 'classMethodSide'; onClickSend: #showClassMethods to: self; yourself.\n    sideBar := UIRow new role: #segmented; add: instanceSideButton; add: classSideButton; yourself.\n    actions := UIRow new role: #compactBar; add: queryField; add: UISpacer new; add: sideBar; yourself.\n    navigation := UIColumn new spacing: 0; heightFrom: 140 to: 255;\n        add: actions; add: UIDivider new; add: panes; yourself.\n\n    versionMenu := UIMenu new title: 'Method Actions'; identifier: 'methodActions'; role: #paneMenu; add: versions; yourself.\n    toolbar := UIRow new role: #compactBar; add: header; add: hint; add: UISpacer new; add: versionMenu; add: accept; yourself.\n    organizationForm := BrowserOrganizationForm new.\n    bytecodeToggle := UIButton new title: 'Bytecode'; identifier: 'methodBytecodeToggle';\n        onClickSend: #toggleBytecode to: self; yourself.\n    bytecodeView := UICodeEditor new identifier: 'bytecodeEditor'; label: 'Method Bytecode'; readOnly: true;\n        heightFrom: 64 to: 184; visible: false; yourself.\n    source := UIColumn new spacing: 0; heightFrom: 145 to: nil; add: toolbar; add: UIDivider new;\n        add: organizationForm; add: editor; add: bytecodeToggle; add: bytecodeView; add: self resultPane; yourself.\n    self content: (UISplit new role: #vertical; add: navigation; add: source; yourself).\n    self showDefinition.\n    self refreshTools","list:selecting:":"list: identifier selecting: message\n    ^ UIList new identifier: identifier; role: #pane; onSelectSend: message to: self; yourself","matchesCategory:":"matchesCategory: name\n    ^ category = 'All' or: [ (SystemOrganization categoryOf: name) = category ]","moveClass":"moveClass\n    | selected |\n    className isNil ifTrue: [ ^ self ].\n    selected := className.\n    self moveItem: selected in: SystemOrganization classCategories from: (SystemOrganization categoryOf: selected)\n        prompt: 'Move Class ' , selected selecting: [ :value |\n            className = selected ifTrue: [ self chooseCategory: value ] ]","moveItem:in:from:prompt:selecting:":"moveItem: item in: grouping from: current prompt: prompt selecting: onSuccess\n    organizationForm move: prompt choices: grouping names selected: current do: [ :value |\n        | failure |\n        failure := grouping move: item to: value.\n        failure isNil ifTrue: [ onSuccess value: value ].\n        self organizationEdited: failure ]","moveMethod":"moveMethod\n    | target selected |\n    target := self selectedClass.\n    (target isNil or: [ selector isNil ]) ifTrue: [ ^ self ].\n    selected := selector.\n    self moveItem: selected in: (SystemOrganization protocolsOf: target side: methodSide) from: (self protocolOf: selected in: target)\n        prompt: 'Move Method ' , selected selecting: [ :value |\n            (target == self selectedClass and: [ selector = selected ]) ifTrue: [ self chooseProtocol: value ] ]","newCategory":"newCategory\n    self editGroupIn: SystemOrganization classCategories named: nil prompt: 'New Class Category' selecting: [ :value |\n        self chooseCategory: value ]","newMethod":"newMethod\n    className isNil ifTrue: [ ^ self ].\n    editingDefinition := false.\n    selector := nil.\n    methodList selection: nil.\n    originalSource := ''.\n    editor text: 'newMethod' , ToolVM lineBreak , '    ^ self'.\n    self refreshEditor","newProtocol":"newProtocol\n    | target |\n    target := self selectedClass.\n    target isNil ifTrue: [ ^ self ].\n    self editGroupIn: (SystemOrganization protocolsOf: target side: methodSide) named: nil prompt: 'New Protocol in ' , className selecting: [ :value |\n        target == self selectedClass ifTrue: [ self chooseProtocol: value ] ]","organizationEdited:":"organizationEdited: failure\n    | outcome |\n    failure notNil ifTrue: [\n        outcome := Array new: 2.\n        outcome at: 1 put: false; at: 2 put: failure.\n        ^ self result: outcome ].\n    organizationForm cancel.\n    self refreshTools.\n    Desktop windows do: [ :window |\n        ((window == self) not and: [ window respondsTo: #refreshTools ]) ifTrue: [ window refreshTools ] ].\n    self result: (ToolVM success: 'Organization updated.')","organizationItem:id:send:":"organizationItem: aTitle id: identifier send: message\n    ^ UIButton new title: aTitle; identifier: identifier; onClickSend: message to: self; yourself","pane:list:action:":"pane: aTitle list: aList action: anAction\n    | labelBar |\n    labelBar := UIRow new role: #paneHeader; add: (self caption: aTitle); add: UISpacer new; add: anAction; yourself.\n    ^ UIColumn new spacing: 0; widthFrom: 142 to: nil; add: labelBar; add: aList; yourself","primitiveSelected":"primitiveSelected\n    selector isNil ifTrue: [ ^ false ].\n    ^ ToolVM isPrimitiveAt: selector in: self selectedClass side: methodSide","protocolOf:in:":"protocolOf: name in: target\n    ^ (SystemOrganization protocolsOf: target side: methodSide) groupOf: name default: 'Unclassified'","refreshBytecode":"refreshBytecode\n    bytecodeToggle enabled: selector notNil.\n    selector isNil ifTrue: [ bytecodeView visible: false ].\n    bytecodeToggle role: (bytecodeView visible ifTrue: [ #disclosureOpen ] ifFalse: [ #disclosureClosed ]).\n    bytecodeView visible ifTrue: [\n        bytecodeView text: (self primitiveSelected\n            ifTrue: [ 'This VM primitive has no bytecode.' ]\n            ifFalse: [ ToolVM bytecodeOf: selector in: self selectedClass side: methodSide ]) ]","refreshClasses":"refreshClasses\n    | query names |\n    query := queryField text.\n    names := SystemOrganization classCategories names.\n    (category ~= 'All' and: [ (names includes: category) not ]) ifTrue: [ category := 'All' ].\n    categoryList items: (self withAll: names); selection: category.\n    classList items: (ToolVM classNames select: [ :each |\n        (self matchesCategory: each) and: [ query size = 0 or: [ each includesIgnoringCase: query ] ] ]).\n    classList selection: className","refreshEditor":"refreshEditor\n    | primitive name target |\n    primitive := self primitiveSelected.\n    target := self selectedClass.\n    name := className isNil ifTrue: [ 'No Class Selected' ] ifFalse: [ className ].\n    (className notNil and: [ editingDefinition not and: [ methodSide = #class ] ]) ifTrue: [ name := name , ' class' ].\n    header text: (selector isNil ifTrue: [ name ] ifFalse: [ name , ' » ' , selector ]).\n    hint text: (editingDefinition ifTrue: [ 'Class Definition' ] ifFalse: [\n        primitive ifTrue: [ 'VM Primitive' ] ifFalse: [ methodSide = #class ifTrue: [ 'Class Side' ] ifFalse: [ 'Instance Side' ] ] ]).\n    hint visible: (editingDefinition or: [ primitive ]).\n    instanceSideButton role: (methodSide = #instance ifTrue: [ #primary ] ifFalse: [ #secondary ]).\n    classSideButton role: (methodSide = #class ifTrue: [ #primary ] ifFalse: [ #secondary ]).\n    editor label: (editingDefinition ifTrue: [ 'Class Definition' ] ifFalse: [ 'Method Source' ]).\n    editor readOnly: (target isNil or: [ primitive or: [ editingDefinition and: [ (ToolVM canRedefine: target) not ] ] ]).\n    versionMenu visible: (selector notNil and: [ primitive not ]).\n    self refreshBytecode.\n    self refreshOrganizationActions.\n    self draftChanged: editor text","refreshMethods":"refreshMethods\n    | target methods protocols names |\n    target := self selectedClass.\n    target isNil ifTrue: [\n        protocolName := 'All'.\n        protocolList items: #('All'); selection: protocolName.\n        methodList items: #(); selection: nil.\n        ^ self ].\n    methods := ToolVM methodNamesFor: target side: methodSide.\n    protocols := methods collect: [ :each | self protocolOf: each in: target ].\n    names := (SystemOrganization protocolsOf: target side: methodSide) namesWith: protocols.\n    (names includes: protocolName) ifFalse: [ protocolName := 'All' ].\n    protocolList items: (self withAll: names); selection: protocolName.\n    protocolName ~= 'All' ifTrue: [\n        methods := methods select: [ :each | (self protocolOf: each in: target) = protocolName ] ].\n    methodList items: methods.\n    methodList selection: selector","refreshOrganizationActions":"refreshOrganizationActions\n    renameCategoryItem enabled: category ~= 'All'.\n    moveClassItem enabled: className notNil.\n    newProtocolItem enabled: className notNil.\n    renameProtocolItem enabled: (className notNil and: [ protocolName ~= 'All' ]).\n    moveMethodItem enabled: (className notNil and: [ selector notNil ])","refreshTools":"refreshTools\n    | target textValue |\n    self refreshClasses.\n    self refreshMethods.\n    target := self selectedClass.\n    target notNil ifTrue: [\n        editingDefinition\n            ifTrue: [ textValue := ToolVM definitionOf: target ]\n            ifFalse: [ selector notNil ifTrue: [ textValue := ToolVM methodSourceAt: selector in: target side: methodSide ] ].\n        (textValue notNil and: [ textValue ~= originalSource and: [ editor text = originalSource ] ]) ifTrue: [\n            editor text: textValue. originalSource := textValue. self refreshEditor ] ].\n    self refreshOrganizationActions.\n    self refreshBytecode","renameCategory":"renameCategory\n    category = 'All' ifTrue: [ ^ self ].\n    self editGroupIn: SystemOrganization classCategories named: category prompt: 'Rename Class Category' selecting: [ :value |\n        self chooseCategory: value ]","renameProtocol":"renameProtocol\n    | target |\n    target := self selectedClass.\n    (target isNil or: [ protocolName = 'All' ]) ifTrue: [ ^ self ].\n    self editGroupIn: (SystemOrganization protocolsOf: target side: methodSide) named: protocolName prompt: 'Rename Method Protocol' selecting: [ :value |\n        target == self selectedClass ifTrue: [ self chooseProtocol: value ] ]","result:":"result: outcome\n    super result: outcome.\n    ((outcome at: 1) and: [ (outcome at: 2) = header text ]) ifTrue: [ resultPanel visible: false ]","selectedClass":"selectedClass\n    className isNil ifTrue: [ ^ nil ].\n    ^ ToolVM classNamed: className","showClassMethods":"showClassMethods\n    self chooseMethodSide: #class","showDefinition":"showDefinition\n    | target |\n    editingDefinition := true.\n    selector := nil.\n    methodList selection: nil.\n    target := self selectedClass.\n    originalSource := target isNil ifTrue: [ '' ] ifFalse: [ ToolVM definitionOf: target ].\n    editor text: originalSource.\n    self refreshEditor","showInstanceMethods":"showInstanceMethods\n    self chooseMethodSide: #instance","showVersions":"showVersions\n    (selector notNil and: [ self primitiveSelected not ]) ifTrue: [ ToolVM requestVersionsFor: className selector: selector side: methodSide ]","toggleBytecode":"toggleBytecode\n    bytecodeView visible: bytecodeView visible not.\n    self refreshBytecode","withAll:":"withAll: entries\n    | result |\n    result := Array new: entries size + 1.\n    result at: 1 put: 'All'.\n    1 to: entries size do: [ :index | result at: index + 1 put: (entries at: index) ].\n    ^ result"},"ChangesBrowser":{"allChanges":"allChanges\n    self showClass: nil selector: nil side: nil.\n    ^ nil","buildContent":"buildContent\n    | heading toolbar split all |\n    title := UILabel new role: #heading; yourself.\n    heading := UIColumn new spacing: 3; add: title;\n        add: (UILabel new role: #caption; text: 'Accepted code is logged immediately. The image stores the object graph.'; yourself);\n        yourself.\n    all := UIButton new title: 'All Changes'; identifier: 'allChangesButton'; onClickSend: #allChanges to: self; yourself.\n    restore := UIButton new title: 'Restore Version'; identifier: 'restoreChangeButton'; enabled: false;\n        onClickSend: #restoreSelected to: self; yourself.\n    toolbar := UIRow new role: #compactBar; add: heading; add: UISpacer new; add: all; add: restore; yourself.\n    entries := UIHistoryList new identifier: 'changesList'; widthFrom: 250 to: nil; onSelectSend: #select: to: self; yourself.\n    source := UILabel new role: #document; yourself.\n    split := UISplit new add: entries;\n        add: (UIScroll new identifier: 'changeSource'; padding: 14; add: source; yourself); yourself.\n    pathLabel := UILabel new role: #caption; visible: false; yourself.\n    resultLabel := UILabel new role: #code; identifier: 'evaluationResult'; visible: false; yourself.\n    content := UIColumn new spacing: 0; add: toolbar; add: UIDivider new; add: split; add: UIDivider new;\n        add: (UIColumn new padding: 8; add: pathLabel; add: resultLabel; yourself); yourself","initialize":"initialize\n    self buildContent","reload":"reload\n    | owner path |\n    owner := className isNil ifTrue: [ nil ] ifFalse: [\n        className , (side = #class ifTrue: [ ' class' ] ifFalse: [ '' ]) ].\n    title text: (owner isNil ifTrue: [ 'Code Changes' ] ifFalse: [\n        'Versions: ' , owner , (selector isNil ifTrue: [ '' ] ifFalse: [ ' » ' , selector ]) ]).\n    entries entries: (ToolVM historyFor: className selector: selector side: side).\n    (entries includes: selected) ifFalse: [ selected := nil ].\n    self select: selected.\n    path := ToolVM changeJournalPath.\n    pathLabel visible: path notNil.\n    path notNil ifTrue: [ pathLabel text: path ].\n    revision := ToolVM changesBrowserRevision","restoreSelected":"restoreSelected\n    | outcome |\n    selected isNil ifTrue: [ ^ nil ].\n    outcome := ToolVM restoreVersion: selected.\n    resultLabel role: ((outcome at: 1) ifTrue: [ #code ] ifFalse: [ #error ]);\n        text: (outcome at: 2); visible: true.\n    ^ nil","select:":"select: key\n    selected := key.\n    entries selection: key.\n    restore enabled: key notNil.\n    source text: (key isNil\n        ifTrue: [ 'Select a change. You can restore later entries individually after restarting.' ]\n        ifFalse: [ ToolVM changeSourceAt: key ]).\n    ^ nil","showClass:selector:side:":"showClass: aName selector: aSelector side: aSide\n    className := aName.\n    selector := aSelector.\n    side := aSide.\n    selected := nil.\n    resultLabel visible: false.\n    self reload","synchronize":"synchronize\n    revision ~= ToolVM changesBrowserRevision ifTrue: [ self reload ]"},"CollectionsTest":{"testArrayCollectAndSelect":"testArrayCollectAndSelect\n    | values |\n    values := #(1 2 3 4) collect: [ :each | each * 2 ].\n    self assert: (values select: [ :each | each > 4 ]) equals: #(6 8)","testFalseAndDoesNotEvaluateItsBlock":"testFalseAndDoesNotEvaluateItsBlock\n    | ran |\n    ran := false.\n    self deny: (false and: [ ran := true ]).\n    self deny: ran"},"Controller":{"initialize":"initialize\n    model := nil","model":"model\n    ^ model","model:":"model: aModel\n    model := aModel"},"Counter":{"add:":"add: amount\n    count := count + amount","increment":"increment\n    count := count + 1","initialize":"initialize\n    count := 0","value":"value\n    ^ count"},"CounterTest":{"setUp":"setUp\n    counter := Counter new","testCountersStartIndependently":"testCountersStartIndependently\n    counter add: 42.\n    self assert: Counter new value equals: 0.\n    self assert: counter value equals: 42","testIncrement":"testIncrement\n    counter increment.\n    self assert: counter value equals: 1"},"DebuggerWindow":{"initialize":"initialize\n    super initialize.\n    identifier := 'debugger'.\n    self title: 'Debugger';\n        minimumWidth: 620 height: 360;\n        resizeWidth: 840 height: 540"},"DesktopManager":{"activate:":"activate: aWindow\n    aWindow minimized: false. model requestFocus. ^ self bringToFront: aWindow","activeWindow":"activeWindow\n    ^ model activeWindow","append:":"append: aWindow\n    | replacement |\n    replacement := Array new: self windows size + 1.\n    1 to: self windows size do: [ :index | replacement at: index put: (self windows at: index) ].\n    replacement at: replacement size put: aWindow.\n    model windows: replacement. ^ aWindow","arrangeTools":"arrangeTools\n    | browser workspace output screen left bottom availableWidth availableHeight gap browserWidth rightWidth outputHeight workspaceHeight |\n    browser := self windowOfKind: #browser.\n    workspace := self windowOfKind: #workspace.\n    output := self windowOfKind: #transcript.\n    (browser isNil or: [ workspace isNil or: [ output isNil ] ]) ifTrue: [ ^ self ].\n    left := 12. bottom := 12. availableWidth := 1576. availableHeight := 876. gap := 12.\n    screen := self screenFor: workspace.\n    screen notNil ifTrue: [\n        availableWidth := ((screen width - 24) max: 1) min: 1800.\n        availableHeight := ((screen height - 24) max: 1) min: 1000.\n        left := screen x + ((screen width - availableWidth) // 2).\n        bottom := screen y + ((screen height - availableHeight) // 2) ].\n    browserWidth := (availableWidth - gap) // 2 max: browser minimumWidth.\n    browserWidth := browserWidth min: ((availableWidth - gap - workspace minimumWidth) max: 1).\n    rightWidth := (availableWidth - gap - browserWidth) max: 1.\n    outputHeight := ((availableHeight - gap) // 3) max: output minimumHeight.\n    outputHeight := outputHeight min: ((availableHeight - gap - workspace minimumHeight) max: 1).\n    workspaceHeight := (availableHeight - gap - outputHeight) max: 1.\n    browser placeX: left y: bottom width: browserWidth height: availableHeight.\n    output placeX: left + browserWidth + gap y: bottom width: rightWidth height: outputHeight.\n    workspace placeX: left + browserWidth + gap y: bottom + outputHeight + gap width: rightWidth height: workspaceHeight.\n    #(#browser #workspace #transcript) do: [ :kind |\n        | window | window := self windowOfKind: kind.\n        window minimized: false. self constrain: window ]","bringToFront:":"bringToFront: aWindow\n    model windows: (self windows select: [ :each | (each == aWindow) not ]).\n    self append: aWindow. model activeWindow: aWindow. ^ aWindow","chooseActive":"chooseActive\n    model activeWindow: nil.\n    self windows do: [ :each | each minimized ifFalse: [ model activeWindow: each ] ].\n    model requestFocus. ^ model activeWindow","close:":"close: aWindow\n    aWindow canClose ifFalse: [ ^ false ].\n    model windows: (self windows select: [ :each | (each == aWindow) not ]).\n    model activeWindow == aWindow ifTrue: [ self chooseActive ]. ^ aWindow","constrain:":"constrain: aWindow\n    | screen newX newY newWidth newHeight minWidth minHeight maxWidth maxHeight |\n    newX := aWindow x clampFrom: -100000 to: 100000.\n    newY := aWindow y clampFrom: -100000 to: 100000.\n    newWidth := aWindow width clampFrom: aWindow minimumWidth to: aWindow maximumWidth.\n    newHeight := aWindow height clampFrom: aWindow minimumHeight to: aWindow maximumHeight.\n    minWidth := aWindow minimumWidth. minHeight := aWindow minimumHeight.\n    maxWidth := aWindow maximumWidth. maxHeight := aWindow maximumHeight.\n    screen := self screenFor: aWindow.\n    screen notNil ifTrue: [\n        minWidth := minWidth min: screen width. minHeight := minHeight min: screen height.\n        maxWidth := maxWidth min: screen width. maxHeight := maxHeight min: screen height.\n        newWidth := newWidth min: screen width. newHeight := newHeight min: screen height.\n        newX := newX clampFrom: screen x to: screen x + screen width - newWidth.\n        newY := newY clampFrom: screen y to: screen y + screen height - newHeight ].\n    aWindow nativeMinimumWidth: minWidth height: minHeight maximumWidth: maxWidth height: maxHeight.\n    aWindow placeX: newX y: newY width: newWidth height: newHeight","createKind:title:":"createKind: aKind title: aTitle\n    | window |\n    self windows size >= 128 ifTrue: [ ^ nil ].\n    window := self windowClassFor: aKind.\n    window := window new.\n    window kind: aKind; title: aTitle.\n    aKind = #workspace ifTrue: [ window moveToX: 100 + (self windows size * 24) y: 200 + (self windows size * 24) ].\n    (aKind = #browser or: [ aKind = #changes ]) ifTrue: [ window moveToX: 850 y: 200; resizeWidth: 850 height: 650 ].\n    aKind = #transcript ifTrue: [ window moveToX: 100 y: 40; resizeWidth: 720 height: 200 ].\n    ^ self open: window","initialize":"initialize\n    super initialize.\n    model := DesktopModel new","minimize:":"minimize: aWindow\n    aWindow minimized: true.\n    model activeWindow == aWindow ifTrue: [ self chooseActive ]. ^ aWindow","nextID":"nextID\n    ^ model nextID","observeActivation:":"observeActivation: aWindow\n    aWindow observeMinimized: false. ^ self bringToFront: aWindow","observeMinimized:value:":"observeMinimized: aWindow value: aBoolean\n    aWindow observeMinimized: aBoolean.\n    (aBoolean and: [ model activeWindow == aWindow ]) ifTrue: [ self chooseActive ]. ^ aWindow","open:":"open: aWindow\n    self windows do: [ :each | each == aWindow ifTrue: [ ^ self activate: aWindow ] ].\n    self windows size >= 128 ifTrue: [ ^ nil ].\n    aWindow id: model nextID. model nextID: model nextID + 1.\n    self constrain: aWindow.\n    self append: aWindow.\n    ^ self activate: aWindow","openBrowser":"openBrowser\n    | existing | existing := self windowOfKind: #browser.\n    existing notNil ifTrue: [ ^ self activate: existing ].\n    ^ self createKind: #browser title: 'System Browser'","openChanges":"openChanges\n    | existing | existing := self windowOfKind: #changes.\n    existing notNil ifTrue: [ ^ self activate: existing ].\n    ^ self createKind: #changes title: 'Code Changes'","openTranscript":"openTranscript\n    | existing | existing := self windowOfKind: #transcript.\n    existing notNil ifTrue: [ ^ self activate: existing ].\n    ^ self createKind: #transcript title: 'Transcript'","openWindow":"openWindow\n    ^ self open: UIWindow new","openWorkspace":"openWorkspace\n    ^ self createKind: #workspace title: 'Workspace'","requestClose:":"requestClose: aWindow\n    ^ self close: aWindow","restoreWindows":"restoreWindows\n    self windows do: [ :each | self constrain: each ]","screenFor:":"screenFor: aWindow\n    | best bestArea bestDistance area distance |\n    best := nil. bestArea := -1. bestDistance := 0.\n    model screens do: [ :screen |\n        area := screen overlapWith: aWindow. distance := screen distanceTo: aWindow.\n        (area > bestArea or: [ area = bestArea and: [ distance < bestDistance ] ]) ifTrue: [\n            best := screen. bestArea := area. bestDistance := distance ] ].\n    ^ best","screens":"screens\n    ^ model screens","screensChanged:":"screensChanged: availableScreens\n    model screens: availableScreens. self restoreWindows","showWorkspace":"showWorkspace\n    | existing | existing := nil.\n    self windows do: [ :each | each kind = #workspace ifTrue: [ existing := each ] ].\n    existing isNil ifTrue: [ ^ self openWorkspace ].\n    ^ self activate: existing","windowAt:":"windowAt: anID\n    self windows do: [ :each | each id = anID ifTrue: [ ^ each ] ]. ^ nil","windowClassFor:":"windowClassFor: aKind\n    aKind = #workspace ifTrue: [ ^ WorkspaceWindow ].\n    aKind = #browser ifTrue: [ ^ BrowserWindow ].\n    aKind = #transcript ifTrue: [ ^ TranscriptWindow ].\n    ^ SystemWindow","windowOfKind:":"windowOfKind: aKind\n    self windows do: [ :each | each kind = aKind ifTrue: [ ^ each ] ]. ^ nil","windows":"windows\n    ^ model windows"},"DesktopModel":{"activeWindow":"activeWindow\n    ^ activeWindow","activeWindow:":"activeWindow: aWindow\n    activeWindow := aWindow.\n    self changed: #activeWindow","focusRevision":"focusRevision\n    ^ focusRevision","initialize":"initialize\n    super initialize. windows := Array new: 0. activeWindow := nil.\n    nextID := 1. screens := Array new: 0. focusRevision := 1","nextID":"nextID\n    ^ nextID","nextID:":"nextID: anID\n    nextID := anID","requestFocus":"requestFocus\n    focusRevision := focusRevision + 1","screens":"screens\n    ^ screens","screens:":"screens: aList\n    screens := aList.\n    self changed: #screens","windows":"windows\n    ^ windows","windows:":"windows: aList\n    windows := aList.\n    self changed: #windows"},"DevelopmentWindow":{"caption:":"caption: aString\n    ^ UILabel new text: aString; role: #caption; yourself","heading:":"heading: aString\n    ^ UILabel new text: aString; role: #heading; yourself","result:":"result: outcome\n    | success value |\n    success := outcome at: 1.\n    value := (outcome at: 2) suffixFittingUTF8: 65536.\n    (resultLabel text ~= value or: [ resultToggle title ~= (success ifTrue: [ 'Result' ] ifFalse: [ 'Error' ]) ])\n        ifTrue: [ self resultExpanded: false ].\n    resultToggle title: (success ifTrue: [ 'Result' ] ifFalse: [ 'Error' ]).\n    resultLabel role: (success ifTrue: [ #code ] ifFalse: [ #error ]); text: value.\n    resultPreview role: (success ifTrue: [ #codePreview ] ifFalse: [ #errorPreview ]); text: value.\n    resultPanel visible: value size > 0","resultExpanded:":"resultExpanded: expanded\n    resultScroll visible: expanded.\n    resultPreview visible: expanded not.\n    resultToggle role: (expanded ifTrue: [ #disclosureOpen ] ifFalse: [ #disclosureClosed ])","resultPane":"resultPane\n    | bar |\n    resultToggle := UIButton new identifier: 'toolResultToggle'; onClickSend: #toggleResult to: self; yourself.\n    resultPreview := UILabel new yourself.\n    resultLabel := UILabel new identifier: 'evaluationResult'; yourself.\n    resultScroll := UIScroll new padding: 8; heightFrom: 68 to: 112; add: resultLabel; yourself.\n    bar := UIRow new role: #compactBar; add: resultToggle; add: resultPreview; yourself.\n    resultPanel := UIColumn new spacing: 0; visible: false;\n        add: UIDivider new; add: bar; add: resultScroll; yourself.\n    self resultExpanded: false.\n    ^ resultPanel","toggleResult":"toggleResult\n    self resultExpanded: resultScroll visible not"},"DisplayScreen":{"distanceTo:":"distanceTo: aWindow\n    | dx dy |\n    dx := (x * 2 + width) - (aWindow x * 2 + aWindow width).\n    dy := (y * 2 + height) - (aWindow y * 2 + aWindow height).\n    ^ dx squared + dy squared","height":"height\n    ^ height","id":"id\n    ^ id","overlapWith:":"overlapWith: aWindow\n    | overlapWidth overlapHeight |\n    overlapWidth := (((x + width) min: (aWindow x + aWindow width)) - (x max: aWindow x)) max: 0.\n    overlapHeight := (((y + height) min: (aWindow y + aWindow height)) - (y max: aWindow y)) max: 0.\n    ^ overlapWidth * overlapHeight","width":"width\n    ^ width","x":"x\n    ^ x","y":"y\n    ^ y"},"InspectorModel":{"back":"back\n    depth > 1 ifTrue: [ self dropTo: depth - 1 ].\n    ^ self refresh","changePageBy:":"changePageBy: offset\n    ^ self page: (self currentLevel at: 3) + offset","currentLevel":"currentLevel\n    ^ levels at: depth","dropTo:":"dropTo: index\n    [ depth > index ] whileTrue: [\n        levels at: depth put: nil.\n        depth := depth - 1 ]","follow:":"follow: key\n    | member value index nextLevel |\n    member := ToolVM inspectionMember: key in: (self currentLevel at: 1).\n    member isNil ifTrue: [ ^ self refresh ].\n    value := member at: 1.\n    index := depth.\n    [ index > 0 ] whileTrue: [\n        (ToolVM inspectionReference: value sameAs: ((levels at: index) at: 1))\n            ifTrue: [ self dropTo: index. ^ self refresh ].\n        index := index - 1 ].\n    depth < levels size ifTrue: [\n        nextLevel := self levelFor: value named: (member at: 2).\n        levels at: depth + 1 put: nextLevel.\n        depth := depth + 1 ].\n    ^ self refresh","levelFor:named:":"levelFor: anObject named: aString\n    | level |\n    level := Array new: 3.\n    level at: 1 put: anObject; at: 2 put: aString; at: 3 put: 0.\n    ^ level","openOn:":"openOn: anObject\n    levels := Array new: 64.\n    depth := 1.\n    levels at: depth put: (self levelFor: anObject named: (ToolVM inspectionClassOf: anObject)).\n    ^ self refresh","page:":"page: page\n    self currentLevel at: 3 put: page.\n    ^ self refresh","pageSize":"pageSize\n    ^ 100","refresh":"refresh\n    | level object count pageSize pageCount page start path result |\n    level := self currentLevel.\n    object := level at: 1.\n    count := ToolVM inspectionSizeOf: object.\n    pageSize := self pageSize.\n    pageCount := (((count + pageSize - 1) // pageSize) max: 1).\n    page := (level at: 3) clampFrom: 0 to: pageCount - 1.\n    level at: 3 put: page.\n    start := page * pageSize + 1.\n    path := Array new: depth.\n    1 to: depth do: [ :index | path at: index put: ((levels at: index) at: 2) ].\n    result := Array new: 7.\n    result at: 1 put: (ToolVM inspectionClassOf: object);\n        at: 2 put: (ToolVM inspectionSummaryOf: object);\n        at: 3 put: (ToolVM inspectionRowsOf: object from: start to: ((start + pageSize - 1) min: count));\n        at: 4 put: path;\n        at: 5 put: page;\n        at: 6 put: pageCount;\n        at: 7 put: count.\n    ^ result"},"Integer":{"clampFrom:to:":"clampFrom: lower to: upper\n    ^ (self max: lower) min: upper","max:":"max: other\n    self > other ifTrue: [ ^ self ].\n    ^ other","min:":"min: other\n    self < other ifTrue: [ ^ self ].\n    ^ other"},"Model":{"addDependent:":"addDependent: anObserver\n    | replacement |\n    self dependents do: [ :each | each == anObserver ifTrue: [ ^ anObserver ] ].\n    replacement := Array new: dependents size + 1.\n    1 to: dependents size do: [ :index | replacement at: index put: (dependents at: index) ].\n    replacement at: replacement size put: anObserver.\n    dependents := replacement.\n    ^ anObserver","changed":"changed\n    ^ self changed: nil","changed:":"changed: anAspect\n    self dependents do: [ :each | each update: anAspect ]","dependents":"dependents\n    dependents isNil ifTrue: [ dependents := Array new: 0 ].\n    ^ dependents","initialize":"initialize\n    dependents := nil","removeDependent:":"removeDependent: anObserver\n    dependents := self dependents select: [ :each | (each == anObserver) not ]"},"Object":{"initialize":"initialize\n    ^ self"},"ObjectInspectorWindow":{"initialize":"initialize\n    super initialize.\n    identifier := 'objectInspector'.\n    self title: 'Object Inspector';\n        minimumWidth: 380 height: 250;\n        resizeWidth: 540 height: 440"},"STCompiler":{"advance":"advance\n    current := lookahead.\n    lookahead := scanner nextToken","arrayElement":"arrayElement\n    | kind payload |\n    kind := self kind.\n    (#(integer string symbol identifier keyword) includes: kind) ifTrue: [\n        payload := self tokenValue.\n        self advance.\n        (#(symbol identifier keyword) includes: kind) ifTrue: [ ^ payload asSymbol ].\n        ^ payload ].\n    (kind = #binary and: [ self tokenValue = '-' ]) ifTrue: [ ^ self negativeNumber ].\n    (#(leftParen arrayStart) includes: kind) ifTrue: [ self advance. ^ self arrayElements ].\n    self fail: 'Expected a literal or ) in the array.'","arrayElements":"arrayElements\n    | elements |\n    elements := STCompilerList new.\n    [ self kind ~= #rightParen ] whileTrue: [ elements add: self arrayElement ].\n    self advance.\n    ^ elements elements","binaryExpression":"binaryExpression\n    | receiver |\n    receiver := self unaryExpression.\n    [ self kind = #binary ] whileTrue: [\n        receiver := self sendTo: receiver message: self binaryMessage ].\n    ^ receiver","binaryMessage":"binaryMessage\n    | selector |\n    selector := self tokenValue.\n    self advance.\n    ^ self pair: selector with: (self single: self unaryExpression)","blockAt:":"blockAt: position\n    | parameters body |\n    self advance.\n    parameters := STCompilerList new.\n    [ self kind = #colon ] whileTrue: [\n        self advance.\n        parameters add: self identifier ].\n    parameters := parameters elements.\n    parameters isEmpty ifFalse: [ self expect: #bar ].\n    self validateNames: parameters.\n    body := self bodyUntil: #rightBracket.\n    self validate: parameters separateFrom: (body at: 1) error: 'A block argument is also declared as a local variable.'.\n    self expect: #rightBracket.\n    ^ self node: #block at: position with: parameters with: body","bodyUntil:":"bodyUntil: terminator\n    | temporaries expressions |\n    temporaries := STCompilerList new.\n    self kind = #bar ifTrue: [\n        self advance.\n        [ self kind = #identifier ] whileTrue: [ temporaries add: self identifier ].\n        self expect: #bar ].\n    temporaries := temporaries elements.\n    self validateNames: temporaries.\n    expressions := STCompilerList new.\n    [ self kind ~= terminator and: [ self kind ~= #end ] ] whileTrue: [\n        expressions add: self expression.\n        self kind = #period ifTrue: [ self advance ] ifFalse: [\n            self kind = terminator ifFalse: [ self fail: 'Expected a period between expressions.' ] ] ].\n    ^ self pair: temporaries with: expressions elements","cascadeMessage":"cascadeMessage\n    self kind = #identifier ifTrue: [ ^ self unaryMessage ].\n    self kind = #binary ifTrue: [ ^ self binaryMessage ].\n    self kind = #keyword ifTrue: [ ^ self keywordMessage ].\n    self fail: 'Expected a message after ;.'","expect:":"expect: kind\n    self kind = kind ifFalse: [ self fail: (self tokenLabel: kind) , ' expected, found: ' , (self tokenLabel: self kind) , '.' ].\n    self advance","expression":"expression\n    | result |\n    expressionDepth := expressionDepth + 1.\n    expressionDepth > 128 ifTrue: [ self fail: 'Expression is nested too deeply.' ].\n    result := self expressionNode.\n    expressionDepth := expressionDepth - 1.\n    ^ result","expressionNode":"expressionNode\n    | position name first messages |\n    position := current.\n    self kind = #caret ifTrue: [\n        self advance.\n        ^ self node: #returnValue at: position with: self expression with: nil ].\n    (self kind = #identifier and: [ (lookahead at: 1) = #assign ]) ifTrue: [\n        name := self identifier.\n        self advance.\n        ^ self node: #assignment at: position with: name with: self expression ].\n    first := self keywordExpression.\n    self kind = #semicolon ifFalse: [ ^ first ].\n    (first at: 1) = #send ifFalse: [ self fail: 'A cascade must follow a message.' ].\n    messages := STCompilerList new.\n    messages add: (first at: 5).\n    [ self kind = #semicolon ] whileTrue: [\n        self advance.\n        messages add: self cascadeMessage ].\n    ^ self node: #cascade at: position with: (first at: 4) with: messages elements","fail:":"fail: message\n    self error: message line: (current at: 2) column: (current at: 3)","identifier":"identifier\n    | name |\n    self kind = #identifier ifFalse: [ self fail: 'Expected a variable name.' ].\n    name := self tokenValue.\n    self advance.\n    ^ name","initialize":"initialize\n    ^ self","keywordExpression":"keywordExpression\n    | receiver |\n    receiver := self binaryExpression.\n    self kind = #keyword ifFalse: [ ^ receiver ].\n    ^ self sendTo: receiver message: self keywordMessage","keywordMessage":"keywordMessage\n    | selector arguments |\n    selector := ''.\n    arguments := STCompilerList new.\n    [ self kind = #keyword ] whileTrue: [\n        selector := selector , self tokenValue.\n        self advance.\n        arguments add: self binaryExpression ].\n    ^ self pair: selector with: arguments elements","kind":"kind\n    ^ current at: 1","method:":"method: input\n    | selector parameters body kind |\n    self start: input.\n    parameters := STCompilerList new.\n    kind := self kind.\n    kind = #identifier ifTrue: [ selector := self identifier ].\n    kind = #binary ifTrue: [\n        selector := self tokenValue.\n        self advance.\n        parameters add: self identifier ].\n    kind = #keyword ifTrue: [\n        selector := ''.\n        [ self kind = #keyword ] whileTrue: [\n            selector := selector , self tokenValue.\n            self advance.\n            parameters add: self identifier ] ].\n    selector isNil ifTrue: [ self fail: 'Expected a method header such as increment or add: amount.' ].\n    parameters := parameters elements.\n    self validateNames: parameters.\n    body := self workspaceBody.\n    self validate: parameters separateFrom: (body at: 1) error: 'An argument and a local variable have the same name.'.\n    ^ self triple: selector with: parameters with: body","negativeNumber":"negativeNumber\n    | number |\n    self advance.\n    self kind = #minimumMagnitude ifTrue: [\n        self advance.\n        ^ '-9223372036854775808' asIntegerOrNil ].\n    self kind = #integer ifFalse: [ self fail: 'Expected an integer after -.' ].\n    number := self tokenValue.\n    self advance.\n    ^ number negated","node:at:with:with:":"node: tag at: position with: first with: second\n    | node |\n    node := Array new: 5.\n    node at: 1 put: tag; at: 2 put: (position at: 2); at: 3 put: (position at: 3).\n    node at: 4 put: first; at: 5 put: second.\n    ^ node","pair:with:":"pair: first with: second\n    | result |\n    result := Array new: 2.\n    result at: 1 put: first; at: 2 put: second.\n    ^ result","primary":"primary\n    | position kind payload node |\n    position := current.\n    kind := self kind.\n    (#(integer string symbol identifier) includes: kind) ifTrue: [\n        payload := self tokenValue.\n        self advance.\n        kind = #identifier ifTrue: [ ^ self node: #variable at: position with: payload with: nil ].\n        kind = #symbol ifTrue: [ payload := payload asSymbol ].\n        ^ self node: #literal at: position with: payload with: nil ].\n    (kind = #binary and: [ self tokenValue = '-' ]) ifTrue: [\n        ^ self node: #literal at: position with: self negativeNumber with: nil ].\n    kind = #minimumMagnitude ifTrue: [ self fail: 'Integer exceeds the 64-bit range.' ].\n    kind = #leftParen ifTrue: [\n        self advance.\n        node := self expression.\n        self expect: #rightParen.\n        ^ node ].\n    kind = #leftBracket ifTrue: [ ^ self blockAt: position ].\n    kind = #arrayStart ifTrue: [\n        self advance.\n        ^ self node: #literal at: position with: self arrayElements with: nil ].\n    self fail: 'Expected an expression.'","sendTo:message:":"sendTo: receiver message: message\n    ^ self node: #send at: receiver with: receiver with: message","single:":"single: first\n    | result |\n    result := Array new: 1.\n    result at: 1 put: first.\n    ^ result","start:":"start: input\n    expressionDepth := 0.\n    scanner := STScanner new.\n    scanner source: input.\n    current := scanner nextToken.\n    lookahead := scanner nextToken","tokenLabel:":"tokenLabel: kind\n    kind = #end ifTrue: [ ^ 'end of source' ].\n    kind = #rightBracket ifTrue: [ ^ ']' ].\n    kind = #rightParen ifTrue: [ ^ ')' ].\n    kind = #bar ifTrue: [ ^ '|' ].\n    kind = #period ifTrue: [ ^ '.' ].\n    ^ kind asString","tokenValue":"tokenValue\n    ^ current at: 4","triple:with:with:":"triple: first with: second with: third\n    | result |\n    result := Array new: 3.\n    result at: 1 put: first; at: 2 put: second; at: 3 put: third.\n    ^ result","unaryExpression":"unaryExpression\n    | receiver |\n    receiver := self primary.\n    [ self kind = #identifier ] whileTrue: [\n        receiver := self sendTo: receiver message: self unaryMessage ].\n    ^ receiver","unaryMessage":"unaryMessage\n    ^ self pair: self identifier with: #()","validate:separateFrom:error:":"validate: names separateFrom: locals error: message\n    names do: [ :name | (locals includes: name) ifTrue: [ self fail: message ] ]","validateNames:":"validateNames: names\n    names do: [ :name |\n        ((name at: 1) isLowercase and: [\n            (#('self' 'super' 'true' 'false' 'nil' 'thisContext') includes: name) not ]) ifFalse: [\n                self fail: 'Variable names must begin with a lowercase letter and cannot be pseudo-variables.' ] ].\n    1 to: names size do: [ :index |\n        1 to: index - 1 do: [ :earlier |\n            (names at: index) = (names at: earlier) ifTrue: [\n                self fail: 'Duplicate variable declaration.' ] ] ]","workspace:":"workspace: input\n    self start: input.\n    ^ self workspaceBody","workspaceBody":"workspaceBody\n    | body |\n    body := self bodyUntil: #end.\n    self expect: #end.\n    ^ body"},"STCompilerList":{"add:":"add: element\n    | grown |\n    count = storage size ifTrue: [\n        grown := Array new: storage size * 2.\n        1 to: count do: [ :each | grown at: each put: (storage at: each) ].\n        storage := grown ].\n    count := count + 1.\n    storage at: count put: element","elements":"elements\n    | result |\n    result := Array new: count.\n    1 to: count do: [ :each | result at: each put: (storage at: each) ].\n    ^ result","initialize":"initialize\n    storage := Array new: 8.\n    count := 0","joinedString":"joinedString\n    ^ storage joinedStringFrom: 1 to: count"},"STScanner":{"advance":"advance\n    (self peek isLineBreak) ifTrue: [\n        line := line + 1. column := 1\n    ] ifFalse: [ column := column + 1 ].\n    offset := offset + 1","fail:":"fail: message\n    self error: message line: tokenLine column: tokenColumn","initialize":"initialize\n    offset := 1.\n    line := 1.\n    column := 1.\n    nesting := 0","isBinary:":"isBinary: character\n    ^ character notNil and: [ '+-*/\\~<>=@%,&?!' includes: character ]","isIdentifierPart:":"isIdentifierPart: character\n    ^ (self isIdentifierStart: character) or: [ character notNil and: [ character isNumber ] ]","isIdentifierStart:":"isIdentifierStart: character\n    ^ character notNil and: [ character isLetter or: [ character = '_' ] ]","nextToken":"nextToken\n    self skipTrivia.\n    ^ self readToken","peek":"peek\n    ^ self peekAhead: 0","peekAhead:":"peekAhead: delta\n    | index |\n    index := offset + delta.\n    index > characters size ifTrue: [ ^ nil ].\n    ^ characters at: index","readComment":"readComment\n    self advance.\n    [ self peek notNil and: [ self peek ~= '\"' ] ] whileTrue: [ self advance ].\n    self peek isNil ifTrue: [ ^ self fail: 'Unterminated comment.' ].\n    self advance","readIdentifier":"readIdentifier\n    | start |\n    start := offset.\n    [ self isIdentifierPart: self peek ] whileTrue: [ self advance ].\n    ^ characters joinedStringFrom: start to: offset - 1","readNumber":"readNumber\n    | start digits number |\n    start := offset.\n    [ self peek notNil and: [ self peek isASCIIDigit ] ] whileTrue: [ self advance ].\n    digits := characters joinedStringFrom: start to: offset - 1.\n    digits = '9223372036854775808' ifTrue: [ ^ self token: #minimumMagnitude value: nil ].\n    number := digits asIntegerOrNil.\n    number isNil ifTrue: [ self fail: 'Integer exceeds the 64-bit range.' ].\n    ^ self token: #integer value: number","readString":"readString\n    | pieces start |\n    start := offset.\n    pieces := nil.\n    [ self peek notNil ] whileTrue: [\n        self peek = '''' ifTrue: [\n            self advance.\n            self peek = '''' ifFalse: [\n                pieces isNil ifTrue: [ ^ characters joinedStringFrom: start to: offset - 2 ].\n                pieces add: (characters joinedStringFrom: start to: offset - 2).\n                ^ pieces joinedString ].\n            pieces isNil ifTrue: [ pieces := STCompilerList new ].\n            pieces add: (characters joinedStringFrom: start to: offset - 1).\n            self advance.\n            start := offset\n        ] ifFalse: [ self advance ] ].\n    ^ self fail: 'Unterminated string.'","readSymbol":"readSymbol\n    | start more |\n    self peek = '(' ifTrue: [ self advance. ^ self token: #arrayStart value: nil ].\n    self peek = '''' ifTrue: [ self advance. ^ self token: #symbol value: self readString ].\n    start := offset.\n    (self isIdentifierStart: self peek) ifTrue: [\n        [ self isIdentifierPart: self peek ] whileTrue: [ self advance ].\n        more := true.\n        [ more and: [ self peek = ':' ] ] whileTrue: [\n            self advance.\n            more := self isIdentifierStart: self peek.\n            more ifTrue: [\n                [ self isIdentifierPart: self peek ] whileTrue: [ self advance ] ] ].\n        ^ self token: #symbol value: (characters joinedStringFrom: start to: offset - 1) ].\n    (self isBinary: self peek) ifTrue: [\n        [ self isBinary: self peek ] whileTrue: [ self advance ].\n        ^ self token: #symbol value: (characters joinedStringFrom: start to: offset - 1) ].\n    ^ self fail: 'Expected a symbol or ( after #.'","readToken":"readToken\n    | character start |\n    tokenLine := line. tokenColumn := column.\n    character := self peek.\n    character isNil ifTrue: [ ^ self token: #end value: nil ].\n    character isASCIIDigit ifTrue: [ ^ self readNumber ].\n    (self isIdentifierStart: character) ifTrue: [ ^ self readWord ].\n    start := offset.\n    self advance.\n    character = '''' ifTrue: [ ^ self token: #string value: self readString ].\n    character = '#' ifTrue: [ ^ self readSymbol ].\n    character = ':' ifTrue: [\n        self peek = '=' ifTrue: [ self advance. ^ self token: #assign value: nil ].\n        ^ self token: #colon value: nil ].\n    character = '.' ifTrue: [ ^ self token: #period value: nil ].\n    character = ';' ifTrue: [ ^ self token: #semicolon value: nil ].\n    character = '^' ifTrue: [ ^ self token: #caret value: nil ].\n    character = '|' ifTrue: [ ^ self token: #bar value: nil ].\n    character = '(' ifTrue: [ ^ self token: #leftParen value: nil ].\n    character = ')' ifTrue: [ ^ self token: #rightParen value: nil ].\n    character = '[' ifTrue: [ ^ self token: #leftBracket value: nil ].\n    character = ']' ifTrue: [ ^ self token: #rightBracket value: nil ].\n    (self isBinary: character) ifTrue: [\n        [ self isBinary: self peek ] whileTrue: [ self advance ].\n        ^ self token: #binary value: (characters joinedStringFrom: start to: offset - 1) ].\n    ^ self fail: 'Unknown character: ' , character","readWord":"readWord\n    | name |\n    name := self readIdentifier.\n    (self peek = ':' and: [ (self peekAhead: 1) ~= '=' ]) ifTrue: [\n        self advance.\n        ^ self token: #keyword value: (name , ':') ].\n    ^ self token: #identifier value: name","skipTrivia":"skipTrivia\n    | character |\n    [ character := self peek.\n      character notNil and: [ character isWhitespace or: [ character = '\"' ] ] ] whileTrue: [\n        character = '\"' ifTrue: [\n            tokenLine := line. tokenColumn := column.\n            self readComment\n        ] ifFalse: [ self advance ] ]","source:":"source: aString\n    characters := aString characters","token:value:":"token: kind value: payload\n    | token |\n    (#(leftParen leftBracket arrayStart) includes: kind) ifTrue: [\n        nesting := nesting + 1.\n        nesting > 32 ifTrue: [ self fail: 'Source code exceeds the nesting limit of 32 levels.' ] ].\n    (#(rightParen rightBracket) includes: kind) ifTrue: [ nesting := nesting - 1 ].\n    token := Array new: 4.\n    token at: 1 put: kind; at: 2 put: tokenLine; at: 3 put: tokenColumn; at: 4 put: payload.\n    ^ token"},"STSourceScanner":{"fail:":"fail: message\n    ^ nil","highlight:":"highlight: kind\n    | span |\n    span := Array new: 3.\n    span at: 1 put: kind; at: 2 put: tokenStart; at: 3 put: offset.\n    ^ span","nextHighlight":"nextHighlight\n    | span |\n    [ self peek notNil ] whileTrue: [\n        tokenStart := offset.\n        self peek isWhitespace\n            ifTrue: [ self advance ]\n            ifFalse: [\n                span := self peek = '\"'\n                    ifTrue: [ self readComment. self highlight: #comment ]\n                    ifFalse: [ self readToken ].\n                span notNil ifTrue: [ ^ span ] ] ].\n    ^ nil","token:value:":"token: kind value: value\n    (#(string symbol arrayStart) includes: kind) ifTrue: [ ^ self highlight: #literal ].\n    (#(assign caret integer minimumMagnitude) includes: kind) ifTrue: [ ^ self highlight: #language ].\n    (kind = #identifier and: [ #('self' 'super' 'nil' 'true' 'false' 'thisContext') includes: value ])\n        ifTrue: [ ^ self highlight: #language ].\n    ^ nil"},"SystemWindow":{"activate":"activate\n    ^ Desktop activate: self","canClose":"canClose\n    ^ true","close":"close\n    ^ Desktop requestClose: self","frameApplied:x:y:width:height:":"frameApplied: aRevision x: newX y: newY width: newWidth height: newHeight\n    frameRevision = aRevision ifTrue: [ self observeX: newX y: newY width: newWidth height: newHeight ]","frameRevision":"frameRevision\n    ^ frameRevision","height":"height\n    ^ height","id":"id\n    ^ id","id:":"id: anID\n    id := anID","initialize":"initialize\n    super initialize.\n    id := 0. kind := #workspace. title := 'Workspace'. text := ''.\n    x := 100. y := 200. width := 720. height := 600. minimized := false.\n    minimumWidth := 480. minimumHeight := 320.\n    maximumWidth := 8192. maximumHeight := 8192.\n    frameRevision := 1. stateRevision := 1.\n    nativeMinimumWidth := 480. nativeMinimumHeight := 320. nativeMaximumWidth := 8192. nativeMaximumHeight := 8192","kind":"kind\n    ^ kind","kind:":"kind: aKind\n    kind := aKind.\n    minimumWidth := 320. minimumHeight := 160.\n    kind = #workspace ifTrue: [ minimumWidth := 480. minimumHeight := 320 ].\n    (kind = #browser or: [ kind = #changes ]) ifTrue: [ minimumWidth := 750. minimumHeight := 500 ].\n    kind = #transcript ifTrue: [ minimumWidth := 400. minimumHeight := 200 ].\n    frameRevision := frameRevision + 1. self changed: #kind. Desktop constrain: self","maximumHeight":"maximumHeight\n    ^ maximumHeight","maximumWidth":"maximumWidth\n    ^ maximumWidth","maximumWidth:height:":"maximumWidth: newWidth height: newHeight\n    maximumWidth := newWidth clampFrom: minimumWidth to: 8192.\n    maximumHeight := newHeight clampFrom: minimumHeight to: 8192.\n    frameRevision := frameRevision + 1.\n    Desktop constrain: self","minimized":"minimized\n    ^ minimized","minimized:":"minimized: aBoolean\n    minimized := aBoolean.\n    stateRevision := stateRevision + 1.\n    self changed: #minimized","minimumHeight":"minimumHeight\n    ^ minimumHeight","minimumWidth":"minimumWidth\n    ^ minimumWidth","minimumWidth:height:":"minimumWidth: newWidth height: newHeight\n    minimumWidth := newWidth clampFrom: 1 to: 8192.\n    minimumHeight := newHeight clampFrom: 1 to: 8192.\n    maximumWidth := maximumWidth max: minimumWidth.\n    maximumHeight := maximumHeight max: minimumHeight.\n    frameRevision := frameRevision + 1.\n    Desktop constrain: self","moveToX:y:":"moveToX: newX y: newY\n    x := newX. y := newY. frameRevision := frameRevision + 1.\n    Desktop constrain: self","nativeMinimumWidth:height:maximumWidth:height:":"nativeMinimumWidth: minWidth height: minHeight maximumWidth: maxWidth height: maxHeight\n    nativeMinimumWidth := minWidth. nativeMinimumHeight := minHeight.\n    nativeMaximumWidth := maxWidth. nativeMaximumHeight := maxHeight","observeMinimized:":"observeMinimized: aBoolean\n    minimized := aBoolean.\n    self changed: #minimized","observeX:y:width:height:":"observeX: newX y: newY width: newWidth height: newHeight\n    x := newX. y := newY. width := newWidth. height := newHeight.\n    self changed: #frame","open":"open\n    ^ Desktop open: self","placeX:y:width:height:":"placeX: newX y: newY width: newWidth height: newHeight\n    (x = newX and: [ y = newY and: [ width = newWidth and: [ height = newHeight ] ] ]) ifFalse: [\n        frameRevision := frameRevision + 1 ].\n    x := newX. y := newY. width := newWidth. height := newHeight.\n    self changed: #frame","resizeWidth:height:":"resizeWidth: newWidth height: newHeight\n    width := newWidth. height := newHeight. frameRevision := frameRevision + 1.\n    Desktop constrain: self","stateRevision":"stateRevision\n    ^ stateRevision","text":"text\n    ^ text","text:":"text: aString\n    text := aString.\n    self changed: #text","title":"title\n    ^ title","title:":"title: aTitle\n    title := aTitle.\n    self changed: #title","width":"width\n    ^ width","x":"x\n    ^ x","y":"y\n    ^ y"},"TestCase":{"assert:":"assert: condition\n    condition ifFalse: [ self fail: 'Expected true.' ]","assert:equals:":"assert: actual equals: expected\n    (actual = expected) ifFalse: [\n        self fail: 'Expected ' , expected printString , ', got ' , actual printString , '.' ]","deny:":"deny: condition\n    condition ifTrue: [ self fail: 'Expected false.' ]","fail:":"fail: aString\n    ToolVM failTest: aString","setUp":"setUp\n    ^ self","tearDown":"tearDown\n    ^ self"},"TestOutcome":{"diagnostics":"diagnostics\n    ^ diagnostics","initialize":"initialize\n    diagnostics := #()","record:during:":"record: diagnostic during: phase\n    | entry |\n    diagnostic isNil ifTrue: [ ^ self ].\n    entry := Array new: 5.\n    entry at: 1 put: phase;\n        at: 2 put: (diagnostic at: 1);\n        at: 3 put: (diagnostic at: 2);\n        at: 4 put: (diagnostic at: 3);\n        at: 5 put: (diagnostic at: 4).\n    diagnostics := diagnostics copyWith: entry","selector":"selector\n    ^ selector","status":"status\n    diagnostics do: [ :each | (each at: 2) = #error ifTrue: [ ^ #error ] ].\n    ^ diagnostics isEmpty ifTrue: [ #passed ] ifFalse: [ #failure ]","testClass":"testClass\n    ^ testClass","testClass:selector:":"testClass: aClass selector: aSelector\n    testClass := aClass.\n    selector := aSelector"},"TestResult":{"errorCount":"errorCount\n    ^ errors","failureCount":"failureCount\n    ^ failures","initialize":"initialize\n    self outcomes: #()","isSuccess":"isSuccess\n    ^ self testCount > 0 and: [ failures + errors = 0 ]","outcomes":"outcomes\n    ^ outcomes","outcomes:":"outcomes: results\n    outcomes := results.\n    failures := 0.\n    errors := 0.\n    outcomes do: [ :each |\n        | status |\n        status := each status.\n        status = #failure ifTrue: [ failures := failures + 1 ].\n        status = #error ifTrue: [ errors := errors + 1 ] ]","passedCount":"passedCount\n    ^ self testCount - failures - errors","summary":"summary\n    ^ self testCount printString , ' total, ' , self passedCount printString , ' passed, ' ,\n        failures printString , ' failed, ' , errors printString , ' with errors'","testCount":"testCount\n    ^ outcomes size"},"Transcript":{"clear":"clear\n    TranscriptBuffer clear","cr":"cr\n    self show: ToolVM lineBreak","show:":"show: value\n    | text |\n    text := value class == String ifTrue: [ value ] ifFalse: [ value printString ].\n    self record: text.\n    TranscriptBuffer append: text"},"TranscriptModel":{"append:":"append: aString\n    | addition |\n    addition := aString suffixFittingUTF8: 65536.\n    contents := (contents suffixFittingUTF8: 65536 - addition utf8Size) , addition.\n    self changed: #text","clear":"clear\n    contents := ''.\n    self changed: #text","initialize":"initialize\n    super initialize.\n    contents := ''","text":"text\n    contents size = 0 ifTrue: [ ^ 'Transcript show: ''Hello''; cr.' ].\n    ^ contents"},"TranscriptWindow":{"initialize":"initialize\n    | output scroll menu |\n    super initialize.\n    self kind: #transcript.\n    self title: 'Transcript'.\n    output := UILabel new identifier: 'transcriptOutput'; role: #code; yourself.\n    output bind: #text to: TranscriptBuffer aspect: #text.\n    menu := UIMenu new add: (UIButton new title: 'Clear Transcript'; identifier: 'clearTranscript';\n        command: #clearTranscript; onClickSend: #clear to: TranscriptBuffer; yourself); yourself.\n    scroll := UIScroll new role: #followEnd; padding: 12; contextMenu: menu; add: output; yourself.\n    self content: scroll"},"UIBinding":{"active":"active\n    ^ active","aspect":"aspect\n    ^ aspect","connect":"connect\n    active ifTrue: [ ^ self ].\n    active := true.\n    source addDependent: self.\n    self update: nil","disconnect":"disconnect\n    active ifFalse: [ ^ self ].\n    active := false.\n    source removeDependent: self","initialize":"initialize\n    active := false","property":"property\n    ^ property","source":"source\n    ^ source","source:aspect:view:property:":"source: aModel aspect: anAspect view: aView property: aProperty\n    source := aModel.\n    aspect := anAspect.\n    view := aView.\n    property := aProperty","update:":"update: anAspect\n    active ifFalse: [ ^ self ].\n    (anAspect isNil or: [ anAspect = aspect ]) ifTrue: [\n        view perform: (property asString, ':') asSymbol with: (source perform: aspect) ]","view":"view\n    ^ view"},"UIBindingTest":{"setUp":"setUp\n    model := BindingTestModel new.\n    model caption: 'Initial'.\n    label := UILabel new.\n    label bind: #text to: model aspect: #caption","tearDown":"tearDown\n    label unbindAll","testBindingReadsAndUpdatesTheLabel":"testBindingReadsAndUpdatesTheLabel\n    self assert: label text equals: 'Initial'.\n    model caption: 'Changed'.\n    self assert: label text equals: 'Changed'","testUnbindingStopsUpdates":"testUnbindingStopsUpdates\n    label unbind: #text.\n    model caption: 'Changed'.\n    self assert: label text equals: 'Initial'.\n    self assert: model dependents isEmpty"},"UIButton":{"action:":"action: aBlock\n    action := aBlock","click":"click\n    enabled ifFalse: [ ^ self ].\n    action notNil ifTrue: [ ^ action value ]","clickWithSelection:":"clickWithSelection: aString\n    enabled ifFalse: [ ^ self ].\n    selectionAction isNil ifTrue: [ ^ self click ].\n    ^ selectionAction value: aString","command:":"command: aSymbol\n    command := aSymbol","icon:":"icon: aString\n    icon := aString","initialize":"initialize\n    super initialize.\n    title := 'Button'.\n    action := nil","onClickSend:to:":"onClickSend: aSelector to: aController\n    self action: [ aController perform: aSelector ]","selectionFrom:action:":"selectionFrom: anEditor action: aBlock\n    selectionSource := anEditor.\n    selectionAction := aBlock","shortcutHint:":"shortcutHint: aString\n    shortcutHint := aString","title":"title\n    ^ title","title:":"title: aString\n    title := aString"},"UICodeEditor":{"contextMenu":"contextMenu\n    ^ contextMenu","contextMenu:":"contextMenu: aMenu\n    contextMenu := aMenu","editingMenu:":"editingMenu: entries\n    editingMenu := entries","initialize":"initialize\n    super initialize.\n    readOnly := false.\n    lineNumbers := false.\n    syntaxHighlighting := false.\n    undoEnabled := true.\n    editingMenu := #((#cut 'Cut') (#copy 'Copy') (#paste 'Paste') (#selectAll 'Select All'))","lineNumbers:":"lineNumbers: aBoolean\n    lineNumbers := aBoolean","readOnly:":"readOnly: aBoolean\n    readOnly := aBoolean","role:":"role: aSymbol\n    super role: aSymbol.\n    lineNumbers := aSymbol = #source.\n    syntaxHighlighting := lineNumbers","syntaxHighlighting:":"syntaxHighlighting: aBoolean\n    syntaxHighlighting := aBoolean","undoEnabled:":"undoEnabled: aBoolean\n    undoEnabled := aBoolean"},"UIContainer":{"add:":"add: anElement\n    | replacement |\n    replacement := Array new: children size + 1.\n    1 to: children size do: [ :index | replacement at: index put: (children at: index) ].\n    replacement at: replacement size put: anElement.\n    children := replacement.\n    ^ anElement","children":"children\n    ^ children","children:":"children: anArray\n    children := anArray","initialize":"initialize\n    super initialize.\n    children := Array new: 0.\n    spacing := 8.\n    padding := 0","padding":"padding\n    ^ padding","padding:":"padding: aNumber\n    padding := aNumber","remove:":"remove: anElement\n    children := children select: [ :each | (each == anElement) not ]","removeAll":"removeAll\n    children := Array new: 0","spacing":"spacing\n    ^ spacing","spacing:":"spacing: aNumber\n    spacing := aNumber"},"UIElement":{"bind:to:aspect:":"bind: aProperty to: aModel aspect: anAspect\n    | binding replacement |\n    self unbind: aProperty.\n    binding := UIBinding new.\n    binding source: aModel aspect: anAspect view: self property: aProperty.\n    replacement := Array new: self bindings size + 1.\n    1 to: mvcBindings size do: [ :index | replacement at: index put: (mvcBindings at: index) ].\n    replacement at: replacement size put: binding.\n    mvcBindings := replacement.\n    binding connect","bindings":"bindings\n    mvcBindings isNil ifTrue: [ mvcBindings := Array new: 0 ].\n    ^ mvcBindings","enabled":"enabled\n    ^ enabled","enabled:":"enabled: aBoolean\n    enabled := aBoolean","heightFrom:to:":"heightFrom: minimum to: maximum\n    minHeight := minimum.\n    maxHeight := maximum","identifier:":"identifier: aString\n    identifier := aString","initialize":"initialize\n    enabled := true.\n    visible := true.\n    mvcBindings := nil","role:":"role: aSymbol\n    role := aSymbol","unbind:":"unbind: aProperty\n    self bindings do: [ :each | each property = aProperty ifTrue: [ each disconnect ] ].\n    mvcBindings := mvcBindings select: [ :each | (each property = aProperty) not ]","unbindAll":"unbindAll\n    self bindings do: [ :each | each disconnect ].\n    mvcBindings := nil","visible":"visible\n    ^ visible","visible:":"visible: aBoolean\n    visible := aBoolean","widthFrom:to:":"widthFrom: minimum to: maximum\n    minWidth := minimum.\n    maxWidth := maximum"},"UIHistoryList":{"command:":"command: aSymbol\n    command := aSymbol","entries:":"entries: rows\n    entries := rows.\n    self items: (rows collect: [ :each | each at: 1 ])","includes:":"includes: key\n    ^ items includes: key","initialize":"initialize\n    super initialize.\n    entries := #()","rowIdentifierPrefix:":"rowIdentifierPrefix: aString\n    rowIdentifierPrefix := aString"},"UILabel":{"initialize":"initialize\n    super initialize.\n    text := ''","text":"text\n    ^ text","text:":"text: aString\n    text := aString"},"UIList":{"initialize":"initialize\n    super initialize.\n    items := #().\n    selection := nil","items:":"items: values\n    items := values","onSelectSend:to:":"onSelectSend: message to: receiver\n    target := receiver.\n    selector := message","select:":"select: value\n    (value isNil or: [ items includes: value ]) ifFalse: [ ^ self ].\n    selection := value.\n    target notNil ifTrue: [ ^ target perform: selector with: value ]","selection:":"selection: value\n    selection := value"},"UIMenu":{"initialize":"initialize\n    super initialize.\n    title := 'Menu'","title:":"title: aString\n    title := aString"},"UIScroll":{"contextMenu:":"contextMenu: aMenu\n    contextMenu := aMenu"},"UISourceView":{"initialize":"initialize\n    super initialize.\n    text := ''.\n    line := 1.\n    column := 1","line:column:":"line: aLine column: aColumn\n    line := aLine.\n    column := aColumn","text:":"text: aString\n    text := aString"},"UITextField":{"editText:":"editText: aString\n    self text: aString.\n    mvcInputTarget notNil ifTrue: [ ^ mvcInputTarget perform: mvcInputSelector with: aString ]","initialize":"initialize\n    super initialize.\n    label := ''.\n    text := ''.\n    placeholder := ''","label":"label\n    ^ label","label:":"label: aString\n    label := aString","onChangeSend:to:":"onChangeSend: aSelector to: aController\n    mvcInputTarget := aController.\n    mvcInputSelector := aSelector","placeholder":"placeholder\n    ^ placeholder","placeholder:":"placeholder: aString\n    placeholder := aString","text":"text\n    ^ text","text:":"text: aString\n    text := aString"},"UIValueTable":{"columnSpacing:padding:":"columnSpacing: spacing padding: padding\n    columnSpacing := spacing.\n    horizontalPadding := padding","command:":"command: aSymbol\n    command := aSymbol","headings:":"headings: labels\n    headings := labels","initialize":"initialize\n    super initialize.\n    rows := #().\n    headings := #('Name' 'Value' 'Class').\n    rowIdentifierPrefix := 'row'.\n    self nameWidth: 96 classWidth: 108;\n        columnSpacing: 12 padding: 12;\n        valueLines: 3","nameWidth:classWidth:":"nameWidth: nameColumn classWidth: classColumn\n    nameWidth := nameColumn.\n    classWidth := classColumn","readOnly:":"readOnly: aBoolean\n    readOnly := aBoolean","rowIdentifierPrefix:":"rowIdentifierPrefix: aString\n    rowIdentifierPrefix := aString","rows:":"rows: entries\n    rows := entries.\n    self items: (entries collect: [ :each | each at: 1 ])","valueLines:":"valueLines: count\n    valueLines := count"},"UIWindow":{"content":"content\n    ^ content","content:":"content: anElement\n    content := anElement","initialize":"initialize\n    super initialize.\n    self kind: #custom.\n    title := 'Window'.\n    width := 480.\n    height := 320.\n    content := nil"},"WorkspaceWindow":{"actionsMenu":"actionsMenu\n    | menu |\n    menu := UIMenu new title: 'Workspace actions'; identifier: 'workspaceActions'; role: #moreMenu; yourself.\n    menu add: ((self selectionButton: 'Print it' command: #printIt action: #printIt:) identifier: 'workspaceAction-printIt'; yourself).\n    menu add: ((self selectionButton: 'Inspect it' command: #inspectIt action: #inspect:) identifier: 'workspaceAction-inspectIt'; yourself).\n    menu add: ((self selectionButton: 'Debug it' command: #debugIt action: #debugIt:) identifier: 'workspaceAction-debugIt'; yourself).\n    ^ menu","debugIt:":"debugIt: selected\n    ToolVM requestDebugSource: (self sourceForSelection: selected) for: self","doIt:":"doIt: selected\n    ^ self execute: selected printing: false","editorMenu":"editorMenu\n    | menu |\n    menu := UIMenu new title: 'Workspace'; yourself.\n    menu add: (self selectionButton: 'Do it' command: #doIt action: #doIt:).\n    menu add: (self selectionButton: 'Print it' command: #printIt action: #printIt:).\n    menu add: (self selectionButton: 'Inspect it' command: #inspectIt action: #inspect:).\n    menu add: (self selectionButton: 'Debug it' command: #debugIt action: #debugIt:).\n    ^ menu","exampleButton:key:":"exampleButton: aTitle key: exampleKey\n    ^ UIButton new title: aTitle; action: [\n        | workspace |\n        workspace := Desktop openWorkspace.\n        workspace notNil ifTrue: [ workspace text: (ToolVM exampleAt: exampleKey) ] ]; yourself","examplesMenu":"examplesMenu\n    | menu |\n    menu := UIMenu new title: 'Examples'; role: #applicationMenu; yourself.\n    menu add: (self exampleButton: 'Counter' key: #workspace).\n    menu add: (self exampleButton: 'Arrays and Blocks' key: #collections).\n    menu add: (self exampleButton: 'Create a Class' key: #classes).\n    menu add: (self exampleButton: 'Open Windows' key: #windows).\n    menu add: (self exampleButton: 'Custom Interface' key: #userInterface).\n    ^ menu","execute:printing:":"execute: selected printing: aBoolean\n    | outcome |\n    outcome := ToolVM evaluateSource: (self sourceForSelection: selected).\n    self result: outcome.\n    (aBoolean and: [ outcome at: 1 ]) ifTrue: [ Transcript show: '→ ' , (outcome at: 2); cr ].\n    ^ outcome at: 2","initialize":"initialize\n    | root bar doIt |\n    super initialize.\n    self kind: #workspace.\n    self title: 'Workspace'.\n    self resizeWidth: 720 height: 600.\n    editor := UICodeEditor new identifier: 'workspaceEditor'; label: 'Smalltalk Workspace'; role: #source; yourself.\n    editor onChangeSend: #text: to: self.\n    editor contextMenu: self editorMenu.\n    doIt := (self selectionButton: 'Do it' command: #doIt action: #doIt:)\n        identifier: 'executeButton'; role: #primary; shortcutHint: '⌘D'; yourself.\n    bar := UIRow new role: #windowToolbar; spacing: 5; add: doIt; add: self actionsMenu; yourself.\n    root := UIColumn new spacing: 0; add: bar; add: self examplesMenu; add: editor; add: self resultPane; yourself.\n    self content: root","inspect:":"inspect: selected\n    | outcome |\n    outcome := ToolVM inspectSource: (self sourceForSelection: selected).\n    self result: outcome.\n    ^ outcome at: 2","printIt:":"printIt: selected\n    ^ self execute: selected printing: true","selectionButton:command:action:":"selectionButton: aTitle command: aCommand action: aSelector\n    ^ UIButton new\n        title: aTitle;\n        command: aCommand;\n        selectionFrom: editor action: [ :selected | self perform: aSelector with: selected ];\n        yourself","sourceForSelection:":"sourceForSelection: selected\n    ^ selected size = 0 ifTrue: [ self text ] ifFalse: [ selected ]","text:":"text: aString\n    super text: aString.\n    editor notNil ifTrue: [ editor text: aString ]"}},"version":1}