evel at: 3) + offset","currentLevel":"currentLevel\n    ^ levels at: depth","dropTo:":"dropTo: index\n    [ depth > index ] whileTrue: [\n        levels at: depth put: nil.\n        depth := depth - 1 ]","follow:":"follow: key\n    | member value index nextLevel |\n    member := ToolVM inspectionMember: key in: (self currentLevel at: 1).\n    member isNil ifTrue: [ ^ self refresh ].\n    value := member at: 1.\n    index := depth.\n    [ index > 0 ] whileTrue: [\n        (ToolVM inspectionReference: value sameAs: ((levels at: index) at: 1))\n            ifTrue: [ self dropTo: index. ^ self refresh ].\n        index := index - 1 ].\n    depth < levels size ifTrue: [\n        nextLevel := self levelFor: value named: (member at: 2).\n        levels at: depth + 1 put: nextLevel.\n        depth := depth + 1 ].\n    ^ self refresh","levelFor:named:":"levelFor: anObject named: aString\n    | level |\n    level := Array new: 3.\n    level at: 1 put: anObject; at: 2 put: aString; at: 3 put: 0.\n    ^ level","openOn:":"openOn: anObject\n    levels := Array new: 64.\n    depth := 1.\n    levels at: depth put: (self levelFor: anObject named: (ToolVM inspectionClassOf: anObject)).\n    ^ self refresh","page:":"page: page\n    self currentLevel at: 3 put: page.\n    ^ self refresh","pageSize":"pageSize\n    ^ 100","refresh":"refresh\n    | level object count pageSize pageCount page start path result |\n    level := self currentLevel.\n    object := level at: 1.\n    count := ToolVM inspectionSizeOf: object.\n    pageSize := self pageSize.\n    pageCount := (((count + pageSize - 1) // pageSize) max: 1).\n    page := (level at: 3) clampFrom: 0 to: pageCount - 1.\n    level at: 3 put: page.\n    start := page * pageSize + 1.\n    path := Array new: depth.\n    1 to: depth do: [ :index | path at: index put: ((levels at: index) at: 2) ].\n    result := Array new: 7.\n    result at: 1 put: (ToolVM inspectionClassOf: object);\n        at: 2 put: (ToolVM inspectionSummaryOf: object);\n        at: 3 put: (ToolVM inspectionRowsOf: object from: start to: ((start + pageSize - 1) min: count));\n        at: 4 put: path;\n        at: 5 put: page;\n        at: 6 put: pageCount;\n        at: 7 put: count.\n    ^ result"},"Integer":{"allMask:":"allMask: mask\n    ^ (self bitAnd: mask) = mask","anyMask:":"anyMask: mask\n    ^ (self bitAnd: mask) ~= 0","asFraction":"asFraction ^ self","ceiling":"ceiling ^ self","clampFrom:to:":"clampFrom: lower to: upper\n    ^ (self max: lower) min: upper","even":"even\n    ^ (self bitAnd: 1) = 0","factorial":"factorial\n    | result |\n    self < 0 ifTrue: [ self error: 'Factorial requires a nonnegative integer.' ].\n    result := 1.\n    2 to: self do: [ :factor | result := result * factor ].\n    ^ result","floor":"floor ^ self","gcd:":"gcd: other\n    | a b remainder |\n    a := self abs.\n    b := other abs.\n    (b isKindOf: Integer) ifFalse: [ self error: 'Expected an integer.' ].\n    [ b ~= 0 ] whileTrue: [\n        remainder := a \\\\ b.\n        a := b.\n        b := remainder ].\n    ^ a","integerPart":"integerPart ^ self","lcm:":"lcm: other\n    | divisor |\n    divisor := self gcd: other.\n    divisor = 0 ifTrue: [ ^ 0 ].\n    ^ ((self // divisor) * other) abs","max:":"max: other\n    self > other ifTrue: [ ^ self ].\n    ^ other","min:":"min: other\n    self < other ifTrue: [ ^ self ].\n    ^ other","noMask:":"noMask: mask\n    ^ (self bitAnd: mask) = 0","odd":"odd\n    ^ self even not","printOn:base:showRadix:":"printOn: output base: base showRadix: showRadix\n    | digits |\n    showRadix ifFalse: [ ^ output nextPutAll: (self printStringRadix: base) ].\n    digits := self abs printStringRadix: base.\n    self < 0 ifTrue: [ output nextPut: $- ].\n    output nextPutAll: base printString; nextPut: $r; nextPutAll: digits","rounded":"rounded ^ self","sqrt":"sqrt ^ self _integerSqrt","truncated":"truncated ^ self"},"Interval":{",":", other\n    ^ self asArray , other","_elementAt:":"_elementAt: index\n    | offset element |\n    offset := index - 1.\n    element := (self _tryFloatCalculation: [ offset * step + start ])\n        ifNil: [ (offset * step asFraction + start asFraction) asFloat ].\n    ^ self _coerceElement: element","at:":"at: index\n    ((index isKindOf: Integer) and: [ index between: 1 and: count ])\n        ifFalse: [ self error: 'Index outside interval.' ].\n    ^ self _elementAt: index","collect:":"collect: operation\n    ^ self asArray collect: operation","copyFrom:to:":"copyFrom: first to: last\n    | result |\n    ((first isKindOf: Integer) and: [\n        (last isKindOf: Integer) and: [\n            (first between: 1 and: count) and: [ last between: 1 and: count ] ] ])\n        ifFalse: [ self error: 'Invalid interval range.' ].\n    result := Array new: ((last - first + 1) max: 0).\n    first to: last do: [ :index | result at: index - first + 1 put: (self at: index) ].\n    ^ self _sequenceFrom: result","do:":"do: operation\n    1 to: count do: [ :index | operation value: (self _elementAt: index) ]","includes:":"includes: element\n    ^ self anySatisfy: [ :each | each = element ]","initializeFrom:to:by:":"initializeFrom: first to: last by: increment\n    | extent |\n    increment = 0 ifTrue: [ self error: 'The interval step must be nonzero.' ].\n    extent := (self _tryFloatCalculation: [ (last - first) // increment ])\n        ifNil: [ (last asFraction - first asFraction) // increment asFraction ].\n    count := (extent + 1) max: 0.\n    start := first.\n    step := increment.\n    ^ self","isEmpty":"isEmpty\n    ^ self size = 0","select:":"select: predicate\n    ^ self asArray select: predicate","size":"size\n    ^ count"},"MessageNotUnderstood":{"description":"description\n    ^ receiver class name asString , ' does not understand ' , message selector asString","isResumable":"isResumable\n    ^ true","message":"message\n    ^ message","receiver":"receiver\n    ^ receiver","receiver:message:":"receiver: anObject message: failed\n    receiver := anObject.\n    message := failed"},"Model":{"addDependent:":"addDependent: anObserver\n    | replacement |\n    self dependents do: [ :each | each == anObserver ifTrue: [ ^ anObserver ] ].\n    replacement := Array new: dependents size + 1.\n    1 to: dependents size do: [ :index | replacement at: index put: (dependents at: index) ].\n    replacement at: replacement size put: anObserver.\n    dependents := replacement.\n    ^ anObserver","changed":"changed\n    ^ self changed: nil","changed:":"changed: anAspect\n    self dependents do: [ :each | each update: anAspect ]","dependents":"dependents\n    dependents isNil ifTrue: [ dependents := Array new: 0 ].\n    ^ dependents","initialize":"initialize\n    dependents := nil","removeDependent:":"removeDependent: anObserver\n    dependents := self dependents select: [ :each | (each == anObserver) not ]"},"Notification":{"defaultAction":"defaultAction\n    ^ nil","isResumable":"isResumable\n    ^ true"},"Number":{"_coerceRoundingFactor:":"_coerceRoundingFactor: factor\n    (self isKindOf: Float) ifTrue: [ ^ factor asFloat ].\n    ((self isKindOf: ScaledDecimal) and: [ factor isKindOf: Integer ])\n        ifTrue: [ ^ factor asScaledDecimal: 0 ].\n    ^ factor","asInteger":"asInteger\n    ^ self rounded","between:and:":"between: lower and: upper\n    ^ self >= lower and: [ self <= upper ]","fractionPart":"fractionPart\n    | part |\n    part := self \\\\ 1.\n    ((self isKindOf: Fraction) and: [ part isKindOf: Integer ])\n        ifTrue: [\n            \"The factory preserves 0/2 as a Fraction with reduced denominator 1.\"\n            ^ Fraction numerator: 0 denominator: 2 ].\n    ^ part","max:":"max: other\n    self > other ifTrue: [ ^ self ].\n    ^ other","min:":"min: other\n    self < other ifTrue: [ ^ self ].\n    ^ other","negative":"negative\n    ^ self < 0","positive":"positive\n    ^ self >= 0","quo:":"quo: divisor\n    | quotient |\n    quotient := self // divisor.\n    (quotient < 0 and: [ (self \\\\ divisor) ~= 0 ]) ifTrue: [ ^ quotient + 1 ].\n    ^ quotient","raisedTo:":"raisedTo: exponent\n    (self = 0 and: [ exponent = 0 ]) ifTrue: [ self error: 'Zero requires a positive exponent.' ].\n    (exponent isKindOf: Integer) ifTrue: [ ^ self raisedToInteger: exponent ].\n    self < 0 ifTrue: [ self error: 'A negative base requires an integer exponent.' ].\n    self = 0 ifTrue: [\n        exponent > 0 ifTrue: [ ^ 0.0 ].\n        self error: 'Zero requires a positive exponent.' ].\n    ^ (self asFloat ln * exponent) exp","raisedToInteger:":"raisedToInteger: exponent\n    | power factor result invertResult |\n    (exponent isKindOf: Integer) ifFalse: [ self error: 'Expected an integer exponent.' ].\n    power := exponent abs.\n    factor := self.\n    invertResult := exponent < 0.\n    (invertResult and: [ self isKindOf: Float ]) ifTrue: [\n        factor := self reciprocal.\n        invertResult := false ].\n    result := self * 0 + 1.\n    [ power > 0 ] whileTrue: [\n        power odd ifTrue: [ result := result * factor ].\n        power := power // 2.\n        power > 0 ifTrue: [ factor := factor squared ] ].\n    invertResult ifTrue: [ ^ result reciprocal ].\n    ^ result","reciprocal":"reciprocal\n    ^ 1 / self","rem:":"rem: divisor\n    (((self isKindOf: Float) or: [ divisor isKindOf: Float ]) and: [ divisor ~= 0 ]) ifTrue: [\n        ^ self asFloat _floatRem: divisor ].\n    ^ self - ((self quo: divisor) * divisor)","roundTo:":"roundTo: factor\n    | quotient convertedFactor exactFactor |\n    ((self isKindOf: Float) or: [ factor isKindOf: Float ]) ifTrue: [\n        convertedFactor := factor asFloat.\n        convertedFactor = 0 ifTrue: [ ^ (self / factor) rounded * convertedFactor ].\n        exactFactor := convertedFactor asFraction.\n        quotient := (self asFloat asFraction / exactFactor) rounded.\n        quotient = 0 ifTrue: [ ^ 0.0 * convertedFactor ].\n        ^ (quotient * exactFactor) asFloat ].\n    ^ (self asFraction / factor asFraction) rounded * (self _coerceRoundingFactor: factor)","sign":"sign\n    self < 0 ifTrue: [ ^ -1 ].\n    self > 0 ifTrue: [ ^ 1 ].\n    ^ 0","strictlyPositive":"strictlyPositive\n    ^ self > 0","to:":"to: stop\n    ^ Interval from: self to: stop","to:by:":"to: stop by: step\n    ^ Interval from: self to: stop by: step","truncateTo:":"truncateTo: factor\n    | quotient convertedFactor |\n    quotient := self quo: factor.\n    ((self isKindOf: Float) or: [ factor isKindOf: Float ]) ifTrue: [\n        convertedFactor := factor asFloat.\n        quotient = 0 ifTrue: [ ^ 0.0 * convertedFactor ].\n        ^ (quotient * convertedFactor asFraction) asFloat ].\n    ^ quotient * (self _coerceRoundingFactor: factor)"},"Object":{"doesNotUnderstand:":"doesNotUnderstand: message\n    ^ (MessageNotUnderstood new receiver: self message: message) signal","error:":"error: aString\n    ^ Error signal: aString","initialize":"initialize\n    ^ self","isKindOf:":"isKindOf: candidate\n    | type |\n    type := self class.\n    [ type notNil ] whileTrue: [\n        type == candidate ifTrue: [ ^ true ].\n        type := type superclass ].\n    ^ false","isMemberOf:":"isMemberOf: candidate\n    ^ self class == candidate","printOn:":"printOn: target\n    target nextPutAll: self printString"},"ObjectInspectorWindow":{"initialize":"initialize\n    super initialize.\n    identifier := 'objectInspector'.\n    self title: 'Object Inspector';\n        minimumWidth: 380 height: 250;\n        resizeWidth: 540 height: 440"},"OrderedCollection":{",":", other\n    ^ self copy addAll: other; yourself","_checkIndex:":"_checkIndex: index\n    ((index isKindOf: Integer) and: [ index between: 1 and: tally ])\n        ifFalse: [ self error: 'Index outside collection.' ]","_checkInsertionIndex:":"_checkInsertionIndex: index\n    ((index isKindOf: Integer) and: [ index between: 1 and: tally + 1 ])\n        ifFalse: [ self error: 'Insertion index outside collection.' ]","_makeRoomFor:":"_makeRoomFor: additional\n    | required preferred |\n    required := tally + additional.\n    required <= storage size ifTrue: [ ^ self ].\n    preferred := ((storage size * 2) max: 4) min: 65535.\n    self _reserve: (required max: preferred)","_positionOf:":"_positionOf: target\n    ^ self indexOf: target ifAbsent: [ self error: 'Element not found.' ]","_reserve:":"_reserve: capacity\n    | replacement |\n    ((capacity isKindOf: Integer) and: [ capacity >= 0 ])\n        ifFalse: [ self error: 'Capacity must be a nonnegative integer.' ].\n    capacity <= storage size ifTrue: [ ^ self ].\n    replacement := Array new: capacity.\n    1 to: tally do: [ :index | replacement at: index put: (storage at: index) ].\n    storage := replacement","_sequenceFrom:":"_sequenceFrom: elements\n    ^ self class withAll: elements","add:":"add: element\n    ^ self addLast: element","add:after:":"add: element after: target\n    ^ self add: element afterIndex: (self _positionOf: target)","add:afterIndex:":"add: element afterIndex: index\n    ^ self add: element beforeIndex: index + 1","add:before:":"add: element before: target\n    ^ self add: element beforeIndex: (self _positionOf: target)","add:beforeIndex:":"add: element beforeIndex: index\n    self _checkInsertionIndex: index.\n    self _makeRoomFor: 1.\n    self _spliceAt: index remove: 0 with: (Array with: element).\n    ^ element","addAll:":"addAll: additions\n    (self _tryAddAll: additions) ifFalse: [\n        additions do: [ :each | self add: each ] ].\n    ^ additions","addAll:after:":"addAll: additions after: target\n    ^ self addAll: additions afterIndex: (self _positionOf: target)","addAll:afterIndex:":"addAll: additions afterIndex: index\n    ^ self addAll: additions beforeIndex: index + 1","addAll:before:":"addAll: additions before: target\n    ^ self addAll: additions beforeIndex: (self _positionOf: target)","addAll:beforeIndex:":"addAll: additions beforeIndex: index\n    | incoming width |\n    self _checkInsertionIndex: index.\n    incoming := additions asArray.\n    width := incoming size.\n    width = 0 ifTrue: [ ^ additions ].\n    self _makeRoomFor: width.\n    self _spliceAt: index remove: 0 with: incoming.\n    ^ additions","addAllFirst:":"addAllFirst: additions\n    ^ self addAll: additions beforeIndex: 1","addAllLast:":"addAllLast: additions\n    ^ self addAll: additions beforeIndex: tally + 1","addFirst:":"addFirst: element\n    ^ self add: element beforeIndex: 1","addLast:":"addLast: element\n    ^ self add: element beforeIndex: tally + 1","asArray":"asArray\n    ^ storage copyFrom: 1 to: tally","at:":"at: index\n    self _checkIndex: index.\n    ^ storage at: index","at:put:":"at: index put: element\n    self _checkIndex: index.\n    ^ storage at: index put: element","atAll:put:":"atAll: indices put: element\n    | positions |\n    positions := Array withAll: indices.\n    positions do: [ :index | self _checkIndex: index ].\n    positions do: [ :index | self at: index put: element ]","atAllPut:":"atAllPut: element\n    1 to: self size do: [ :index | self at: index put: element ]","collect:":"collect: operation\n    ^ self class withAll: (self asArray collect: operation)","copy":"copy\n    ^ self class withAll: self","do:":"do: operation\n    self asArray do: operation","includes:":"includes: element\n    ^ (self indexOf: element) ~= 0","initialize":"initialize\n    storage := Array new: 0.\n    tally := 0","isEmpty":"isEmpty\n    ^ tally = 0","remove:":"remove: element\n    ^ self remove: element ifAbsent: [ self error: 'Element not found.' ]","remove:ifAbsent:":"remove: element ifAbsent: alternative\n    | index |\n    index := self indexOf: element.\n    index = 0 ifTrue: [ ^ alternative value ].\n    ^ self removeAtIndex: index","removeAll:":"removeAll: removals\n    removals do: [ :each | self remove: each ].\n    ^ removals","removeAtIndex:":"removeAtIndex: index\n    | removed |\n    self _checkIndex: index.\n    removed := storage at: index.\n    self _spliceAt: index remove: 1 with: #().\n    ^ removed","removeFirst":"removeFirst\n    ^ self removeAtIndex: 1","removeLast":"removeLast\n    ^ self removeAtIndex: tally","replaceFrom:to:with:":"replaceFrom: start to: stop with: replacement\n    replacement size = (stop - start + 1) ifFalse: [ self error: 'The replacement has the wrong size.' ].\n    stop < start ifTrue: [\n        self _checkIndex: start.\n        self _checkIndex: stop.\n        ^ self ].\n    ^ self replaceFrom: start to: stop with: replacement startingAt: 1","replaceFrom:to:with:startingAt:":"replaceFrom: start to: stop with: replacement startingAt: offset\n    | copy |\n    self _checkIndex: start.\n    self _checkIndex: stop.\n    copy := storage copy.\n    copy replaceFrom: start to: stop with: replacement startingAt: offset.\n    storage := copy.\n    ^ self","replaceFrom:to:withObject:":"replaceFrom: start to: stop withObject: element\n    | copy |\n    self _checkIndex: start.\n    self _checkIndex: stop.\n    copy := storage copy.\n    copy replaceFrom: start to: stop withObject: element.\n    storage := copy.\n    ^ self","select:":"select: predicate\n    ^ self class withAll: (self asArray select: predicate)","size":"size\n    ^ tally"},"ReadFileStream":{"atEnd":"atEnd\n    ^ self _fileAtEnd","do:":"do: operation\n    | element |\n    [ (element := self next) notNil ] whileTrue: [ operation value: element ]","next":"next\n    ^ self _readFileElement","next:":"next: amount\n    ^ self _readFileElements: amount","nextLine":"nextLine\n    | result |\n    self isText ifFalse: [ self error: 'A binary file stream has no text lines.' ].\n    result := self _scanFileUntil: (Array with: Character cr with: Character lf) collecting: true.\n    ((result at: 2) = Character cr and: [ self peekFor: Character lf ])\n        ifTrue: [ self next ].\n    ^ result at: 1","nextMatchFor:":"nextMatchFor: element\n    | next |\n    next := self next.\n    ^ next notNil and: [ next = element ]","peek":"peek\n    ^ self _peekFileElement","peekFor:":"peekFor: element\n    | next |\n    next := self peek.\n    ^ next notNil and: [ next = element ]","skip:":"skip: count\n    self _skipFileElements: count","skipTo:":"skipTo: element\n    ^ ((self _scanFileUntil: (Array with: element) collecting: false) at: 2) notNil","upTo:":"upTo: element\n    ^ (self _scanFileUntil: (Array with: element) collecting: true) at: 1"},"ReadStream":{"_endAfter:":"_endAfter: count\n    ((count isKindOf: Integer) and: [ count >= 0 ])\n        ifFalse: [ self error: 'The count must be a nonnegative integer.' ].\n    ^ (cursor + count) min: self _size","_findNext:":"_findNext: predicate\n    | sequence |\n    sequence := self _sequence.\n    cursor + 1 to: sequence size do: [ :index |\n        (predicate value: (sequence at: index)) ifTrue: [ ^ index ] ].\n    ^ nil","atEnd":"atEnd\n    ^ cursor >= self _size","do:":"do: operation\n    [ self atEnd ] whileFalse: [ operation value: self next ]","next":"next\n    | element |\n    self atEnd ifTrue: [ ^ nil ].\n    element := self _sequence at: cursor + 1.\n    cursor := cursor + 1.\n    ^ element","next:":"next: count\n    | stop result |\n    stop := self _endAfter: count.\n    result := self _sliceFrom: cursor + 1 to: stop.\n    cursor := stop.\n    ^ result","nextLine":"nextLine\n    | sequence terminator stop result |\n    sequence := self _sequence.\n    terminator := self _findNext: [ :each | each = Character lf or: [ each = Character cr ] ].\n    stop := terminator isNil ifTrue: [ sequence size ] ifFalse: [ terminator - 1 ].\n    result := cursor = stop\n        ifTrue: [ String new: 0 ]\n        ifFalse: [ String withAll: (sequence copyFrom: cursor + 1 to: stop) ].\n    cursor := terminator ifNil: [ sequence size ].\n    terminator notNil ifTrue: [\n        ((sequence at: terminator) = Character cr and: [\n            cursor < sequence size and: [ (sequence at: cursor + 1) = Character lf ] ])\n                ifTrue: [ cursor := cursor + 1 ] ].\n    ^ result","nextMatchFor:":"nextMatchFor: element\n    self atEnd ifTrue: [ ^ false ].\n    ^ self next = element","peek":"peek\n    self atEnd ifTrue: [ ^ nil ].\n    ^ self _sequence at: cursor + 1","peekFor:":"peekFor: element\n    self atEnd ifTrue: [ ^ false ].\n    ^ self peek = element","skip:":"skip: count\n    cursor := self _endAfter: count","skipTo:":"skipTo: element\n    | match |\n    match := self _findNext: [ :each | each = element ].\n    cursor := match ifNil: [ self _size ].\n    ^ match notNil","upTo:":"upTo: element\n    | match result |\n    match := self _findNext: [ :each | each = element ].\n    result := self _sliceFrom: cursor + 1 to: (match isNil ifTrue: [ self _size ] ifFalse: [ match - 1 ]).\n    cursor := match ifNil: [ self _size ].\n    ^ result"},"ReadWriteStream":{"cr":"cr\n    self nextPut: Character lf","flush":"flush\n    self _sequence","nextPut:":"nextPut: element\n    self _write: (Array with: element).\n    ^ element","nextPutAll:":"nextPutAll: elements\n    | batch |\n    batch := self _nextPutAllBatch: elements.\n    batch isNil\n        ifTrue: [ elements do: [ :each | self nextPut: each ] ]\n        ifFalse: [ self _write: batch ]","space":"space\n    self nextPut: Character space","tab":"tab\n    self nextPut: Character tab"},"STCompiler":{"advance":"advance\n    current := lookahead.\n    lookahead := scanner nextToken","arrayElement":"arrayElement\n    | kind payload |\n    kind := self kind.\n    kind = #unsupportedNumber ifTrue: [ ^ self fail: self tokenValue ].\n    kind = #float ifTrue: [\n        payload := self floatFrom: self tokenValue.\n        self advance.\n        ^ payload ].\n    (#(integer scaledDecimal string symbol identifier keyword character) includes: kind) ifTrue: [\n        payload := self tokenValue.\n        self advance.\n        kind = #identifier ifTrue: [\n            payload = 'nil' ifTrue: [ ^ nil ].\n            payload = 'true' ifTrue: [ ^ true ].\n            payload = 'false' ifTrue: [ ^ false ] ].\n        (#(symbol identifier keyword) includes: kind) ifTrue: [ ^ payload asSymbol ].\n        kind = #character ifTrue: [ ^ payload asCharacter ].\n        ^ payload ].\n    (kind = #binary and: [ self tokenValue = '-' ]) ifTrue: [ ^ self negativeNumber ].\n    (#(leftParen arrayStart) includes: kind) ifTrue: [ self advance. ^ self arrayElements ].\n    self fail: 'Expected a literal or ) in the array.'","arrayElements":"arrayElements\n    | elements |\n    elements := STCompilerList new.\n    [ self kind ~= #rightParen ] whileTrue: [ elements add: self arrayElement ].\n    self advance.\n    ^ elements elements","binaryExpression":"binaryExpression\n    | receiver |\n    receiver := self unaryExpression.\n    [ #(binary bar) includes: self kind ] whileTrue: [\n        receiver := self sendTo: receiver message: self binaryMessage ].\n    ^ receiver","binaryMessage":"binaryMessage\n    | selector |\n    selector := self tokenValue.\n    self advance.\n    ^ self pair: selector with: (self single: self unaryExpression)","blockAt:":"blockAt: position\n    | parameters body |\n    self advance.\n    parameters := STCompilerList new.\n    [ self kind = #colon ] whileTrue: [\n        self advance.\n        parameters add: self identifier ].\n    parameters := parameters elements.\n    parameters isEmpty ifFalse: [\n        (self kind = #binary and: [ self tokenValue = '||' ])\n            ifTrue: [ current at: 1 put: #bar; at: 3 put: (current at: 3) + 1; at: 4 put: '|' ]\n            ifFalse: [ self expect: #bar ] ].\n    self validateNames: parameters.\n    body := self bodyUntil: #rightBracket.\n    self validate: parameters separateFrom: (body at: 1) error: 'A block argument is also declared as a local variable.'.\n    self expect: #rightBracket.\n    ^ self node: #block at: position with: parameters with: body","bodyUntil:":"bodyUntil: terminator\n    | temporaries expressions returning |\n    temporaries := STCompilerList new.\n    (self kind = #binary and: [ self tokenValue = '||' ]) ifTrue: [ self advance ] ifFalse: [\n        self kind = #bar ifTrue: [\n            self advance.\n            [ self kind = #identifier ] whileTrue: [ temporaries add: self identifier ].\n            self expect: #bar ] ].\n    temporaries := temporaries elements.\n    self validateNames: temporaries.\n    expressions := STCompilerList new.\n    [ self kind ~= terminator and: [ self kind ~= #end ] ] whileTrue: [\n        returning := self kind = #caret.\n        expressions add: (returning ifTrue: [ self returnStatement ] ifFalse: [ self expression ]).\n        self kind = #period ifTrue: [ self advance ] ifFalse: [\n            self kind = terminator ifFalse: [ self fail: 'Expected a period between expressions.' ] ].\n        (returning and: [ self kind ~= terminator and: [ self kind ~= #end ] ]) ifTrue: [\n            self fail: 'A return must be the last statement.' ] ].\n    ^ self pair: temporaries with: expressions elements","cascadeBranch":"cascadeBranch\n    | messages firstKind |\n    messages := STCompilerList new.\n    firstKind := self kind.\n    messages add: self cascadeMessage.\n    firstKind = #identifier ifTrue: [\n        [ self kind = #identifier ] whileTrue: [ messages add: self unaryMessage ] ].\n    firstKind ~= #keyword ifTrue: [\n        [ #(binary bar) includes: self kind ] whileTrue: [ messages add: self binaryMessage ].\n        self kind = #keyword ifTrue: [ messages add: self keywordMessage ] ].\n    ^ messages elements","cascadeMessage":"cascadeMessage\n    self kind = #identifier ifTrue: [ ^ self unaryMessage ].\n    (#(binary bar) includes: self kind) ifTrue: [ ^ self binaryMessage ].\n    self kind = #keyword ifTrue: [ ^ self keywordMessage ].\n    self fail: 'Expected a message after ;.'","expect:":"expect: kind\n    self kind = kind ifFalse: [ self fail: (self tokenLabel: kind) , ' expected, found: ' , (self tokenLabel: self kind) , '.' ].\n    self advance","expression":"expression\n    | result |\n    expressionDepth := expressionDepth + 1.\n    expressionDepth > 128 ifTrue: [ self fail: 'Expression is nested too deeply.' ].\n    result := self expressionNode.\n    expressionDepth := expressionDepth - 1.\n    ^ result","expressionNode":"expressionNode\n    | position name first messages |\n    position := current.\n    (self kind = #identifier and: [ (lookahead at: 1) = #assign ]) ifTrue: [\n        name := self identifier.\n        self advance.\n        ^ self node: #assignment at: position with: name with: self expression ].\n    first := self keywordExpression.\n    self kind = #semicolon ifFalse: [ ^ first ].\n    (first at: 1) = #send ifFalse: [ self fail: 'A cascade must follow a message.' ].\n    messages := STCompilerList new.\n    messages add: (self single: (first at: 5)).\n    [ self kind = #semicolon ] whileTrue: [\n        self advance.\n        messages add: self cascadeBranch ].\n    ^ self node: #cascadeBranches at: position with: (first at: 4) with: messages elements","fail:":"fail: message\n    self error: message line: (current at: 2) column: (current at: 3)","floatFrom:":"floatFrom: spelling\n    | result |\n    result := spelling parseFloatOrNil.\n    result isNil ifTrue: [ ^ self fail: 'Floating-point literal is outside the supported range.' ].\n    ^ result","identifier":"identifier\n    | name |\n    self kind = #identifier ifFalse: [ self fail: 'Expected a variable name.' ].\n    name := self tokenValue.\n    self advance.\n    ^ name","initialize":"initialize\n    ^ self","keywordExpression":"keywordExpression\n    | receiver |\n    receiver := self binaryExpression.\n    self kind = #keyword ifFalse: [ ^ receiver ].\n    ^ self sendTo: receiver message: self keywordMessage","keywordMessage":"keywordMessage\n    | selector arguments |\n    selector := ''.\n    arguments := STCompilerList new.\n    [ self kind = #keyword ] whileTrue: [\n        selector := selector , self tokenValue.\n        self advance.\n        arguments add: self binaryExpression ].\n    ^ self pair: selector with: arguments elements","kind":"kind\n    ^ current at: 1","method:":"method: input\n    | selector parameters body kind |\n    self start: input.\n    parameters := STCompilerList new.\n    kind := self kind.\n    kind = #identifier ifTrue: [ selector := self identifier ].\n    (#(binary bar) includes: kind) ifTrue: [\n        selector := self tokenValue.\n        self advance.\n        parameters add: self identifier ].\n    kind = #keyword ifTrue: [\n        selector := ''.\n        [ self kind = #keyword ] whileTrue: [\n            selector := selector , self tokenValue.\n            self advance.\n            parameters add: self identifier ] ].\n    selector isNil ifTrue: [ self fail: 'Expected a method header such as increment or add: amount.' ].\n    parameters := parameters elements.\n    self validateNames: parameters.\n    body := self workspaceBody.\n    self validate: parameters separateFrom: (body at: 1) error: 'An argument and a local variable have the same name.'.\n    ^ self triple: selector with: parameters with: body","negativeNumber":"negativeNumber\n    | number |\n    self advance.\n    self kind = #unsupportedNumber ifTrue: [ ^ self fail: self tokenValue ].\n    self kind = #float ifTrue: [\n        number := self floatFrom: self tokenValue.\n        self advance.\n        ^ number negated ].\n    (#(integer scaledDecimal) includes: self kind) ifFalse: [ self fail: 'Expected a number after -.' ].\n    number := self tokenValue.\n    self advance.\n    ^ number negated","node:at:with:with:":"node: tag at: position with: first with: second\n    | node |\n    node := Array new: 5.\n    node at: 1 put: tag; at: 2 put: (position at: 2); at: 3 put: (position at: 3).\n    node at: 4 put: first; at: 5 put: second.\n    ^ node","pair:with:":"pair: first with: second\n    | result |\n    result := Array new: 2.\n    result at: 1 put: first; at: 2 put: second.\n    ^ result","primary":"primary\n    | position kind payload node |\n    position := current.\n    kind := self kind.\n    kind = #unsupportedNumber ifTrue: [ ^ self fail: self tokenValue ].\n    kind = #float ifTrue: [\n        payload := self floatFrom: self tokenValue.\n        self advance.\n        ^ self node: #literal at: position with: payload with: nil ].\n    (#(integer scaledDecimal string symbol identifier character) includes: kind) ifTrue: [\n        payload := self tokenValue.\n        self advance.\n        kind = #identifier ifTrue: [ ^ self node: #variable at: position with: payload with: nil ].\n        kind = #symbol ifTrue: [ payload := payload asSymbol ].\n        kind = #character ifTrue: [ payload := payload asCharacter ].\n        ^ self node: #literal at: position with: payload with: nil ].\n    (kind = #binary and: [ self tokenValue = '-' ]) ifTrue: [\n        ^ self node: #literal at: position with: self negativeNumber with: nil ].\n    kind = #leftParen ifTrue: [\n        self advance.\n        node := self expression.\n        self expect: #rightParen.\n        ^ node ].\n    kind = #leftBracket ifTrue: [ ^ self blockAt: position ].\n    kind = #arrayStart ifTrue: [\n        self advance.\n        ^ self node: #literal at: position with: self arrayElements with: nil ].\n    self fail: 'Expected an expression.'","returnStatement":"returnStatement\n    | position |\n    position := current.\n    self advance.\n    ^ self node: #returnValue at: position with: self expression with: nil","sendTo:message:":"sendTo: receiver message: message\n    ^ self node: #send at: receiver with: receiver with: message","single:":"single: first\n    | result |\n    result := Array new: 1.\n    result at: 1 put: first.\n    ^ result","start:":"start: input\n    expressionDepth := 0.\n    scanner := STScanner new.\n    scanner source: input.\n    current := scanner nextToken.\n    lookahead := scanner nextToken","tokenLabel:":"tokenLabel: kind\n    kind = #end ifTrue: [ ^ 'end of source' ].\n    kind = #rightBracket ifTrue: [ ^ ']' ].\n    kind = #rightParen ifTrue: [ ^ ')' ].\n    kind = #bar ifTrue: [ ^ '|' ].\n    kind = #period ifTrue: [ ^ '.' ].\n    ^ kind asString","tokenValue":"tokenValue\n    ^ current at: 4","triple:with:with:":"triple: first with: second with: third\n    | result |\n    result := Array new: 3.\n    result at: 1 put: first; at: 2 put: second; at: 3 put: third.\n    ^ result","unaryExpression":"unaryExpression\n    | receiver |\n    receiver := self primary.\n    [ self kind = #identifier ] whileTrue: [\n        receiver := self sendTo: receiver message: self unaryMessage ].\n    ^ receiver","unaryMessage":"unaryMessage\n    ^ self pair: self identifier with: #()","validate:separateFrom:error:":"validate: names separateFrom: locals error: message\n    names do: [ :name | (locals includes: name) ifTrue: [ self fail: message ] ]","validateNames:":"validateNames: names\n    names do: [ :name |\n        (#('self' 'super' 'true' 'false' 'nil') includes: name) ifTrue: [\n            self fail: 'A pseudo-variable cannot be declared.' ] ].\n    1 to: names size do: [ :index |\n        1 to: index - 1 do: [ :earlier |\n            (names at: index) = (names at: earlier) ifTrue: [\n                self fail: 'Duplicate variable declaration.' ] ] ]","workspace:":"workspace: input\n    self start: input.\n    ^ self workspaceBody","workspaceBody":"workspaceBody\n    | body |\n    body := self bodyUntil: #end.\n    self expect: #end.\n    ^ body"},"STCompilerList":{"add:":"add: element\n    | grown |\n    count = storage size ifTrue: [\n        grown := Array new: storage size * 2.\n        1 to: count do: [ :each | grown at: each put: (storage at: each) ].\n        storage := grown ].\n    count := count + 1.\n    storage at: count put: element","elements":"elements\n    | result |\n    result := Array new: count.\n    1 to: count do: [ :each | result at: each put: (storage at: each) ].\n    ^ result","initialize":"initialize\n    storage := Array new: 8.\n    count := 0","joinedString":"joinedString\n    ^ storage joinedStringFrom: 1 to: count"},"STScanner":{"advance":"advance\n    (self peek isLineBreak) ifTrue: [\n        line := line + 1. column := 1\n    ] ifFalse: [ column := column + 1 ].\n    offset := offset + 1","fail:":"fail: message\n    self error: message line: tokenLine column: tokenColumn","initialize":"initialize\n    offset := 1.\n    line := 1.\n    column := 1.\n    nesting := 0","integerToken:radix:":"integerToken: digits radix: radix\n    | number |\n    number := digits parseIntegerMagnitudeRadix: radix.\n    number isNil ifTrue: [ ^ self fail: 'Invalid digits for the integer radix.' ].\n    ^ self token: #integer value: number","isBinary:":"isBinary: character\n    ^ character notNil and: [ character size = 1 and: [\n        '+-*/\\~<>=@%,&?!|' includes: character asCharacter ] ]","isIdentifierPart:":"isIdentifierPart: character\n    ^ (self isIdentifierStart: character) or: [ character notNil and: [ character isNumber ] ]","isIdentifierStart:":"isIdentifierStart: character\n    ^ character notNil and: [ character isLetter or: [ character = '_' ] ]","nextToken":"nextToken\n    self skipTrivia.\n    ^ self readToken","peek":"peek\n    ^ self peekAhead: 0","peekAhead:":"peekAhead: delta\n    | index |\n    index := offset + delta.\n    index > characters size ifTrue: [ ^ nil ].\n    ^ characters at: index","readComment":"readComment\n    self advance.\n    [ self peek notNil and: [ self peek ~= '\"' ] ] whileTrue: [ self advance ].\n    self peek isNil ifTrue: [ ^ self fail: 'Unterminated comment.' ].\n    self advance","readDigits":"readDigits\n    [ self peek notNil and: [ self peek isASCIIDigit ] ] whileTrue: [ self advance ]","readIdentifier":"readIdentifier\n    | start |\n    start := offset.\n    [ self isIdentifierPart: self peek ] whileTrue: [ self advance ].\n    ^ characters joinedStringFrom: start to: offset - 1","readNumber":"readNumber\n    | start digits next hasFraction |\n    start := offset.\n    self readDigits.\n    digits := characters joinedStringFrom: start to: offset - 1.\n    self peek = 'r' ifTrue: [ ^ self readRadixInteger: digits ].\n    next := self peekAhead: 1.\n    hasFraction := self peek = '.' and: [ next notNil and: [ next isASCIIDigit ] ].\n    hasFraction ifTrue: [ self advance. self readDigits ].\n    self peek = 's' ifTrue: [\n        self advance. self readDigits.\n        digits := characters joinedStringFrom: start to: offset - 1.\n        digits := digits parseScaledDecimalOrNil.\n        digits isNil ifTrue: [\n            ^ self token: #unsupportedNumber value: 'Invalid or out-of-range scaled decimal literal.' ].\n        ^ self token: #scaledDecimal value: digits ].\n    hasFraction ifTrue: [\n        (#('e' 'd' 'q') includes: self peek) ifTrue: [\n            self advance.\n            self peek = '-' ifTrue: [ self advance ].\n            (self peek notNil and: [ self peek isASCIIDigit ]) ifFalse: [ ^ self fail: 'Expected a floating-point exponent.' ].\n            self readDigits ].\n        digits := characters joinedStringFrom: start to: offset - 1.\n        ^ self token: #float value: digits ].\n    ^ self integerToken: digits radix: 10","readRadixInteger:":"readRadixInteger: prefix\n    | radix start |\n    radix := prefix asIntegerOrNil.\n    (radix notNil and: [ radix >= 2 and: [ radix <= 36 ] ]) ifFalse: [\n        ^ self fail: 'Integer radix must be between 2 and 36.' ].\n    self advance.\n    start := offset.\n    [ self isIdentifierPart: self peek ] whileTrue: [ self advance ].\n    ^ self integerToken: (characters joinedStringFrom: start to: offset - 1) radix: radix","readString":"readString\n    | pieces start |\n    start := offset.\n    pieces := nil.\n    [ self peek notNil ] whileTrue: [\n        self peek = '''' ifTrue: [\n            self advance.\n            self peek = '''' ifFalse: [\n                pieces isNil ifTrue: [ ^ characters joinedStringFrom: start to: offset - 2 ].\n                pieces add: (characters joinedStringFrom: start to: offset - 2).\n                ^ pieces joinedString ].\n            pieces isNil ifTrue: [ pieces := STCompilerList new ].\n            pieces add: (characters joinedStringFrom: start to: offset - 1).\n            self advance.\n            start := offset\n        ] ifFalse: [ self advance ] ].\n    ^ self fail: 'Unterminated string.'","readSymbol":"readSymbol\n    | start more |\n    self peek = '(' ifTrue: [ self advance. ^ self token: #arrayStart value: nil ].\n    self peek = '''' ifTrue: [ self advance. ^ self token: #symbol value: self readString ].\n    start := offset.\n    (self isIdentifierStart: self peek) ifTrue: [\n        [ self isIdentifierPart: self peek ] whileTrue: [ self advance ].\n        more := true.\n        [ more and: [ self peek = ':' ] ] whileTrue: [\n            self advance.\n            more := self isIdentifierStart: self peek.\n            more ifTrue: [\n                [ self isIdentifierPart: self peek ] whileTrue: [ self advance ] ] ].\n        ^ self token: #symbol value: (characters joinedStringFrom: start to: offset - 1) ].\n    (self isBinary: self peek) ifTrue: [\n        [ self isBinary: self peek ] whileTrue: [ self advance ].\n        ^ self token: #symbol value: (characters joinedStringFrom: start to: offset - 1) ].\n    ^ self fail: 'Expected a symbol or ( after #.'","readToken":"readToken\n    | character start |\n    tokenLine := line. tokenColumn := column.\n    character := self peek.\n    character isNil ifTrue: [ ^ self token: #end value: nil ].\n    character isASCIIDigit ifTrue: [ ^ self readNumber ].\n    (self isIdentifierStart: character) ifTrue: [ ^ self readWord ].\n    start := offset.\n    self advance.\n    character = '''' ifTrue: [ ^ self token: #string value: self readString ].\n    character = '#' ifTrue: [ ^ self readSymbol ].\n    character = '$' ifTrue: [\n        character := self peek.\n        character isNil ifTrue: [ ^ self fail: 'Expected a character after $.' ].\n        (character size > 1 and: [ character isLineBreak ]) ifTrue: [ character := (13 asCharacter) asString ].\n        self advance.\n        ^ self token: #character value: character ].\n    character = ':' ifTrue: [\n        self peek = '=' ifTrue: [ self advance. ^ self token: #assign value: nil ].\n        ^ self token: #colon value: nil ].\n    character = '.' ifTrue: [ ^ self token: #period value: nil ].\n    character = ';' ifTrue: [ ^ self token: #semicolon value: nil ].\n    character = '^' ifTrue: [ ^ self token: #caret value: nil ].\n    (character = '|' and: [ (self isBinary: self peek) not ]) ifTrue: [ ^ self token: #bar value: '|' ].\n    character = '(' ifTrue: [ ^ self token: #leftParen value: nil ].\n    character = ')' ifTrue: [ ^ self token: #rightParen value: nil ].\n    character = '[' ifTrue: [ ^ self token: #leftBracket value: nil ].\n    character = ']' ifTrue: [ ^ self token: #rightBracket value: nil ].\n    (self isBinary: character) ifTrue: [\n        [ self isBinary: self peek ] whileTrue: [ self advance ].\n        ^ self token: #binary value: (characters joinedStringFrom: start to: offset - 1) ].\n    ^ self fail: 'Unknown character: ' , character","readWord":"readWord\n    | name |\n    name := self readIdentifier.\n    (self peek = ':' and: [ (self peekAhead: 1) ~= '=' ]) ifTrue: [\n        self advance.\n        ^ self token: #keyword value: (name , ':') ].\n    ^ self token: #identifier value: name","skipTrivia":"skipTrivia\n    | character |\n    [ character := self peek.\n      character notNil and: [ character isWhitespace or: [ character = '\"' ] ] ] whileTrue: [\n        character = '\"' ifTrue: [\n            tokenLine := line. tokenColumn := column.\n            self readComment\n        ] ifFalse: [ self advance ] ]","source:":"source: aString\n    characters := aString characters","token:value:":"token: kind value: payload\n    | token |\n    (#(leftParen leftBracket arrayStart) includes: kind) ifTrue: [\n        nesting := nesting + 1.\n        nesting > 32 ifTrue: [ self fail: 'Source code exceeds the nesting limit of 32 levels.' ] ].\n    (#(rightParen rightBracket) includes: kind) ifTrue: [ nesting := nesting - 1 ].\n    token := Array new: 4.\n    token at: 1 put: kind; at: 2 put: tokenLine; at: 3 put: tokenColumn; at: 4 put: payload.\n    ^ token"},"STSourceScanner":{"fail:":"fail: message\n    ^ nil","highlight:":"highlight: kind\n    | span |\n    span := Array new: 3.\n    span at: 1 put: kind; at: 2 put: tokenStart; at: 3 put: offset.\n    ^ span","nextHighlight":"nextHighlight\n    | span |\n    [ self peek notNil ] whileTrue: [\n        tokenStart := offset.\n        self peek isWhitespace\n            ifTrue: [ self advance ]\n            ifFalse: [\n                span := self peek = '\"'\n                    ifTrue: [ self readComment. self highlight: #comment ]\n                    ifFalse: [ self readToken ].\n                span notNil ifTrue: [ ^ span ] ] ].\n    ^ nil","token:value:":"token: kind value: value\n    (#(string symbol arrayStart character) includes: kind) ifTrue: [ ^ self highlight: #literal ].\n    (#(assign caret integer scaledDecimal float unsupportedNumber) includes: kind) ifTrue: [ ^ self highlight: #language ].\n    (kind = #identifier and: [ #('self' 'super' 'nil' 'true' 'false') includes: value ])\n        ifTrue: [ ^ self highlight: #language ].\n    ^ nil"},"ScaledDecimal":{"sqrt":"sqrt ^ self _exactSqrt","to:by:do:":"to: stop by: step do: operation\n    (self to: stop by: step) do: operation","to:do:":"to: stop do: operation\n    (self to: stop) do: operation"},"SequenceableCollection":{"_sequenceFrom:":"_sequenceFrom: elements\n    ^ elements","after:":"after: target\n    ^ self at: (self indexOf: target ifAbsent: [ self error: 'Element not found.' ]) + 1","at:ifAbsent:":"at: index ifAbsent: alternative\n    (index < 1 or: [ index > self size ]) ifTrue: [ ^ alternative value ].\n    ^ self at: index","before:":"before: target\n    ^ self at: (self indexOf: target ifAbsent: [ self error: 'Element not found.' ]) - 1","copyFrom:to:":"copyFrom: start to: stop\n    ^ self _sequenceFrom: (self asArray copyFrom: start to: stop)","copyReplaceAll:with:":"copyReplaceAll: target with: replacements\n    | matches width count next last index result position cursor |\n    width := target size.\n    width = 0 ifTrue: [ ^ self copy ].\n    matches := Array new: self size // width.\n    count := 0.\n    next := 1.\n    last := self size - width + 1.\n    [ next <= last and: [\n        index := self indexOfSubCollection: target startingAt: next.\n        index ~= 0 ] ] whileTrue: [\n        count := count + 1.\n        matches at: count put: index.\n        next := index + width ].\n    result := Array new: self size + (count * (replacements size - width)).\n    position := 1.\n    cursor := 1.\n    1 to: count do: [ :number |\n        index := matches at: number.\n        self from: cursor to: index - 1 do: [ :each | result at: position put: each. position := position + 1 ].\n        replacements do: [ :each | result at: position put: each. position := position + 1 ].\n        cursor := index + width ].\n    self from: cursor to: self size do: [ :each | result at: position put: each. position := position + 1 ].\n    ^ self _sequenceFrom: result","copyReplaceFrom:to:with:":"copyReplaceFrom: start to: stop with: replacements\n    | length result position |\n    length := self size.\n    (start < 1 or: [ stop < (start - 1) or: [ stop > length ] ])\n        ifTrue: [ self error: 'Invalid replacement range.' ].\n    result := Array new: length - (stop - start + 1) + replacements size.\n    position := 1.\n    self from: 1 to: start - 1 do: [ :each | result at: position put: each. position := position + 1 ].\n    replacements do: [ :each | result at: position put: each. position := position + 1 ].\n    self from: stop + 1 to: length do: [ :each | result at: position put: each. position := position + 1 ].\n    ^ self _sequenceFrom: result","copyReplaceFrom:to:withObject:":"copyReplaceFrom: start to: stop withObject: element\n    | count replacements |\n    count := (stop - start + 1) max: 1.\n    replacements := Array new: count.\n    replacements atAllPut: element.\n    ^ self copyReplaceFrom: start to: stop with: replacements","copyReplacing:withObject:":"copyReplacing: target withObject: replacement\n    ^ self _sequenceFrom: (self asArray collect: [ :each |\n        each = target ifTrue: [ replacement ] ifFalse: [ each ] ])","copyWith:":"copyWith: element\n    ^ self copyReplaceFrom: self size + 1 to: self size with: (Array with: element)","copyWithout:":"copyWithout: target\n    ^ self reject: [ :each | each = target ]","findFirst:":"findFirst: predicate\n    1 to: self size do: [ :index |\n        (predicate value: (self at: index)) ifTrue: [ ^ index ] ].\n    ^ 0","findLast:":"findLast: predicate\n    self size to: 1 by: -1 do: [ :index |\n        (predicate value: (self at: index)) ifTrue: [ ^ index ] ].\n    ^ 0","first":"first\n    ^ self at: 1","from:to:do:":"from: start to: stop do: operation\n    self from: start to: stop keysAndValuesDo: [ :index :element | operation value: element ]","from:to:keysAndValuesDo:":"from: start to: stop keysAndValuesDo: operation\n    (start < 1 or: [ stop > self size ]) ifTrue: [ self error: 'Invalid collection range.' ].\n    start to: stop do: [ :index | operation value: index value: (self at: index) ]","indexOf:":"indexOf: target\n    ^ self indexOf: target ifAbsent: [ 0 ]","indexOf:ifAbsent:":"indexOf: target ifAbsent: alternative\n    | index |\n    index := self findFirst: [ :each | each = target ].\n    index = 0 ifTrue: [ ^ alternative value ].\n    ^ index","indexOfSubCollection:startingAt:":"indexOfSubCollection: target startingAt: start\n    ^ self indexOfSubCollection: target startingAt: start ifAbsent: [ 0 ]","indexOfSubCollection:startingAt:ifAbsent:":"indexOfSubCollection: target startingAt: start ifAbsent: alternative\n    | length width last offset |\n    length := self size.\n    ((start isKindOf: Integer) and: [ start between: 1 and: length ])\n        ifFalse: [ self error: 'Search start is outside the collection.' ].\n    width := target size.\n    width = 0 ifTrue: [ ^ alternative value ].\n    last := length - width + 1.\n    start to: last do: [ :index |\n        offset := 1.\n        [ offset <= width and: [ (self at: index + offset - 1) = (target at: offset) ] ]\n            whileTrue: [ offset := offset + 1 ].\n        offset > width ifTrue: [ ^ index ] ].\n    ^ alternative value","keysAndValuesDo:":"keysAndValuesDo: operation\n    self from: 1 to: self size keysAndValuesDo: operation","last":"last\n    ^ self at: self size","reverse":"reverse\n    ^ self _sequenceFrom: self asArray reverse","reverseDo:":"reverseDo: operation\n    self size to: 1 by: -1 do: [ :index | operation value: (self at: index) ]","with:do:":"with: other do: operation\n    self size = other size ifFalse: [ self error: 'The collections must have equal size.' ].\n    self keysAndValuesDo: [ :index :element | operation value: element value: (other at: index) ]"},"Set":{"add:":"add: element\n    element isNil ifTrue: [ self error: 'A set element must be non-nil.' ].\n    (elements includes: element) ifFalse: [ elements addLast: element ].\n    ^ element"},"SettingsWindow":{"buildContent":"buildContent\n    ^ UIColumn new padding: 24;\n        add: (UILabel new identifier: 'settingsImageNote';\n            text: 'Windows and session state are stored in the Smalltalk image.'; yourself);\n        yourself","initialize":"initialize\n    super initialize.\n    identifier := 'settingsWindow'.\n    self title: 'Settings';\n        minimumWidth: 420 height: 96;\n        resizeWidth: 460 height: 112;\n        content: self buildContent"},"SortedCollection":{",":", other\n    ^ self copy addAll: other; yourself","_elements":"_elements\n    ^ state at: 2","_insertionIndexOf:":"_insertionIndexOf: element\n    | lower upper middle |\n    lower := 1.\n    upper := self size + 1.\n    [ lower < upper ] whileTrue: [\n        middle := (lower + upper) // 2.\n        (self sortBlock value: element value: (self at: middle))\n            ifTrue: [ upper := middle ] ifFalse: [ lower := middle + 1 ] ].\n    ^ lower","_reserve:":"_reserve: capacity\n    self _elements _reserve: capacity","_sequenceFrom:":"_sequenceFrom: collection\n    | result |\n    result := self class sortBlock: self sortBlock.\n    result class == SortedCollection ifTrue: [ ^ result _sortElementsFrom: collection ].\n    ^ result addAll: collection; yourself","_sortElementsFrom:":"_sortElementsFrom: elements\n    state at: 2 put: (self _sorted: (Array withAll: elements) by: self sortBlock).\n    ^ self","_sorted:by:":"_sorted: source by: comparator\n    | current target count width start middle stop left right position item swap |\n    count := source size.\n    count < 2 ifTrue: [ ^ OrderedCollection withAll: source ].\n    current := source.\n    target := Array new: count.\n    width := 1.\n    [ width < count ] whileTrue: [\n        start := 1.\n        [ start <= count ] whileTrue: [\n            middle := (start + width) min: count + 1.\n            stop := (start + (width * 2)) min: count + 1.\n            left := start.\n            right := middle.\n            position := start.\n            [ position < stop ] whileTrue: [\n                (left >= middle or: [\n                    right < stop and: [ comparator value: (current at: right) value: (current at: left) ] ])\n                    ifTrue: [ item := current at: right. right := right + 1 ]\n                    ifFalse: [ item := current at: left. left := left + 1 ].\n                target at: position put: item.\n                position := position + 1 ].\n            start := stop ].\n        swap := current.\n        current := target.\n        target := swap.\n        width := width * 2 ].\n    ^ OrderedCollection withAll: current","add:":"add: element\n    ^ self _elements add: element beforeIndex: (self _insertionIndexOf: element)","addAll:":"addAll: additions\n    additions do: [ :each | self add: each ].\n    ^ additions","asArray":"asArray\n    ^ self _elements asArray","asSortedCollection":"asSortedCollection\n    ^ self copy","at:":"at: index\n    ^ self _elements at: index","collect:":"collect: operation\n    ^ self _elements collect: operation","copy":"copy\n    ^ self _sequenceFrom: self","copyReplaceAll:with:":"copyReplaceAll: target with: replacements\n    | incoming |\n    incoming := Array withAll: replacements.\n    incoming size > 1 ifTrue: [ self _sorted: incoming copy by: self sortBlock ].\n    ^ super copyReplaceAll: target with: incoming","copyReplacing:withObject:":"copyReplacing: target withObject: replacement\n    | matched values |\n    matched := false.\n    values := self asArray collect: [ :each |\n        each = target ifTrue: [ matched := true. replacement ] ifFalse: [ each ] ].\n    matched ifFalse: [ self _insertionIndexOf: replacement ].\n    ^ self _sequenceFrom: values","do:":"do: operation\n    self _elements do: operation","includes:":"includes: element\n    ^ self _elements includes: element","initialize":"initialize\n    state := Array with: self class _defaultSortBlock with: OrderedCollection new","isEmpty":"isEmpty\n    ^ self _elements isEmpty","remove:":"remove: element\n    ^ self _elements remove: element","remove:ifAbsent:":"remove: element ifAbsent: alternative\n    ^ self _elements remove: element ifAbsent: alternative","removeAll:":"removeAll: removals\n    removals do: [ :each | self remove: each ].\n    ^ removals","removeAtIndex:":"removeAtIndex: index\n    ^ self _elements removeAtIndex: index","removeFirst":"removeFirst\n    ^ self _elements removeFirst","removeLast":"removeLast\n    ^ self _elements removeLast","reverse":"reverse\n    ^ self _elements reverse","select:":"select: predicate\n    ^ self _sequenceFrom: (self _elements select: predicate)","size":"size\n    ^ self _elements size","sortBlock":"sortBlock\n    ^ state at: 1","sortBlock:":"sortBlock: comparator\n    comparator argumentCount = 2 ifFalse: [ self error: 'Expected a two-argument sort block.' ].\n    state := Array with: comparator with: (self _sorted: self asArray by: comparator)"},"String":{"_sequenceFrom:":"_sequenceFrom: elements\n    ^ String withAll: elements","atAll:put:":"atAll: indices put: element\n    | copy positions |\n    (element isKindOf: Character) ifFalse: [ self error: 'A string element must be a character.' ].\n    self _hasPrimitiveAtPut ifFalse: [\n        positions := Array withAll: indices.\n        positions do: [ :index | self at: index ].\n        positions do: [ :index | self at: index put: element ].\n        ^ self ].\n    copy := self asArray.\n    copy atAll: indices put: element.\n    self _replaceCharacters: copy","atAllPut:":"atAllPut: element\n    (element isKindOf: Character) ifFalse: [ self error: 'A string element must be a character.' ].\n    self _hasPrimitiveAtPut ifFalse: [\n        1 to: self size do: [ :index | self at: index put: element ].\n        ^ self ].\n    self _replaceCharacters: ((Array new: self size) atAllPut: element; yourself)","collect:":"collect: operation\n    ^ self _sequenceFrom: (self asArray collect: operation)","isEmpty":"isEmpty\n    ^ self size = 0","replaceFrom:to:with:":"replaceFrom: start to: stop with: replacement\n    | copy |\n    copy := self asArray.\n    copy replaceFrom: start to: stop with: replacement.\n    self _replaceCharacters: copy.\n    ^ self","replaceFrom:to:with:startingAt:":"replaceFrom: start to: stop with: replacement startingAt: offset\n    | copy |\n    copy := self asArray.\n    copy replaceFrom: start to: stop with: replacement startingAt: offset.\n    self _replaceCharacters: copy.\n    ^ self","replaceFrom:to:withObject:":"replaceFrom: start to: stop withObject: element\n    | copy |\n    copy := self asArray.\n    copy replaceFrom: start to: stop withObject: element.\n    self _replaceCharacters: copy.\n    ^ self","select:":"select: predicate\n    ^ self _sequenceFrom: (self asArray select: predicate)","subStrings:":"subStrings: separators\n    | words characters start |\n    (separators allSatisfy: [ :element | element isKindOf: Character ])\n        ifFalse: [ self error: 'Substring separators must be characters.' ].\n    characters := self asArray.\n    words := Array new: 0.\n    start := 1.\n    self keysAndValuesDo: [ :index :element |\n        (separators includes: element) ifTrue: [\n            index > start ifTrue: [\n                words := words copyWith: (String withAll: (characters copyFrom: start to: index - 1)) ].\n            start := index + 1 ] ].\n    start <= characters size ifTrue: [\n        words := words copyWith: (String withAll: (characters copyFrom: start to: characters size)) ].\n    ^ words"},"Symbol":{",":", other\n    ^ self asString , other","_sequenceFrom:":"_sequenceFrom: elements\n    ^ (String withAll: elements) asSymbol","collect:":"collect: operation\n    ^ self _sequenceFrom: (self asArray collect: operation)","includes:":"includes: element\n    ^ (self indexOf: element) ~= 0","isEmpty":"isEmpty\n    ^ self size = 0","select:":"select: predicate\n    ^ self _sequenceFrom: (self asArray select: predicate)","subStrings:":"subStrings: separators\n    ^ self asString subStrings: separators"},"SystemWindow":{"activate":"activate\n    ^ Desktop activate: self","canClose":"canClose\n    ^ true","close":"close\n    ^ Desktop requestClose: self","frameApplied:x:y:width:height:":"frameApplied: aRevision x: newX y: newY width: newWidth height: newHeight\n    frameRevision = aRevision ifTrue: [ self observeX: newX y: newY width: newWidth height: newHeight ]","frameRevision":"frameRevision\n    ^ frameRevision","height":"height\n    ^ height","id":"id\n    ^ id","id:":"id: anID\n    id := anID","initialize":"initialize\n    super initialize.\n    id := 0. kind := #workspace. title := 'Workspace'. text := ''.\n    x := 100. y := 200. width := 720. height := 600. minimized := false.\n    minimumWidth := 480. minimumHeight := 320.\n    maximumWidth := 8192. maximumHeight := 8192.\n    frameRevision := 1. stateRevision := 1.\n    nativeMinimumWidth := 480. nativeMinimumHeight := 320. nativeMaximumWidth := 8192. nativeMaximumHeight := 8192","kind":"kind\n    ^ kind","kind:":"kind: aKind\n    kind := aKind.\n    minimumWidth := 320. minimumHeight := 160.\n    kind = #workspace ifTrue: [ minimumWidth := 480. minimumHeight := 320 ].\n    (kind = #browser or: [ kind = #changes ]) ifTrue: [ minimumWidth := 750. minimumHeight := 500 ].\n    kind = #transcript ifTrue: [ minimumWidth := 400. minimumHeight := 200 ].\n    frameRevision := frameRevision + 1. self changed: #kind. Desktop constrain: self","maximumHeight":"maximumHeight\n    ^ maximumHeight","maximumWidth":"maximumWidth\n    ^ maximumWidth","maximumWidth:height:":"maximumWidth: newWidth height: newHeight\n    maximumWidth := newWidth clampFrom: minimumWidth to: 8192.\n    maximumHeight := newHeight clampFrom: minimumHeight to: 8192.\n    frameRevision := frameRevision + 1.\n    Desktop constrain: self","minimized":"minimized\n    ^ minimized","minimized:":"minimized: aBoolean\n    minimized := aBoolean.\n    stateRevision := stateRevision + 1.\n    self changed: #minimized","minimumHeight":"minimumHeight\n    ^ minimumHeight","minimumWidth":"minimumWidth\n    ^ minimumWidth","minimumWidth:height:":"minimumWidth: newWidth height: newHeight\n    minimumWidth := newWidth clampFrom: 1 to: 8192.\n    minimumHeight := newHeight clampFrom: 1 to: 8192.\n    maximumWidth := maximumWidth max: minimumWidth.\n    maximumHeight := maximumHeight max: minimumHeight.\n    frameRevision := frameRevision + 1.\n    Desktop constrain: self","moveToX:y:":"moveToX: newX y: newY\n    x := newX. y := newY. frameRevision := frameRevision + 1.\n    Desktop constrain: self","nativeMinimumWidth:height:maximumWidth:height:":"nativeMinimumWidth: minWidth height: minHeight maximumWidth: maxWidth height: maxHeight\n    nativeMinimumWidth := minWidth. nativeMinimumHeight := minHeight.\n    nativeMaximumWidth := maxWidth. nativeMaximumHeight := maxHeight","observeMinimized:":"observeMinimized: aBoolean\n    minimized := aBoolean.\n    self changed: #minimized","observeX:y:width:height:":"observeX: newX y: newY width: newWidth height: newHeight\n    x := newX. y := newY. width := newWidth. height := newHeight.\n    self changed: #frame","open":"open\n    ^ Desktop open: self","placeX:y:width:height:":"placeX: newX y: newY width: newWidth height: newHeight\n    (x = newX and: [ y = newY and: [ width = newWidth and: [ height = newHeight ] ] ]) ifFalse: [\n        frameRevision := frameRevision + 1 ].\n    x := newX. y := newY. width := newWidth. height := newHeight.\n    self changed: #frame","resizeWidth:height:":"resizeWidth: newWidth height: newHeight\n    width := newWidth. height := newHeight. frameRevision := frameRevision + 1.\n    Desktop constrain: self","stateRevision":"stateRevision\n    ^ stateRevision","text":"text\n    ^ text","text:":"text: aString\n    text := aString.\n    self changed: #text","title":"title\n    ^ title","title:":"title: aTitle\n    title := aTitle.\n    self changed: #title","width":"width\n    ^ width","x":"x\n    ^ x","y":"y\n    ^ y"},"TestCase":{"assert:":"assert: condition\n    condition ifFalse: [ self fail: 'Expected true.' ]","assert:equals:":"assert: actual equals: expected\n    (actual = expected) ifFalse: [\n        self fail: 'Expected ' , expected printString , ', got ' , actual printString , '.' ]","deny:":"deny: condition\n    condition ifTrue: [ self fail: 'Expected false.' ]","fail:":"fail: aString\n    ToolVM failTest: aString","setUp":"setUp\n    ^ self","tearDown":"tearDown\n    ^ self"},"TestOutcome":{"diagnostics":"diagnostics\n    ^ diagnostics","initialize":"initialize\n    diagnostics := #()","record:during:":"record: diagnostic during: phase\n    | entry |\n    diagnostic isNil ifTrue: [ ^ self ].\n    entry := Array new: 5.\n    entry at: 1 put: phase;\n        at: 2 put: (diagnostic at: 1);\n        at: 3 put: (diagnostic at: 2);\n        at: 4 put: (diagnostic at: 3);\n        at: 5 put: (diagnostic at: 4).\n    diagnostics := diagnostics copyWith: entry","selector":"selector\n    ^ selector","status":"status\n    diagnostics do: [ :each | (each at: 2) = #error ifTrue: [ ^ #error ] ].\n    ^ diagnostics isEmpty ifTrue: [ #passed ] ifFalse: [ #failure ]","testClass":"testClass\n    ^ testClass","testClass:selector:":"testClass: aClass selector: aSelector\n    testClass := aClass.\n    selector := aSelector"},"TestResult":{"errorCount":"errorCount\n    ^ errors","failureCount":"failureCount\n    ^ failures","initialize":"initialize\n    self outcomes: #()","isSuccess":"isSuccess\n    ^ self testCount > 0 and: [ failures + errors = 0 ]","outcomes":"outcomes\n    ^ outcomes","outcomes:":"outcomes: results\n    outcomes := results.\n    failures := 0.\n    errors := 0.\n    outcomes do: [ :each |\n        | status |\n        status := each status.\n        status = #failure ifTrue: [ failures := failures + 1 ].\n        status = #error ifTrue: [ errors := errors + 1 ] ]","passedCount":"passedCount\n    ^ self testCount - failures - errors","summary":"summary\n    ^ self testCount printString , ' total, ' , self passedCount printString , ' passed, ' ,\n        failures printString , ' failed, ' , errors printString , ' with errors'","testCount":"testCount\n    ^ outcomes size"},"Transcript":{"clear":"clear\n    TranscriptBuffer clear","cr":"cr\n    self show: ToolVM lineBreak","flush":"flush\n    ^ self","nextPut:":"nextPut: character\n    (character isKindOf: Character) ifFalse: [ self error: 'Transcript expects a character.' ].\n    character = Character cr ifTrue: [ ^ self cr ].\n    self show: character asString","nextPutAll:":"nextPutAll: characters\n    | batch |\n    batch := self _nextPutAllBatch: characters.\n    batch isNil ifFalse: [ ^ self show: batch ].\n    characters do: [ :character | self nextPut: character ]","show:":"show: value\n    | text |\n    text := value class == String ifTrue: [ value ] ifFalse: [ value printString ].\n    self record: text.\n    TranscriptBuffer append: text","space":"space\n    self nextPut: Character space","tab":"tab\n    self nextPut: Character tab"},"TranscriptModel":{"append:":"append: aString\n    | addition |\n    addition := aString suffixFittingUTF8: 65536.\n    contents := (contents suffixFittingUTF8: 65536 - addition utf8Size) , addition.\n    self changed: #text","clear":"clear\n    contents := ''.\n    self changed: #text","initialize":"initialize\n    super initialize.\n    contents := ''","text":"text\n    ^ contents"},"TranscriptWindow":{"initialize":"initialize\n    | output scroll menu |\n    super initialize.\n    self kind: #transcript.\n    self title: 'Transcript'.\n    output := UILabel new identifier: 'transcriptOutput'; role: #code; yourself.\n    output bind: #text to: TranscriptBuffer aspect: #text.\n    menu := UIMenu new add: (UIButton new title: 'Clear Transcript'; identifier: 'clearTranscript';\n        command: #clearTranscript; onClickSend: #clear to: TranscriptBuffer; yourself); yourself.\n    scroll := UIScroll new role: #followEnd; padding: 12; contextMenu: menu; add: output; yourself.\n    self content: scroll"},"UIBinding":{"active":"active\n    ^ active","aspect":"aspect\n    ^ aspect","connect":"connect\n    active ifTrue: [ ^ self ].\n    active := true.\n    source addDependent: self.\n    self update: nil","disconnect":"disconnect\n    active ifFalse: [ ^ self ].\n    active := false.\n    source removeDependent: self","initialize":"initialize\n    active := false","property":"property\n    ^ property","reconcileMount:":"reconcileMount: isMounted\n    isMounted ifTrue: [ ^ self connect ].\n    ^ self disconnect","source":"source\n    ^ source","source:aspect:view:property:":"source: aModel aspect: anAspect view: aView property: aProperty\n    source := aModel.\n    aspect := anAspect.\n    view := aView.\n    property := aProperty","update:":"update: anAspect\n    active ifFalse: [ ^ self ].\n    (anAspect isNil or: [ anAspect = aspect ]) ifTrue: [\n        view perform: (property asString, ':') asSymbol with: (source perform: aspect) ]","view":"view\n    ^ view"},"UIBindingTest":{"setUp":"setUp\n    model := BindingTestModel new.\n    model caption: 'Initial'.\n    label := UILabel new.\n    label bind: #text to: model aspect: #caption","tearDown":"tearDown\n    label unbindAll","testBindingReadsAndUpdatesTheLabel":"testBindingReadsAndUpdatesTheLabel\n    self assert: label text equals: 'Initial'.\n    model caption: 'Changed'.\n    self assert: label text equals: 'Changed'","testUnbindingStopsUpdates":"testUnbindingStopsUpdates\n    label unbind: #text.\n    model caption: 'Changed'.\n    self assert: label text equals: 'Initial'.\n    self assert: model dependents isEmpty"},"UIButton":{"action:":"action: aBlock\n    action := aBlock","click":"click\n    enabled ifFalse: [ ^ self ].\n    action notNil ifTrue: [ ^ action value ]","clickWithSelection:":"clickWithSelection: aString\n    enabled ifFalse: [ ^ self ].\n    selectionAction isNil ifTrue: [ ^ self click ].\n    ^ selectionAction value: aString","command:":"command: aSymbol\n    command := aSymbol","icon:":"icon: aString\n    icon := aString","initialize":"initialize\n    super initialize.\n    title := 'Button'.\n    action := nil","onClickSend:to:":"onClickSend: aSelector to: aController\n    self action: [ aController perform: aSelector ]","selectionFrom:action:":"selectionFrom: anEditor action: aBlock\n    selectionSource := anEditor.\n    selectionAction := aBlock","shortcutHint:":"shortcutHint: aString\n    shortcutHint := aString","title":"title\n    ^ title","title:":"title: aString\n    title := aString"},"UICodeEditor":{"contextMenu":"contextMenu\n    ^ contextMenu","contextMenu:":"contextMenu: aMenu\n    contextMenu := aMenu","editingMenu:":"editingMenu: entries\n    editingMenu := entries","initialize":"initialize\n    super initialize.\n    readOnly := false.\n    lineNumbers := false.\n    syntaxHighlighting := false.\n    undoEnabled := true.\n    editingMenu := #((#cut 'Cut') (#copy 'Copy') (#paste 'Paste') (#selectAll 'Select All'))","lineNumbers:":"lineNumbers: aBoolean\n    lineNumbers := aBoolean","readOnly:":"readOnly: aBoolean\n    readOnly := aBoolean","role:":"role: aSymbol\n    super role: aSymbol.\n    lineNumbers := aSymbol = #source.\n    syntaxHighlighting := lineNumbers","syntaxHighlighting:":"syntaxHighlighting: aBoolean\n    syntaxHighlighting := aBoolean","undoEnabled:":"undoEnabled: aBoolean\n    undoEnabled := aBoolean"},"UIContainer":{"add:":"add: anElement\n    | replacement |\n    replacement := Array new: children size + 1.\n    1 to: children size do: [ :index | replacement at: index put: (children at: index) ].\n    replacement at: replacement size put: anElement.\n    children := replacement.\n    ^ anElement","children":"children\n    ^ children","children:":"children: anArray\n    children := anArray","initialize":"initialize\n    super initialize.\n    children := Array new: 0.\n    spacing := 8.\n    padding := 0","padding":"padding\n    ^ padding","padding:":"padding: aNumber\n    padding := aNumber","remove:":"remove: anElement\n    children := children select: [ :each | (each == anElement) not ]","removeAll":"removeAll\n    children := Array new: 0","spacing":"spacing\n    ^ spacing","spacing:":"spacing: aNumber\n    spacing := aNumber"},"UIElement":{"bind:to:aspect:":"bind: aProperty to: aModel aspect: anAspect\n    | binding replacement |\n    self unbind: aProperty.\n    binding := UIBinding new.\n    binding source: aModel aspect: anAspect view: self property: aProperty.\n    replacement := Array new: self bindings size + 1.\n    1 to: mvcBindings size do: [ :index | replacement at: index put: (mvcBindings at: index) ].\n    replacement at: replacement size put: binding.\n    mvcBindings := replacement.\n    binding connect","bindings":"bindings\n    mvcBindings isNil ifTrue: [ mvcBindings := Array new: 0 ].\n    ^ mvcBindings","enabled":"enabled\n    ^ enabled","enabled:":"enabled: aBoolean\n    enabled := aBoolean","heightFrom:to:":"heightFrom: minimum to: maximum\n    minHeight := minimum.\n    maxHeight := maximum","identifier:":"identifier: aString\n    identifier := aString","initialize":"initialize\n    enabled := true.\n    visible := true.\n    mvcBindings := nil","role:":"role: aSymbol\n    role := aSymbol","unbind:":"unbind: aProperty\n    self bindings do: [ :each | each property = aProperty ifTrue: [ each disconnect ] ].\n    mvcBindings := mvcBindings select: [ :each | (each property = aProperty) not ]","unbindAll":"unbindAll\n    self bindings do: [ :each | each disconnect ].\n    mvcBindings := nil","visible":"visible\n    ^ visible","visible:":"visible: aBoolean\n    visible := aBoolean","widthFrom:to:":"widthFrom: minimum to: maximum\n    minWidth := minimum.\n    maxWidth := maximum"},"UIHistoryList":{"command:":"command: aSymbol\n    command := aSymbol","entries:":"entries: rows\n    entries := rows.\n    self items: (rows collect: [ :each | each at: 1 ])","includes:":"includes: key\n    ^ items includes: key","initialize":"initialize\n    super initialize.\n    entries := #()","rowIdentifierPrefix:":"rowIdentifierPrefix: aString\n    rowIdentifierPrefix := aString"},"UILabel":{"initialize":"initialize\n    super initialize.\n    text := ''","text":"text\n    ^ text","text:":"text: aString\n    text := aString"},"UIList":{"initialize":"initialize\n    super initialize.\n    items := #().\n    selection := nil","items:":"items: values\n    items := values","onSelectSend:to:":"onSelectSend: message to: receiver\n    target := receiver.\n    selector := message","select:":"select: value\n    (value isNil or: [ items includes: value ]) ifFalse: [ ^ self ].\n    selection := value.\n    target notNil ifTrue: [ ^ target perform: selector with: value ]","selection:":"selection: value\n    selection := value"},"UIMenu":{"initialize":"initialize\n    super initialize.\n    title := 'Menu'","title:":"title: aString\n    title := aString"},"UIScroll":{"contextMenu:":"contextMenu: aMenu\n    contextMenu := aMenu"},"UISourceView":{"initialize":"initialize\n    super initialize.\n    text := ''.\n    line := 1.\n    column := 1","line:column:":"line: aLine column: aColumn\n    line := aLine.\n    column := aColumn","text:":"text: aString\n    text := aString"},"UITextField":{"editText:":"editText: aString\n    self text: aString.\n    mvcInputTarget notNil ifTrue: [ ^ mvcInputTarget perform: mvcInputSelector with: aString ]","initialize":"initialize\n    super initialize.\n    label := ''.\n    text := ''.\n    placeholder := ''","label":"label\n    ^ label","label:":"label: aString\n    label := aString","onChangeSend:to:":"onChangeSend: aSelector to: aController\n    mvcInputTarget := aController.\n    mvcInputSelector := aSelector","placeholder":"placeholder\n    ^ placeholder","placeholder:":"placeholder: aString\n    placeholder := aString","text":"text\n    ^ text","text:":"text: aString\n    text := aString"},"UIValueTable":{"columnSpacing:padding:":"columnSpacing: spacing padding: padding\n    columnSpacing := spacing.\n    horizontalPadding := padding","command:":"command: aSymbol\n    command := aSymbol","headings:":"headings: labels\n    headings := labels","initialize":"initialize\n    super initialize.\n    rows := #().\n    headings := #('Name' 'Value' 'Class').\n    rowIdentifierPrefix := 'row'.\n    self nameWidth: 96 classWidth: 108;\n        columnSpacing: 12 padding: 12;\n        valueLines: 3","nameWidth:classWidth:":"nameWidth: nameColumn classWidth: classColumn\n    nameWidth := nameColumn.\n    classWidth := classColumn","readOnly:":"readOnly: aBoolean\n    readOnly := aBoolean","rowIdentifierPrefix:":"rowIdentifierPrefix: aString\n    rowIdentifierPrefix := aString","rows:":"rows: entries\n    rows := entries.\n    self items: (entries collect: [ :each | each at: 1 ])","valueLines:":"valueLines: count\n    valueLines := count"},"UIVerticalSplit":{"initialize":"initialize\n    super initialize.\n    self role: #resizableVertical"},"UIWindow":{"content":"content\n    ^ content","content:":"content: anElement\n    content := anElement","initialize":"initialize\n    super initialize.\n    self kind: #custom.\n    title := 'Window'.\n    width := 480.\n    height := 320.\n    content := nil"},"UnorderedCollection":{"_reserve:":"_reserve: capacity\n    elements _reserve: capacity","addAll:":"addAll: additions\n    additions do: [ :each | self add: each ].\n    ^ additions","asArray":"asArray\n    ^ elements asArray","collect:":"collect: operation\n    ^ self class withAll: (elements collect: operation)","copy":"copy\n    ^ self class withAll: self","do:":"do: operation\n    elements do: operation","includes:":"includes: element\n    ^ elements includes: element","initialize":"initialize\n    elements := OrderedCollection new","isEmpty":"isEmpty\n    ^ elements isEmpty","remove:":"remove: element\n    ^ elements remove: element","remove:ifAbsent:":"remove: element ifAbsent: alternative\n    ^ elements remove: element ifAbsent: alternative","removeAll:":"removeAll: removals\n    removals do: [ :each | self remove: each ].\n    ^ removals","select:":"select: predicate\n    ^ self class withAll: (elements select: predicate)","size":"size\n    ^ elements size"},"Warning":{"defaultAction":"defaultAction\n    | text decision |\n    text := self description asString.\n    decision := self _confirmWarning: text title: 'Smalltalk Warning' continue: 'Continue' abort: 'Abort'.\n    decision isNil ifTrue: [\n        Transcript show: 'Warning: '; show: text; cr.\n        ^ nil ].\n    decision ifFalse: [ ^ self _failUnhandledException ].\n    ^ nil"},"WorkspaceWindow":{"actionsMenu":"actionsMenu\n    | menu |\n    menu := UIMenu new title: 'Workspace actions'; identifier: 'workspaceActions'; role: #moreMenu; yourself.\n    menu add: ((self selectionButton: 'Print it' command: #printIt action: #printIt:) identifier: 'workspaceAction-printIt'; yourself).\n    menu add: ((self selectionButton: 'Inspect it' command: #inspectIt action: #inspect:) identifier: 'workspaceAction-inspectIt'; yourself).\n    menu add: ((self selectionButton: 'Debug it' command: #debugIt action: #debugIt:) identifier: 'workspaceAction-debugIt'; yourself).\n    ^ menu","applicationCommands":"applicationCommands\n    ^ self evaluationMenu role: #applicationCommands; yourself","debugIt:":"debugIt: selected\n    ToolVM requestDebugSource: (self sourceForSelection: selected) for: self","doIt:":"doIt: selected\n    ^ self execute: selected printing: false","editorMenu":"editorMenu\n    ^ self evaluationMenu","evaluationMenu":"evaluationMenu\n    | menu |\n    menu := UIMenu new title: 'Workspace'; yourself.\n    menu add: (self selectionButton: 'Do it' command: #doIt action: #doIt:).\n    menu add: (self selectionButton: 'Print it' command: #printIt action: #printIt:).\n    menu add: (self selectionButton: 'Inspect it' command: #inspectIt action: #inspect:).\n    menu add: (self selectionButton: 'Debug it' command: #debugIt action: #debugIt:).\n    ^ menu","exampleButton:key:":"exampleButton: aTitle key: exampleKey\n    ^ UIButton new title: aTitle; action: [\n        | source workspace |\n        source := WorkspaceExamples sourceAt: exampleKey.\n        workspace := Desktop openWorkspace.\n        workspace notNil ifTrue: [ workspace text: source ] ]; yourself","examplesMenu":"examplesMenu\n    | menu |\n    menu := UIMenu new title: 'Examples'; role: #applicationMenu; yourself.\n    WorkspaceExamples menuEntries do: [ :entry |\n        menu add: (self exampleButton: (entry at: 2) key: (entry at: 1)) ].\n    ^ menu","execute:printing:":"execute: selected printing: aBoolean\n    | outcome |\n    outcome := ToolVM evaluateSource: (self sourceForSelection: selected).\n    self result: outcome.\n    (aBoolean and: [ outcome at: 1 ]) ifTrue: [ Transcript show: '→ ' , (outcome at: 2); cr ].\n    ^ outcome at: 2","initialize":"initialize\n    | root bar doIt commands |\n    super initialize.\n    self kind: #workspace.\n    self title: 'Workspace'.\n    self resizeWidth: 720 height: 600.\n    editor := UICodeEditor new identifier: 'workspaceEditor'; label: 'Smalltalk Workspace'; role: #source; yourself.\n    editor onChangeSend: #text: to: self.\n    editor contextMenu: self editorMenu.\n    doIt := (self selectionButton: 'Do it' command: #doIt action: #doIt:)\n        identifier: 'executeButton'; role: #primary; shortcutHint: '⌘D'; yourself.\n    bar := UIRow new role: #windowToolbar; spacing: 5; add: doIt; add: self actionsMenu; yourself.\n    root := UIColumn new spacing: 0; add: bar; add: self examplesMenu; add: editor; add: self resultPane; yourself.\n    commands := self applicationCommands.\n    commands notNil ifTrue: [ root add: commands ].\n    self content: root","inspect:":"inspect: selected\n    | outcome |\n    outcome := ToolVM inspectSource: (self sourceForSelection: selected).\n    self result: outcome.\n    ^ outcome at: 2","printIt:":"printIt: selected\n    ^ self execute: selected printing: true","selectionButton:command:action:":"selectionButton: aTitle command: aCommand action: aSelector\n    ^ UIButton new\n        title: aTitle;\n        command: aCommand;\n        selectionFrom: editor action: [ :selected | self perform: aSelector with: selected ];\n        yourself","sourceForSelection:":"sourceForSelection: selected\n    ^ selected size = 0 ifTrue: [ self text ] ifFalse: [ selected ]","text:":"text: aString\n    super text: aString.\n    editor notNil ifTrue: [ editor text: aString ]"},"WriteFileStream":{"cr":"cr\n    self nextPut: Character lf","flush":"flush\n    self _flushFile","nextPut:":"nextPut: element\n    self _writeFileElements: (Array with: element).\n    ^ element","nextPutAll:":"nextPutAll: elements\n    | batch |\n    batch := self _nextPutAllBatch: elements.\n    batch isNil\n        ifTrue: [ elements do: [ :each | self nextPut: each ] ]\n        ifFalse: [ self _writeFileElements: batch ]","space":"space\n    self nextPut: Character space","tab":"tab\n    self nextPut: Character tab"},"WriteStream":{"cr":"cr\n    self nextPut: Character lf","flush":"flush\n    self _sequence","nextPut:":"nextPut: element\n    self _write: (Array with: element).\n    ^ element","nextPutAll:":"nextPutAll: elements\n    | batch |\n    batch := self _nextPutAllBatch: elements.\n    batch isNil\n        ifTrue: [ elements do: [ :each | self nextPut: each ] ]\n        ifFalse: [ self _write: batch ]","space":"space\n    self nextPut: Character space","tab":"tab\n    self nextPut: Character tab"},"ZeroDivide":{"description":"description\n    ^ 'Division by zero.'","dividend":"dividend\n    ^ dividend","dividend:":"dividend: aNumber\n    dividend := aNumber","isResumable":"isResumable\n    ^ true"}},"version":1}